# Cargo.lock merge driver: regenerates the lockfile from the (already
# merged) Cargo.toml tree on conflict. See scripts/cargo-lock-merge.sh
# for the driver contract.
#
# Driver registration is per-clone in .git/config and is not committed.
# Authors should run `scripts/setup-git-merge-drivers.sh` once after
# cloning to register the driver locally.
Cargo.lock merge=cargo-lock-regen

# Release audit reports are binary publication artifacts.
releases/audit-reports/*.pdf binary

# Preserve the original, hash-pinned vendor license bytes.
spec/ietf/tools/fonts/*-OFL.txt -whitespace

# Mobile xcframework static archives are generated release artifacts.
sdks/swift/Frameworks/ChioKernel.xcframework/**/*.a filter=lfs diff=lfs merge=lfs -text

# Vendored corresponding source keeps its exact bytes on every checkout.
deploy/docker/security-evidence-apk-sources/** -text
# Upstream and Alpine files there are copied byte for byte, so repository
# whitespace rules do not apply to them; derived files there keep them.
deploy/docker/security-evidence-apk-sources/aports-objects/** -whitespace
deploy/docker/security-evidence-apk-sources/build-tools/** -whitespace
deploy/docker/security-evidence-apk-sources/licenses/** -whitespace
deploy/docker/security-evidence-apk-sources/recipes/** -whitespace
deploy/docker/security-evidence-apk-sources/sources/** -whitespace

# The binary closure and compressed corresponding sources travel through Git LFS.
deploy/docker/security-evidence-apks/*.apk filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.tar.gz.noauto filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.tar.xz filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.tgz filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.patch.xz filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/sources/**/*.part-* filter=lfs diff=lfs merge=lfs -text
deploy/docker/security-evidence-apk-sources/build-tools/abuild/sources/*.tar.gz filter=lfs diff=lfs merge=lfs -text
