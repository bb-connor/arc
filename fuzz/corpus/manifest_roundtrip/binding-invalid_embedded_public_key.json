{
  "description": "Manifest vector for bindings-core SDK fixtures",
  "name": "Bindings Demo",
  "public_key": "not-a-public-key",
  "required_permissions": {
    "environment_variables": [
      "CHIO_ENV"
    ],
    "native_syscall_profile": "native_standard_v1",
    "network_destinations": [
      {
        "host": "api.example.com",
        "port": 443
      }
    ],
    "read_paths": [
      "/workspace"
    ],
    "write_paths": [
      "/workspace/output"
    ]
  },
  "schema": "chio.manifest.v1",
  "server_id": "srv-bindings-demo",
  "tools": [
    {
      "annotations": {
        "destructive": false,
        "idempotent": false,
        "read_only": true,
        "requires_approval": false
      },
      "description": "Tool definition for file_read",
      "flow": {
        "egress": true,
        "input_clearance": {
          "compartments": [],
          "kind": "known",
          "owners": {}
        },
        "output_label": {
          "compartments": [],
          "kind": "known",
          "owners": {}
        }
      },
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "latency_hint": "fast",
      "name": "file_read",
      "output_schema": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructive": true,
        "idempotent": false,
        "read_only": false,
        "requires_approval": true
      },
      "description": "Tool definition for file_write",
      "flow": {
        "egress": true,
        "input_clearance": {
          "compartments": [],
          "kind": "known",
          "owners": {}
        },
        "output_label": {
          "compartments": [],
          "kind": "known",
          "owners": {}
        }
      },
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "latency_hint": "moderate",
      "name": "file_write",
      "output_schema": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  ],
  "version": "1.0.0"
}
