      "output_schema": {
        "properties": {
          "greeting": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "pricing": {
        "billing_unit": "invocation",
        "pricing_model": "per_invocation",
        "unit_price": {
          "currency": "USD",
          "units": 25
        }
      }
    }
  ],
  "version": "0.1.0"
