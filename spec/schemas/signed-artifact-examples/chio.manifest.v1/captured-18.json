{
  "description": "A tiny native Chio service that exposes a tool, resource, prompt, and priced manifest",
  "name": "Hello Tool Server",
  "public_key": "e737ae4d17d72ffb43b03cd835b79f7c634db04c256d01d716a1a1fcbd9dd259",
  "schema": "chio.manifest.v1",
  "server_id": "srv-hello",
