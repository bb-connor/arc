{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-process/v1/response.schema.json",
  "title": "Chio Process Worker Response Frame",
  "description": "One chio.process.v1 response: UTF-8 JSON followed by a single newline, at most 8388608 bytes including that newline. The success result has the shape of the requested operation's result in $defs; the frame does not repeat the operation name. Normative text: spec/PROTOCOL.md section 8.6.",
  "oneOf": [
    { "$ref": "#/$defs/Success" },
    { "$ref": "#/$defs/Failure" }
  ],
  "$defs": {
    "Success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "ok", "result"],
      "properties": {
        "protocol": { "const": "chio.process.v1" },
        "ok": { "const": true },
        "result": { "type": "object" }
      }
    },
    "Failure": {
      "description": "A protocol, transport or runtime failure. It carries no message text, path or credential. Kernel denials are successes, not failures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "ok", "error"],
      "properties": {
        "protocol": { "const": "chio.process.v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": { "code": { "$ref": "#/$defs/ErrorCode" } }
        }
      }
    },
    "ErrorCode": {
      "description": "Codes a v1 host emits. Clients surface any other string code unchanged rather than mapping it.",
      "enum": [
        "unauthenticated",
        "invalid_request",
        "cancelled",
        "conflict",
        "checkpoint_conflict",
        "limit_reached",
        "runtime_error",
        "blob_missing",
        "blob_corrupt",
        "response_too_large",
        "invalid_frame",
        "frame_timeout"
      ]
    },
    "InspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id",
        "parent_id",
        "root_id",
        "state",
        "depth",
        "limits",
        "tree_calls",
        "checkpoint"
      ],
      "properties": {
        "process_id": { "type": "string", "minLength": 1 },
        "parent_id": { "type": ["string", "null"] },
        "root_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["running", "cancelled"] },
        "depth": { "$ref": "#/$defs/U32" },
        "limits": { "$ref": "#/$defs/ProcessLimits" },
        "tree_calls": { "$ref": "#/$defs/U32" },
        "storage": {
          "description": "Present when the host supports chio.process.blobs.v1. Earlier hosts omit it.",
          "$ref": "#/$defs/ProcessStorage"
        },
        "checkpoint": { "$ref": "#/$defs/CheckpointResult" }
      }
    },
    "ProcessLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_processes", "max_depth", "max_calls"],
      "properties": {
        "max_processes": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 64 },
        "max_calls": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "state": {
          "description": "Omitted when equal to the defaults of 67108864 bytes and 4096 blobs.",
          "$ref": "#/$defs/StateLimits"
        }
      }
    },
    "StateLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "max_blobs"],
      "properties": {
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_blobs": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "ProcessStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "max_blob_bytes",
        "limits",
        "process_bytes",
        "process_blobs",
        "tree_bytes",
        "tree_blobs"
      ],
      "properties": {
        "protocol": { "const": "chio.process.blobs.v1" },
        "max_blob_bytes": { "const": 1048576 },
        "limits": { "$ref": "#/$defs/StateLimits" },
        "process_bytes": { "$ref": "#/$defs/U64" },
        "process_blobs": { "$ref": "#/$defs/U64" },
        "tree_bytes": { "$ref": "#/$defs/U64" },
        "tree_blobs": { "$ref": "#/$defs/U64" }
      }
    },
    "InvokeResult": {
      "description": "A kernel verdict with its original signed receipt. When the complete response would exceed the frame limit, output is null and output_withheld is too_large; a retry replays the same outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "verdict",
        "output",
        "reason",
        "terminal_state",
        "receipt_json",
        "execution_nonce_json"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["allow", "deny", "pending_approval"] },
        "output": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": { "kind": { "const": "value" }, "value": true }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "chunks"],
              "properties": { "kind": { "const": "stream" }, "chunks": { "type": "array" } }
            }
          ]
        },
        "output_withheld": { "const": "too_large" },
        "reason": { "type": ["string", "null"] },
        "terminal_state": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": { "state": { "const": "completed" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason"],
              "properties": {
                "state": { "enum": ["cancelled", "incomplete"] },
                "reason": { "type": "string" }
              }
            }
          ]
        },
        "receipt_json": {
          "description": "The signed receipt as canonical JSON text. Preserve these exact bytes for a Chio verifier; reparsing can alter large integers.",
          "type": "string",
          "minLength": 1
        },
        "execution_nonce_json": {
          "description": "The signed execution nonce as JSON text, present only on an allow verdict from a kernel that issues nonces.",
          "type": ["string", "null"]
        }
      },
      "dependentSchemas": {
        "output_withheld": { "properties": { "output": { "type": "null" } } }
      }
    },
    "CheckpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "value"],
      "properties": {
        "revision": {
          "description": "Canonical decimal string of an unsigned 64-bit revision.",
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]*)$"
        },
        "value": true
      }
    },
    "BlobPutResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "BlobReadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "data_base64"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "data_base64": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "CancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancelled_processes"],
      "properties": { "cancelled_processes": { "$ref": "#/$defs/U64" } }
    },
    "PrepareInvocationResult": {
      "description": "The host-prepared envelope. Its shape belongs to the host's preparation service; the worker passes it back unchanged as invoke arguments.",
      "type": "object"
    },
    "U32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "U64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
  }
}
