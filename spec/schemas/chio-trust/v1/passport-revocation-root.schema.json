{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-trust/v1/passport-revocation-root.schema.json",
  "title": "Chio Passport Revocation Root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "signedRoot"],
  "properties": {
    "schema": { "const": "chio.trust.passport-revocation-root.v1" },
    "signedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "signature"],
      "properties": {
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "root_hash", "leaf_count", "issued_at_unix_ms"],
          "properties": {
            "epoch": { "$ref": "#/$defs/jsonSafeCount" },
            "root_hash": { "$ref": "#/$defs/bytes32" },
            "leaf_count": { "$ref": "#/$defs/jsonSafeCount" },
            "issued_at_unix_ms": { "$ref": "#/$defs/jsonSafeCount" }
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signer_id", "signature_bytes"],
          "properties": {
            "signer_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signature_bytes": {
              "type": "array",
              "items": { "$ref": "#/$defs/byte" },
              "minItems": 64,
              "maxItems": 64
            }
          }
        }
      }
    }
  },
  "$defs": {
    "jsonSafeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "bytes32": {
      "type": "array",
      "items": { "$ref": "#/$defs/byte" },
      "minItems": 32,
      "maxItems": 32
    }
  }
}
