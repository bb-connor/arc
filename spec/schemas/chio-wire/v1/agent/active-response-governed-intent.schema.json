{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/agent/active-response-governed-intent.schema.json",
  "title": "Chio Governed Active Response Intent Body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_schema",
    "plan_id",
    "operator_capability_id",
    "operator_capability_hash",
    "operator_capability_expires_at",
    "executor_subject",
    "canonical_plan_body",
    "plan_body_hash",
    "target_binding",
    "ordered_effects",
    "expires_at",
    "rollback_binding"
  ],
  "properties": {
    "plan_schema": { "const": "chio.response-plan.v1" },
    "plan_id": {
      "description": "At most 256 UTF-8 bytes, without control characters or surrounding whitespace.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$"
    },
    "operator_capability_id": {
      "description": "At most 256 UTF-8 bytes, without control characters or surrounding whitespace.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$"
    },
    "operator_capability_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operator_capability_expires_at": { "type": "integer", "minimum": 1 },
    "executor_subject": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "canonical_plan_body": {
      "description": "Plan body hashed into plan_body_hash. Its RFC 8785 canonical form is at most 65536 bytes, nests at most 32 levels below the root and holds at most 4096 JSON values.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "not": { "enum": ["planHash", "plan_hash"] } }
    },
    "plan_body_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_binding": {
      "description": "Its RFC 8785 canonical form is at most 16384 bytes, nests at most 32 levels below the root and holds at most 4096 JSON values.",
      "type": "object",
      "minProperties": 1
    },
    "ordered_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "throttle_session",
          "restrict_egress",
          "suspend_session",
          "suspend_capability_set",
          "freeze_issuance"
        ]
      }
    },
    "expires_at": {
      "description": "Must not exceed operator_capability_expires_at.",
      "type": "integer",
      "minimum": 1
    },
    "rollback_binding": {
      "description": "Its RFC 8785 canonical form is at most 16384 bytes, nests at most 32 levels below the root and holds at most 4096 JSON values.",
      "type": "object",
      "minProperties": 1
    }
  }
}
