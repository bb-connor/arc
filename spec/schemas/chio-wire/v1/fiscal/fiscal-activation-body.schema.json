                "type": "object",
                "additionalProperties": false,
                "required": [
                  "charterDigest",
                  "charterId",
                  "domain",
                  "issuedAt",
                  "issuedBy",
                  "params",
                  "scheduleId",
                  "schema",
                  "sequence",
