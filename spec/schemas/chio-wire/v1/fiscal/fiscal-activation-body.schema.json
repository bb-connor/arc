                  "charterDigest": {
                    "type": "string"
                  },
                  "charterId": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "issuedAt": {
                    "type": "integer"
                  },
                  "issuedBy": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
