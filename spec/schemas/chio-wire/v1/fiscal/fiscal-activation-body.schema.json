            "properties": {
              "admissionDigest": {
                "type": "string"
              },
              "admissionId": {
                "type": "string"
              },
              "approvalExpiresAt": {
                "type": "integer"
              },
              "approvalId": {
                "type": "string"
              },
              "approvedAt": {
                "type": "integer"
              },
              "proposalDigest": {
                "type": "string"
              },
              "proposalId": {
                "type": "string"
              },
              "schema": {
                "type": "string"
              },
              "signerKeyId": {
                "type": "string"
              }
            }
          },
          "signature": {
            "type": "string"
          },
          "signerKey": {
            "type": "string"
          }
        }
      }
    },
    "charterDigest": {
      "type": "string"
    },
    "charterId": {
      "type": "string"
    },
    "issuedBy": {
      "type": "string"
    },
    "proposalDigest": {
      "type": "string"
    },
    "proposalId": {
      "type": "string"
    },
    "schema": {
      "const": "chio.fiscal.activation.v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "predecessorCharterDigest": {
          "type": "string"
        },
        "scheduleId": {
          "type": "string"
        },
        "successorCharterDigest": {
          "type": "string"
        },
