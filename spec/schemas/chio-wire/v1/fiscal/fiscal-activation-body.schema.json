{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/fiscal/fiscal-activation-body.schema.json",
  "title": "chio.fiscal.activation.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activatedAt",
    "activationId",
    "activationNotBefore",
    "admissionDigest",
    "admissionId",
    "approvalSetDigest",
    "approvals",
    "charterDigest",
    "charterId",
    "issuedBy",
    "proposalDigest",
    "proposalId",
    "schema",
    "target"
  ],
  "properties": {
    "activatedAt": {
      "type": "integer"
    },
    "activationId": {
      "type": "string"
    },
    "activationNotBefore": {
      "type": "integer"
    },
    "admissionDigest": {
      "type": "string"
    },
    "admissionId": {
      "type": "string"
    },
    "approvalSetDigest": {
      "type": "string"
    },
