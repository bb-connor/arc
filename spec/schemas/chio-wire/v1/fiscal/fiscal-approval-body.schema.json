{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/fiscal/fiscal-approval-body.schema.json",
  "title": "chio.fiscal.approval.v1 signed body",
  "type": "object",
  "additionalProperties": false,
