{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/finding/hosted-principal-replication-event.schema.json",
  "title": "Chio finding hosted principal replication event signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorityEpoch",
    "committedAt",
    "lifecycleEvent",
    "schema",
    "sequence",
    "sourceAuthority",
    "tenantId"
  ],
  "properties": {
    "authorityEpoch": {
      "type": "integer"
    },
    "committedAt": {
      "type": "integer"
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "signature",
        "signerKey"
      ],
      "properties": {
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilityPublicKeyHex",
            "createdAt",
            "operation",
            "overlapExpiresAt",
            "previousEventSha256",
            "principalId",
            "role",
            "schema",
            "tenantId"
          ],
          "properties": {
            "capabilityPublicKeyHex": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer"
            },
            "operation": {
              "type": "string"
            },
            "overlapExpiresAt": {
              "type": [
                "integer",
                "null"
              ]
            },
            "previousEventSha256": {
              "type": [
                "null",
                "string"
              ]
            },
            "principalId": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            }
          }
        },
        "signature": {
          "type": "string"
        },
        "signerKey": {
          "type": "string"
        }
      }
    },
    "schema": {
      "const": "chio.finding.hosted-principal-replication-event.v1"
    },
    "sequence": {
      "type": "integer"
    },
    "sourceAuthority": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    }
  }
}
