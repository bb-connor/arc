{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/finding/finding-body.schema.json",
  "title": "chio.finding.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bond_ref",
    "descriptor",
    "evidence_checkpoint_ref",
    "evidence_class",
    "evidence_cost",
    "evidence_receipt_ids",
    "expires_at",
    "finding_id",
    "guarantee_class",
    "issued_at",
    "issuer",
    "payload_media_type",
    "payload_sha256",
    "schema",
    "signature",
    "status_feed_ref"
  ],
  "properties": {
    "bond_ref": {
      "type": "string"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_sha256",
        "outcome_class",
        "topic"
      ],
      "properties": {
        "context_sha256": {
          "type": "string"
        },
        "outcome_class": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        }
      }
    },
    "evidence_checkpoint_ref": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string"
    },
    "evidence_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "units"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "units": {
          "type": "integer"
        }
      }
    },
    "evidence_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "integer"
    },
    "finding_id": {
      "type": "string"
    },
    "guarantee_class": {
      "type": "string"
    },
    "issued_at": {
      "type": "integer"
    },
    "issuer": {
      "type": "string"
    },
    "payload_media_type": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "string"
    },
    "price_hint_ref": {
      "type": "string"
    },
    "replay_recipe_sha256": {
      "type": "string"
    },
    "runtime_assurance_tier": {
      "type": "string"
    },
    "schema": {
      "const": "chio.finding.v1"
    },
    "signature": {
      "type": "string"
    },
    "status_feed_ref": {
      "type": "string"
    }
  }
}
