{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/mcp/session-credential.schema.json",
  "title": "Chio mcp session credential signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedTools",
    "authModeFingerprint",
    "capabilityIds",
    "endpointPath",
    "expiresAt",
    "issuedAt",
    "policyFingerprint",
    "schema",
    "serverId",
    "sessionId",
    "subjectKey",
    "tokenHash"
  ],
  "properties": {
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authModeFingerprint": {
      "type": "string"
    },
    "capabilityIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpointPath": {
      "type": "string"
    },
    "expiresAt": {
      "type": "integer"
    },
    "issuedAt": {
      "type": "integer"
    },
    "policyFingerprint": {
      "type": "string"
    },
    "schema": {
      "const": "chio.mcp.session-credential.v1"
    },
    "serverId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "subjectKey": {
      "type": "string"
    },
    "tokenHash": {
      "type": "string"
    }
  }
}
