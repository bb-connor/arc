          },
          "path": {
            "type": "string"
          },
          "retentionClass": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "bundleId": {
      "type": "string"
    },
    "exportedAtUnixMs": {
      "type": "integer"
    },
    "exporterId": {
      "type": "string"
    },
    "exporterKeyId": {
      "type": "string"
    },
    "localKernelId": {
      "type": "string"
    },
    "safetyClaims": {
      "type": "array",
      "items": {
        "type": "string"
