      "type": "integer"
    },
    "packageId": {
      "type": "string"
    },
    "packagerId": {
      "type": "string"
    },
    "packagerKeyId": {
      "type": "string"
    },
    "safetyClaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
