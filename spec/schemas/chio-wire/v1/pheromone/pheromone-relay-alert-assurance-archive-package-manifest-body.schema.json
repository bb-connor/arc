          "bundleId": {
            "type": "string"
          },
          "bundlePath": {
            "type": "string"
          },
          "exportManifestSha256": {
            "type": "string"
          },
          "exportReportSha256": {
            "type": "string"
          },
          "sourcePackageSha256": {
            "type": "string"
          }
        }
      }
    },
    "compressionFormat": {
      "type": "string"
    },
    "createdAtUnixMs": {
      "type": "integer"
    },
    "localKernelId": {
      "type": "string"
    },
    "memberCount": {
      "type": "integer"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactRole",
          "bundleId",
          "byteCount",
          "kind",
          "path",
          "retentionClass",
          "schema",
          "sha256"
        ],
        "properties": {
          "artifactRole": {
            "type": "string"
          },
          "bundleId": {
            "type": "string"
          },
          "byteCount": {
            "type": "integer"
