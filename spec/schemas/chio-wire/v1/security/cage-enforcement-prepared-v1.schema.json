{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/cage-enforcement-prepared-v1.schema.json",
  "title": "Chio cage enforcement-prepared evidence v1",
  "description": "Evidence emitted after resource limits, full Landlock, and default-deny seccomp are prepared but before the target exec transition is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "process_id",
    "manifest_digest",
    "profile_digest",
    "plan_digest",
    "fd_table_digest",
    "helper_binding_digest",
    "target_binding_digest",
    "target_identity",
    "applied_execution_identity",
    "nono_version",
    "nono_patch_version",
    "landlock_abi",
    "landlock_filesystem_status",
    "landlock_network_status",
    "seccompiler_version",
    "seccomp_status",
    "seccomp_architecture",
    "seccomp_filter_digest",
    "trace_session_digest",
    "prepared_at_unix_ms"
  ],
  "properties": {
    "schema": { "const": "chio.cage.enforcement-prepared.v1" },
    "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "manifest_digest": { "$ref": "#/$defs/digest" },
    "profile_digest": { "$ref": "#/$defs/digest" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "fd_table_digest": { "$ref": "#/$defs/digest" },
    "helper_binding_digest": { "$ref": "#/$defs/digest" },
    "target_binding_digest": { "$ref": "#/$defs/digest" },
    "target_identity": { "$ref": "#/$defs/regularFileIdentity" },
    "applied_execution_identity": {
      "$ref": "cage-init-plan-v2.schema.json#/$defs/executionIdentity"
    },
    "nono_version": { "const": "0.53.0" },
    "nono_patch_version": { "const": "chio.2" },
    "landlock_abi": { "type": "integer", "minimum": 4, "maximum": 4294967295 },
    "landlock_filesystem_status": { "const": "fully_enforced" },
    "landlock_network_status": { "const": "fully_enforced" },
    "seccompiler_version": { "const": "0.5.0" },
    "seccomp_status": { "const": "fully_enforced" },
    "seccomp_architecture": { "const": "x86_64" },
    "seccomp_filter_digest": { "$ref": "#/$defs/digest" },
    "trace_session_digest": { "$ref": "#/$defs/digest" },
    "prepared_at_unix_ms": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "mount_id", "mode", "uid", "gid", "kind"],
      "properties": {
        "device": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "inode": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "mount_id": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "kind": { "enum": ["regular_file", "directory", "unix_socket"] }
      }
    },
    "regularFileIdentity": {
      "allOf": [
        { "$ref": "#/$defs/fileIdentity" },
        {
          "type": "object",
          "properties": { "kind": { "const": "regular_file" } },
          "required": ["kind"]
        }
      ]
    }
  }
}
