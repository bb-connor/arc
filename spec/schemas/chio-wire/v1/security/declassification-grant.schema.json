{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/declassification-grant.schema.json",
  "title": "Signed declassification grant",
  "description": "One-shot, destination-bound authorization to lower the information label of one exact tool invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "authority_key",
    "algorithm",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_version",
        "grant_id",
        "capability_id",
        "tenant_id",
        "subject_id",
        "agent_id",
        "session_id",
        "source_label_hash",
        "target_label",
        "destination_id",
        "tool_name",
        "purpose",
        "request_hash",
        "issued_at_unix_seconds",
        "expires_at_unix_seconds",
        "authority_key_id"
      ],
      "properties": {
        "domain_version": {
          "const": 1
        },
        "grant_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "capability_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "tenant_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "subject_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "agent_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "session_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "source_label_hash": {
          "$ref": "#/$defs/digest32"
        },
        "target_label": {
          "allOf": [
            {
              "$ref": "information-label.schema.json"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "known"
                }
              }
            }
          ]
        },
        "destination_id": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "tool_name": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "purpose": {
          "$ref": "#/$defs/flowIdentifier"
        },
        "request_hash": {
          "$ref": "#/$defs/digest32"
        },
        "issued_at_unix_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_unix_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "authority_key_id": {
          "$ref": "#/$defs/flowIdentifier"
        }
      }
    },
    "authority_key": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "ed25519",
        "p256",
        "p384",
        "hybrid"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
    }
  },
  "$defs": {
    "flowIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "digest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
