{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/key-log-artifact-time-anchor-envelope-v1.schema.json",
  "title": "Chio signed key-log artifact time anchor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "anchor_key_id", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "key-log-artifact-time-anchor-body-v1.schema.json" },
    "anchor_key_id": { "$ref": "#/$defs/hash" },
    "algorithm": { "$ref": "#/$defs/algorithm" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
