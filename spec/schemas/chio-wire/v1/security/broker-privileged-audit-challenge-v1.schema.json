{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-privileged-audit-challenge-v1.schema.json",
  "title": "Chio signed broker privileged audit challenge v1",
  "description": "Broker-signed challenge binding one privileged audit session to an exact runner authorization body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signer", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "#/$defs/challengeBody" },
    "signer": { "$ref": "#/$defs/publicKey" },
    "algorithm": { "$ref": "#/$defs/algorithm" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "challengeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessionNonce",
        "sessionCommitmentSha256",
        "runnerAuthorizationBody",
        "issuedAtUnixSeconds",
        "expiresAtUnixSeconds"
      ],
      "properties": {
        "schema": { "const": "chio.broker-privileged-audit-challenge.v1" },
        "sessionNonce": { "$ref": "#/$defs/digest" },
        "sessionCommitmentSha256": { "$ref": "#/$defs/digest" },
        "runnerAuthorizationBody": {
          "$ref": "broker-audit-runner-authorization-body-v1.schema.json"
        },
        "issuedAtUnixSeconds": { "$ref": "#/$defs/positiveU64" },
        "expiresAtUnixSeconds": { "$ref": "#/$defs/positiveU64" }
      }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "publicKey": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": {
      "type": "string",
      "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
    }
  }
}
