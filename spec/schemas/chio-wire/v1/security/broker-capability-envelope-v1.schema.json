{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-capability-envelope-v1.schema.json",
  "title": "Chio signed broker capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "broker-capability-body-v1.schema.json" },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
