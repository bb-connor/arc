{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-privileged-audit-evidence-v1.schema.json",
  "title": "Chio broker privileged audit evidence bundle v1",
  "description": "Canonical evidence returned after one privileged broker audit comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "challenge",
    "runnerAuthorization",
    "governedAdminAuthorization",
    "livenessAuthorityExchange",
    "revocationAuthorityExchange",
    "comparison"
  ],
  "properties": {
    "schema": { "const": "chio.broker-privileged-audit-evidence.v1" },
    "challenge": { "$ref": "broker-privileged-audit-challenge-v1.schema.json" },
    "runnerAuthorization": {
      "$ref": "broker-audit-runner-authorization-envelope-v1.schema.json"
    },
    "governedAdminAuthorization": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "livenessAuthorityExchange": { "$ref": "#/$defs/authorityExchange" },
    "revocationAuthorityExchange": { "$ref": "#/$defs/authorityExchange" },
    "comparison": { "$ref": "broker-audit-comparison-envelope-v1.schema.json" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "publicKey": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "authorityExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response",
        "trustedAuthority",
        "verifiedAtUnixSeconds",
        "maximumClockSkewSeconds",
        "requestSha256",
        "responseSha256"
      ],
      "properties": {
        "request": { "$ref": "broker-authority-request-envelope-v1.schema.json" },
        "response": { "$ref": "broker-authority-response-envelope-v1.schema.json" },
        "trustedAuthority": { "$ref": "#/$defs/publicKey" },
        "verifiedAtUnixSeconds": { "$ref": "#/$defs/positiveU64" },
        "maximumClockSkewSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "requestSha256": { "$ref": "#/$defs/digest" },
        "responseSha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
