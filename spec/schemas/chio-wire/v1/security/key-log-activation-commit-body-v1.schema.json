{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/key-log-activation-commit-body-v1.schema.json",
  "title": "Chio key-log activation commit body v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "log_id", "event_id", "checkpoint_hash", "checkpoint_body_hash", "checkpoint_sequence", "tree_size", "root_hash", "event_leaf_hash", "witness_set_hash", "witness_signatures", "committed_at", "signing_epoch"],
  "properties": {
    "schema": { "const": "chio.key-log.activation-commit.v1" },
    "log_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "event_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "checkpoint_hash": { "$ref": "#/$defs/hash" },
    "checkpoint_body_hash": { "$ref": "#/$defs/hash" },
    "checkpoint_sequence": { "type": "integer", "minimum": 0 },
    "tree_size": { "type": "integer", "minimum": 1 },
    "root_hash": { "$ref": "#/$defs/hash" },
    "event_leaf_hash": { "$ref": "#/$defs/hash" },
    "witness_set_hash": { "$ref": "#/$defs/hash" },
    "witness_signatures": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "key-log-witness-signature-v1.schema.json" } },
    "committed_at": { "type": "integer", "minimum": 0 },
    "signing_epoch": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "keyLogIdentifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
