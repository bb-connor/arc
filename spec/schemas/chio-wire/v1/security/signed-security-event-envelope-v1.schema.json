{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/signed-security-event-envelope-v1.schema.json",
  "title": "Chio signed security event provenance envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "producer_key", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "security-event-body-v1.schema.json" },
    "producer_key": { "$ref": "#/$defs/publicKey" },
    "algorithm": { "$ref": "#/$defs/algorithm" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
