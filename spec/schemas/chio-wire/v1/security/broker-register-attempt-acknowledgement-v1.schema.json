{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-register-attempt-acknowledgement-v1.schema.json",
  "title": "Chio broker register-attempt acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operationId", "attemptId", "disposition", "registeredAtUnixSeconds"],
  "properties": {
    "schema": { "const": "chio.broker-register-attempt-acknowledgement.v1" },
    "operationId": { "$ref": "#/$defs/identifier" },
    "attemptId": { "$ref": "#/$defs/identifier" },
    "disposition": { "enum": ["inserted", "exact_retry"] },
    "registeredAtUnixSeconds": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
