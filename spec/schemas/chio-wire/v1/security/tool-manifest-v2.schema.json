{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/tool-manifest-v2.schema.json",
  "title": "Chio Tool Manifest v2",
  "description": "Strict signed platform manifest body combining normative tool flow metadata and typed native cage permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "server_id", "name", "version", "tools", "public_key"],
  "properties": {
    "schema": { "const": "chio.manifest.v2" },
    "server_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/toolDefinition" }
    },
    "server_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["computer_use", "bash", "text_editor"] }
    },
    "required_permissions": { "$ref": "#/$defs/requiredPermissions" },
    "public_key": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "annotations"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "pricing": { "$ref": "#/$defs/toolPricing" },
        "annotations": { "$ref": "#/$defs/toolAnnotations" },
        "latency_hint": { "enum": ["instant", "fast", "moderate", "slow"] },
        "flow": { "$ref": "tool-flow-declaration.schema.json" }
      }
    },
    "toolPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pricing_model"],
      "properties": {
        "pricing_model": { "enum": ["flat", "per_invocation", "per_unit", "hybrid"] },
        "base_price": { "$ref": "#/$defs/monetaryAmount" },
        "unit_price": { "$ref": "#/$defs/monetaryAmount" },
        "billing_unit": { "type": "string", "minLength": 1 }
      }
    },
    "monetaryAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "toolAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "destructive", "idempotent", "requires_approval"],
      "properties": {
        "read_only": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "requires_approval": { "type": "boolean" }
      }
    },
    "requiredPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_syscall_profile"],
      "properties": {
        "read_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?!$)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$).+$" }
        },
        "write_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?!$)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$).+$" }
        },
        "network_destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/networkDestination" }
        },
        "environment_variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:[lL][dD]_|[dD][yY][lL][dD]_|[bB][aA][sS][hH]_[fF][uU][nN][cC]_|[mM][aA][lL][lL][oO][cC]_))(?!(?:[bB][aA][sS][hH]_[eE][nN][vV]|[dD][oO][cC][kK][eE][rR]_[cC][oO][nN][fF][iI][gG]|[eE][nN][vV]|[gG][cC][oO][nN][vV]_[pP][aA][tT][hH]|[gG][eE][mM]_[hH][oO][mM][eE]|[gG][eE][mM]_[pP][aA][tT][hH]|[gG][iI][tT]_[aA][sS][kK][pP][aA][sS][sS]|[gG][lL][iI][bB][cC]_[tT][uU][nN][aA][bB][lL][eE][sS]|[gG][pP][gG]_[aA][gG][eE][nN][tT]_[iI][nN][fF][oO]|[iI][fF][sS]|[jJ][aA][vV][aA]_[tT][oO][oO][lL]_[oO][pP][tT][iI][oO][nN][sS]|[jJ][dD][kK]_[jJ][aA][vV][aA]_[oO][pP][tT][iI][oO][nN][sS]|[kK][rR][bB]5[cC][cC][nN][aA][mM][eE]|[lL][oO][cC][pP][aA][tT][hH]|[nN][eE][tT][rR][cC]|[nN][lL][sS][pP][aA][tT][hH]|[nN][oO][dD][eE]_[oO][pP][tT][iI][oO][nN][sS]|[nN][oO][dD][eE]_[pP][aA][tT][hH]|[nN][pP][mM]_[cC][oO][nN][fF][iI][gG]_[uU][sS][eE][rR][cC][oO][nN][fF][iI][gG]|[pP][eE][rR][lL]5[oO][pP][tT]|[pP][eE][rR][lL]5[lL][iI][bB]|[pP][yY][tT][hH][oO][nN][hH][oO][mM][eE]|[pP][yY][tT][hH][oO][nN][iI][nN][sS][pP][eE][cC][tT]|[pP][yY][tT][hH][oO][nN][pP][aA][tT][hH]|[pP][yY][tT][hH][oO][nN][sS][tT][aA][rR][tT][uU][pP]|[rR][uU][bB][yY][lL][iI][bB]|[rR][uU][bB][yY][oO][pP][tT]|[rR][uU][sS][tT][cC]_[wW][rR][aA][pP][pP][eE][rR]|[sS][sS][lL][kK][eE][yY][lL][oO][gG][fF][iI][lL][eE]|[sS][sS][lL]_[cC][eE][rR][tT]_[dD][iI][rR]|[sS][sS][lL]_[cC][eE][rR][tT]_[fF][iI][lL][eE]|[sS][sS][hH]_[aA][uU][tT][hH]_[sS][oO][cC][kK]|[sS][uU][dD][oO]_[aA][sS][kK][pP][aA][sS][sS]|[zZ][dD][oO][tT][dD][iI][rR]|_[jJ][aA][vV][aA]_[oO][pP][tT][iI][oO][nN][sS])$)(?!.*(?:[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]|[aA][pP][iI]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[aA][cC][cC][eE][sS][sS]_[kK][eE][yY]|[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]))[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "native_syscall_profile": {
          "enum": ["native_minimal_v1", "native_standard_v1", "brokered_native_v1"]
        }
      }
    },
    "networkDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^A-Z*\\s/]+$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
