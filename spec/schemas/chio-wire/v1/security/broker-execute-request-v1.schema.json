{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-execute-request-v1.schema.json",
  "title": "Chio broker execute request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "invocationId", "capability", "proof", "request"],
  "properties": {
    "schema": { "const": "chio.broker-execute.v1" },
    "invocationId": { "$ref": "#/$defs/identifier" },
    "capability": { "$ref": "broker-capability-envelope-v1.schema.json" },
    "proof": { "$ref": "broker-request-proof-envelope-v1.schema.json" },
    "request": { "$ref": "#/$defs/request" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digestOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9-]+$" },
        "value": { "type": "array", "maxItems": 8192, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "streaming", "responseLimitBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "streaming": { "type": "boolean" },
        "responseLimitBytes": { "type": "integer", "minimum": 1, "maximum": 2097152 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "headers", "body", "approvedPreviewSha256", "options"],
      "properties": {
        "destination": { "$ref": "broker-capability-body-v1.schema.json#/$defs/destination" },
        "headers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/header" } },
        "body": { "type": "array", "maxItems": 524288, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "approvedPreviewSha256": { "$ref": "#/$defs/digestOrNull" },
        "options": { "$ref": "#/$defs/options" }
      }
    }
  }
}
