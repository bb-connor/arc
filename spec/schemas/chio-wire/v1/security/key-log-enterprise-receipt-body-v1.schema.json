{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/key-log-enterprise-receipt-body-v1.schema.json",
  "title": "Chio key-log enterprise receipt body v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "transaction_id", "issued_at", "log_id", "event_id", "event_sequence", "event_envelope_hash", "event_signers", "stage", "tree_size", "root_hash", "checkpoint_hash", "checkpoint_sequence", "operator_key_id", "witness_roster_id", "witness_signatures", "outcome"],
  "properties": {
    "schema": { "const": "chio.key-log.enterprise-receipt.v1" },
    "receipt_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "transaction_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "issued_at": { "type": "integer", "minimum": 1 },
    "log_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "event_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "event_envelope_hash": { "$ref": "#/$defs/hash" },
    "event_signers": { "type": "array", "minItems": 1, "maxItems": 66, "items": { "$ref": "#/$defs/eventSigner" } },
    "stage": { "enum": ["pending", "active"] },
    "tree_size": { "type": "integer", "minimum": 1 },
    "root_hash": { "$ref": "#/$defs/hash" },
    "checkpoint_hash": { "$ref": "#/$defs/hash" },
    "checkpoint_sequence": { "type": "integer", "minimum": 0 },
    "operator_key_id": { "$ref": "#/$defs/hash" },
    "witness_roster_id": { "$ref": "#/$defs/keyLogIdentifier" },
    "witness_signatures": { "type": "array", "maxItems": 64, "items": { "$ref": "key-log-witness-signature-v1.schema.json" } },
    "activation_commit_hash": { "$ref": "#/$defs/hash" },
    "signing_epoch": { "type": "integer", "minimum": 1 },
    "source_receipt_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/keyLogIdentifier" } },
    "outcome": { "enum": ["pending_committed", "activated"] }
  },
  "oneOf": [
    { "type": "object", "properties": { "stage": { "const": "pending" }, "outcome": { "const": "pending_committed" }, "witness_signatures": { "type": "array", "maxItems": 0 } }, "not": { "anyOf": [{ "type": "object", "required": ["activation_commit_hash"] }, { "type": "object", "required": ["signing_epoch"] }] } },
    { "type": "object", "required": ["activation_commit_hash", "signing_epoch", "source_receipt_ids"], "properties": { "stage": { "const": "active" }, "outcome": { "const": "activated" }, "witness_signatures": { "type": "array", "minItems": 1 }, "source_receipt_ids": { "type": "array", "minItems": 1, "maxItems": 1 } } }
  ],
  "$defs": {
    "keyLogIdentifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "eventSigner": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["role", "key_id"], "properties": { "role": { "const": "bootstrap" }, "key_id": { "$ref": "#/$defs/hash" } } },
        { "type": "object", "additionalProperties": false, "required": ["role", "key_id"], "properties": { "role": { "const": "old_key" }, "key_id": { "$ref": "#/$defs/hash" } } },
        { "type": "object", "additionalProperties": false, "required": ["role", "key_id"], "properties": { "role": { "const": "new_key" }, "key_id": { "$ref": "#/$defs/hash" } } },
        { "type": "object", "additionalProperties": false, "required": ["role", "authorizer_id"], "properties": { "role": { "const": "recovery" }, "authorizer_id": { "$ref": "#/$defs/keyLogIdentifier" } } }
      ]
    }
  }
}
