{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/detector-health-receipt-body-v1.schema.json",
  "title": "Chio detector health receipt body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "policy",
    "rule_id",
    "rule_version_hash",
    "group_binding",
    "event_id",
    "health_kind",
    "watermark",
    "evidence_hash"
  ],
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "group_binding": {
            "type": "object",
            "properties": { "kind": { "const": "unresolved" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "watermark": {
            "type": "object",
            "properties": { "kind": { "const": "unknown" } },
            "required": ["kind"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "watermark": {
            "type": "object",
            "properties": { "kind": { "const": "contradictory" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "group_binding": {
            "type": "object",
            "properties": { "kind": { "const": "resolved" } },
            "required": ["kind"]
          },
          "health_kind": { "const": "corrupt_state" }
        }
      }
    }
  ],
  "properties": {
    "header": { "$ref": "#/$defs/header" },
    "policy": { "$ref": "#/$defs/policy" },
    "rule_id": { "$ref": "#/$defs/identifier" },
    "rule_version_hash": { "$ref": "#/$defs/digest" },
    "group_binding": { "$ref": "#/$defs/group_binding" },
    "event_id": { "$ref": "#/$defs/identifier" },
    "health_kind": {
      "enum": [
        "corrupt_event",
        "corrupt_state",
        "state_overflow",
        "store_conflict",
        "store_unavailable",
        "truncated_scan"
      ]
    },
    "watermark": { "$ref": "#/$defs/watermark" },
    "evidence_hash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "digest": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "contains": { "type": "integer", "minimum": 1 },
      "minContains": 1
    },
    "time": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "occurred_at_unix_ms",
        "tenant_id",
        "transition_id",
        "prior_receipt_ids"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "occurred_at_unix_ms": { "$ref": "#/$defs/time" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "transition_id": { "$ref": "#/$defs/identifier" },
        "prior_receipt_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "policy_hash"],
      "properties": {
        "policy_version": { "$ref": "#/$defs/identifier" },
        "policy_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "group_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "unresolved" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "group_key_hash"],
          "properties": {
            "kind": { "const": "resolved" },
            "group_key_hash": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "watermark": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "unknown" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unix_ms"],
          "properties": {
            "kind": { "const": "committed" },
            "unix_ms": { "$ref": "#/$defs/time" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "claimed_unix_ms"],
          "properties": {
            "kind": { "const": "contradictory" },
            "claimed_unix_ms": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    }
  }
}
