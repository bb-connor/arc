{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-authority-request-body-v1.schema.json",
  "title": "Chio broker authority RPC request body v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "issuedAtUnixSeconds", "broker", "operation"],
  "properties": {
    "schema": { "const": "chio.broker-authority-rpc.v1" },
    "requestId": { "$ref": "#/$defs/authorityRpcIdentifier" },
    "issuedAtUnixSeconds": { "$ref": "#/$defs/positiveU64" },
    "broker": { "$ref": "#/$defs/publicKey" },
    "operation": { "$ref": "#/$defs/operation" }
  },
  "$defs": {
    "authorityRpcIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "authorityRpcDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveU64": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "byteArray": {
      "type": "array",
      "maxItems": 1048576,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" },
    "capabilitiesOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "capabilities" } }
    },
    "prepareExecutionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "prepare_execution" },
        "request": { "$ref": "broker-execute-request-v1.schema.json" }
      }
    },
    "capabilityLivenessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentCapabilityId", "expectedSubject", "expectedAudience", "nowUnixSeconds"],
      "properties": {
        "parentCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "expectedSubject": { "$ref": "#/$defs/publicKey" },
        "expectedAudience": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "nowUnixSeconds": { "$ref": "#/$defs/positiveU64" }
      }
    },
    "verifyLiveParentOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "verify_live_parent" },
        "request": { "$ref": "#/$defs/capabilityLivenessRequest" }
      }
    },
    "brokerRevocationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brokerCapabilityId", "revocationId", "nowUnixSeconds"],
      "properties": {
        "brokerCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "revocationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "nowUnixSeconds": { "$ref": "#/$defs/positiveU64" }
      }
    },
    "checkBrokerRevocationOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "check_broker_revocation" },
        "request": { "$ref": "#/$defs/brokerRevocationRequest" }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "maximumExecutions"],
      "properties": {
        "keyId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "maximumExecutions": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "authorizeHoldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "invocationId", "parentCapabilityId", "brokerCapabilityId", "holdId", "authorizeEventId", "quotas", "authorityMetadataDigest"],
      "properties": {
        "operationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "invocationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "parentCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "brokerCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "holdId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "authorizeEventId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "quotas": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/quota" } },
        "authorityMetadataDigest": { "$ref": "#/$defs/authorityRpcDigest" }
      }
    },
    "queryHoldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "invocationId", "parentCapabilityId", "brokerCapabilityId", "holdId", "authorizeEventId", "reverseEventId", "captureEventId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "invocationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "parentCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "brokerCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "holdId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "authorizeEventId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "reverseEventId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "captureEventId": { "$ref": "#/$defs/authorityRpcIdentifier" }
      }
    },
    "reverseHoldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "invocationId", "parentCapabilityId", "brokerCapabilityId", "holdId", "reverseEventId", "proofDispatchDidNotBegin"],
      "properties": {
        "operationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "invocationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "parentCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "brokerCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "holdId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "reverseEventId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "proofDispatchDidNotBegin": { "const": true }
      }
    },
    "captureHoldRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "invocationId", "parentCapabilityId", "brokerCapabilityId", "holdId", "captureEventId", "revocationIds", "revocationSetDigest", "authorizationArtifactDigest", "authorityMetadataDigest"],
      "properties": {
        "operationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "invocationId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "parentCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "brokerCapabilityId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "holdId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "captureEventId": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "revocationIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/authorityRpcIdentifier" } },
        "revocationSetDigest": { "$ref": "#/$defs/authorityRpcDigest" },
        "authorizationArtifactDigest": { "$ref": "#/$defs/authorityRpcDigest" },
        "authorityMetadataDigest": { "$ref": "#/$defs/authorityRpcDigest" }
      }
    },
    "holdOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request"],
          "properties": {
            "kind": { "const": "query_execution_hold" },
            "request": { "$ref": "#/$defs/queryHoldRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request"],
          "properties": {
            "kind": { "const": "authorize_execution_hold" },
            "request": { "$ref": "#/$defs/authorizeHoldRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request"],
          "properties": {
            "kind": { "const": "reverse_execution_hold" },
            "request": { "$ref": "#/$defs/reverseHoldRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request"],
          "properties": {
            "kind": { "const": "capture_execution_hold" },
            "request": { "$ref": "#/$defs/captureHoldRequest" }
          }
        }
      ]
    },
    "controlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "tenantScope", "authorization", "payload"],
      "properties": {
        "operation": { "enum": ["issue", "revoke", "status"] },
        "tenantScope": { "$ref": "#/$defs/authorityRpcIdentifier" },
        "authorization": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "payload": { "type": "array", "minItems": 1, "maxItems": 1048576, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "controlOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request"],
      "properties": {
        "kind": { "const": "control" },
        "request": { "$ref": "#/$defs/controlRequest" }
      }
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/capabilitiesOperation" },
        { "$ref": "#/$defs/prepareExecutionOperation" },
        { "$ref": "#/$defs/verifyLiveParentOperation" },
        { "$ref": "#/$defs/checkBrokerRevocationOperation" },
        { "$ref": "#/$defs/holdOperation" },
        { "$ref": "#/$defs/controlOperation" }
      ]
    }
  }
}
