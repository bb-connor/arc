{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/signed-tool-manifest-v2.schema.json",
  "title": "Chio signed tool manifest v2",
  "description": "Exact SignedManifest envelope admitted by chio-cage before any manifest permission is read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "signature", "signer_key"],
  "properties": {
    "manifest": { "$ref": "tool-manifest-v2.schema.json" },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" },
    "signer_key": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
