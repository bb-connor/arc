{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/key-log-witness-readiness-body-v1.schema.json",
  "title": "Chio key-log witness service readiness body v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "witness_id",
    "configuration_binding",
    "nonce",
    "process_id",
    "storage_identity",
    "started_at",
    "conflict_count",
    "gossip_observation_count"
  ],
  "properties": {
    "schema": { "const": "chio.key-log.witness-readiness.v1" },
    "witness_id": { "$ref": "#/$defs/identifier" },
    "configuration_binding": { "$ref": "#/$defs/hash" },
    "nonce": { "$ref": "#/$defs/nonce" },
    "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "storage_identity": { "$ref": "#/$defs/hash" },
    "started_at": { "$ref": "#/$defs/positiveU64" },
    "pin": { "$ref": "#/$defs/keyLogPin" },
    "conflict_count": { "$ref": "#/$defs/count" },
    "gossip_observation_count": { "$ref": "#/$defs/count" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "nonce": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "positiveU64": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "keyLogPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_sequence", "tree_size", "checkpoint_hash", "root_hash", "signing_epoch"],
      "properties": {
        "checkpoint_sequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "tree_size": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "checkpoint_hash": { "$ref": "#/$defs/hash" },
        "root_hash": { "$ref": "#/$defs/hash" },
        "signing_epoch": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    }
  }
}
