{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/correlated-finding-v1.schema.json",
  "title": "Chio correlated finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "tenant_id",
    "rule_id",
    "rule_version_hash",
    "policy_version",
    "group_key_hash",
    "ordered_event_ids",
    "ordered_evidence_digests",
    "ordered_source_receipt_ids",
    "first_event_time_unix_ms",
    "last_event_time_unix_ms",
    "lineage_seed"
  ],
  "properties": {
    "finding_id": { "$ref": "#/$defs/identifier" },
    "tenant_id": { "$ref": "#/$defs/identifier" },
    "rule_id": { "$ref": "#/$defs/identifier" },
    "rule_version_hash": { "$ref": "#/$defs/digest" },
    "policy_version": { "$ref": "#/$defs/identifier" },
    "group_key_hash": { "$ref": "#/$defs/digest" },
    "ordered_event_ids": { "$ref": "#/$defs/identifiers" },
    "ordered_evidence_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/digest" }
    },
    "ordered_source_receipt_ids": { "$ref": "#/$defs/identifiers" },
    "first_event_time_unix_ms": { "$ref": "#/$defs/time" },
    "last_event_time_unix_ms": { "$ref": "#/$defs/time" },
    "lineage_seed": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "digest": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
