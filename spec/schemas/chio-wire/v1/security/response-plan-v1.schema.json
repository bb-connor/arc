{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/response-plan-v1.schema.json",
  "title": "Chio response plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "trigger_finding_id",
    "trigger_finding_hash",
    "trigger_finding_receipt_id",
    "tenant_id",
    "policy_version",
    "policy_hash",
    "affected_ids",
    "affected_set_hash",
    "effects",
    "ttl_ms",
    "created_at_unix_ms",
    "expires_at_unix_ms",
    "operator_capability",
    "approval_requirement",
    "submitter",
    "reason_hash",
    "plan_hash"
  ],
  "properties": {
    "action_id": { "$ref": "#/$defs/identifier" },
    "trigger_finding_id": { "$ref": "#/$defs/identifier" },
    "trigger_finding_hash": { "$ref": "#/$defs/digest" },
    "trigger_finding_receipt_id": { "$ref": "#/$defs/identifier" },
    "tenant_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "$ref": "#/$defs/identifier" },
    "policy_hash": { "$ref": "#/$defs/digest" },
    "affected_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "affected_set_hash": { "$ref": "#/$defs/digest" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "response-effect-v1.schema.json" }
    },
    "ttl_ms": { "$ref": "#/$defs/time" },
    "created_at_unix_ms": { "$ref": "#/$defs/time" },
    "expires_at_unix_ms": { "$ref": "#/$defs/time" },
    "operator_capability": { "$ref": "#/$defs/operatorCapability" },
    "approval_requirement": { "$ref": "#/$defs/approvalRequirement" },
    "submitter": { "$ref": "#/$defs/identifier" },
    "reason_hash": { "$ref": "#/$defs/digest" },
    "plan_hash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "digest": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "operatorCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_digest", "expires_at_unix_ms", "executor_subject"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/identifier" },
        "capability_digest": { "$ref": "#/$defs/digest" },
        "expires_at_unix_ms": { "$ref": "#/$defs/time" },
        "executor_subject": { "$ref": "#/$defs/identifier" }
      }
    },
    "approvalRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_type"],
          "properties": { "approval_type": { "const": "automatic" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_type", "policy_id"],
          "properties": {
            "approval_type": { "const": "governed" },
            "policy_id": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    }
  }
}
