{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/security/broker-release-attempt-acknowledgement-v1.schema.json",
  "title": "Chio broker release-attempt acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operationId", "attemptId", "releasedAtUnixSeconds"],
  "properties": {
    "schema": { "const": "chio.broker-release-attempt-acknowledgement.v1" },
