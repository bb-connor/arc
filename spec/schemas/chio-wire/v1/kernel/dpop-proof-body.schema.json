{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/kernel/dpop-proof-body.schema.json",
  "title": "chio.dpop_proof.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_hash",
    "agent_key",
    "capability_id",
    "issued_at",
    "nonce",
    "replay_authority",
    "schema",
    "tool_name",
    "tool_server"
  ],
  "properties": {
    "action_hash": {
      "type": "string"
    },
    "agent_key": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "integer"
    },
    "nonce": {
      "type": "string"
    },
    "replay_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_store_uuid",
        "dpop_authority_id",
        "expectation_id",
        "max_clock_skew_secs",
        "proof_ttl_secs"
      ],
      "properties": {
        "destination_store_uuid": {
          "type": "string"
        },
        "dpop_authority_id": {
          "type": "string"
        },
        "expectation_id": {
          "type": "string"
        },
        "max_clock_skew_secs": {
          "type": "integer"
        },
        "proof_ttl_secs": {
          "type": "integer"
        }
      }
    },
    "schema": {
      "const": "chio.dpop_proof.v1"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_server": {
      "type": "string"
    }
  }
}
