                      "currency": {
                        "type": "string"
                      },
                      "root_binding_digest": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "normalizedChildScope": {
              "type": "string"
            },
            "normalizedParentScope": {
              "type": "string"
            },
            "restrictedPredicates": {
              "type": "array",
