{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/capability/capability-body.schema.json",
  "title": "chio.capability.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
