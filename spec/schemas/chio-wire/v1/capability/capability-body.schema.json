                              "additionalProperties": false,
                              "required": [
                                "mode"
                              ],
                              "properties": {
                                "mode": {
                                  "type": "string"
                                }
                              }
                            },
                            "threshold": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "currency",
                                "units"
                              ],
                              "properties": {
                                "currency": {
                                  "type": "string"
                                },
                                "units": {
                                  "type": "integer"
                                }
                              }
                            },
                            "threshold_units": {
                              "type": "integer"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "dpop_required": {
                "type": "boolean"
