              "max_cost_per_invocation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currency",
                  "units"
                ],
                "properties": {
                  "currency": {
                    "type": "string"
                  },
                  "units": {
                    "type": "integer"
                  }
                }
              },
              "max_invocations": {
                "type": "integer"
              },
              "max_total_cost": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currency",
                  "units"
                ],
                "properties": {
                  "currency": {
                    "type": "string"
                  },
                  "units": {
                    "type": "integer"
                  }
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "server_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              }
            }
          }
        },
        "prompt_grants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operations",
              "prompt_name"
