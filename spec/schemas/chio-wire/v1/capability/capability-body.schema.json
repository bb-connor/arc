    "scope_attenuations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "server_id",
          "tool_name",
          "type"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "subject": {
      "type": "string"
    }
