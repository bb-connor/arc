          "properties": {
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_invocations",
                "root_capability_hash",
                "root_capability_id",
                "root_expires_at",
                "root_issuer",
                "root_scope_hash",
                "root_subject",
                "schema"
              ],
              "properties": {
                "max_invocations": {
                  "type": "integer"
                },
                "root_capability_hash": {
                  "type": "string"
                },
                "root_capability_id": {
                  "type": "string"
                },
                "root_expires_at": {
                  "type": "integer"
                },
                "root_issuer": {
                  "type": "string"
                },
                "root_scope_hash": {
                  "type": "string"
                },
                "root_subject": {
                  "type": "string"
                },
                "schema": {
                  "type": "string"
                }
              }
            },
            "signature": {
              "type": "string"
