                            "listing_id": {
                              "type": "string"
                            },
                            "max_recoveries": {
                              "type": "integer"
                            },
                            "min_safety_tier": {
                              "type": "string"
                            },
                            "original_capability_id": {
                              "type": "string"
                            },
                            "original_delivery_receipt_id": {
                              "type": "string"
                            },
                            "purchase_key": {
                              "type": "string"
                            },
                            "recovery_id": {
                              "type": "string"
                            },
                            "settlement": {
