                                    "approval_budget_epoch": {
                                      "type": "integer"
                                    },
                                    "approval_budget_id": {
                                      "type": "string"
                                    },
                                    "root_capability_hash": {
                                      "type": "string"
                                    },
                                    "root_capability_id": {
                                      "type": "string"
                                    },
                                    "root_expires_at": {
                                      "type": "integer"
                                    },
                                    "root_grant_hash": {
                                      "type": "string"
                                    },
                                    "root_issuer": {
                                      "type": "string"
                                    },
                                    "root_scope_hash": {
                                      "type": "string"
                                    },
                                    "root_subject": {
                                      "type": "string"
                                    },
                                    "schema": {
                                      "type": "string"
                                    },
                                    "signer_key_epoch": {
                                      "type": "integer"
                                    },
                                    "threshold": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "required": [
                                        "currency",
                                        "units"
                                      ],
                                      "properties": {
                                        "currency": {
                                          "type": "string"
                                        },
                                        "units": {
                                          "type": "integer"
                                        }
                                      }
                                    }
                                  }
                                },
                                "signature": {
                                  "type": "string"
                                }
                              }
