{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/capability/aggregate-budget-root-binding-body.schema.json",
  "title": "Chio aggregate budget root binding body",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "root_capability_id", "root_capability_hash", "root_issuer", "root_subject", "max_invocations", "root_expires_at", "root_scope_hash"],
  "properties": {
    "schema": { "const": "chio.aggregate-budget-root.v1" },
    "root_capability_id": { "$ref": "#/$defs/identifier" },
    "root_capability_hash": { "$ref": "#/$defs/digest" },
    "root_issuer": { "$ref": "#/$defs/publicKey" },
    "root_subject": { "$ref": "#/$defs/publicKey" },
    "max_invocations": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "root_expires_at": { "type": "integer", "minimum": 1 },
    "root_scope_hash": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
