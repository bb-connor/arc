{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/capability/aggregate-invocation-budget.schema.json",
  "title": "Chio aggregate invocation budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "max_invocations"],
  "properties": {
    "scope": { "enum": ["capability", "delegation_family"] },
    "max_invocations": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "root_binding": { "$ref": "aggregate-budget-root-binding.schema.json" }
  },
  "oneOf": [
    { "properties": { "scope": { "const": "capability" } }, "not": { "required": ["root_binding"], "properties": { "root_binding": true } } },
    { "required": ["root_binding"], "properties": { "scope": { "const": "delegation_family" }, "root_binding": true } }
  ]
}
