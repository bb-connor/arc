{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/capability/verified-approval-set.schema.json",
  "title": "Chio verified threshold approval set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalTokenDigests", "policyHash", "required", "eligibleSetDigest", "requestId", "governedIntentHash", "subject", "authorizationCapabilityHash", "thresholdProposalHash", "proposalId", "proposalCreatedAt", "proposalDeadline"],
  "properties": {
    "schema": { "const": "chio.verified-approval-set.v1" },
    "canonicalTokenDigests": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "policyHash": { "$ref": "#/$defs/digest" },
    "required": { "type": "integer", "minimum": 1, "maximum": 32 },
    "eligibleSetDigest": { "$ref": "#/$defs/digest" },
    "requestId": { "$ref": "#/$defs/governanceIdentifier" },
    "governedIntentHash": { "$ref": "#/$defs/digest" },
    "subject": { "$ref": "#/$defs/publicKey" },
    "authorizationCapabilityHash": { "$ref": "#/$defs/digest" },
    "thresholdProposalHash": { "$ref": "#/$defs/digest" },
    "proposalId": { "$ref": "#/$defs/governanceIdentifier" },
    "proposalCreatedAt": { "type": "integer", "minimum": 0 },
    "proposalDeadline": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "governanceIdentifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
