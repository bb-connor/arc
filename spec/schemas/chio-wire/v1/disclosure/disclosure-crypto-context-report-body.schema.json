{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/disclosure/disclosure-crypto-context-report-body.schema.json",
  "title": "chio.disclosure.crypto-context-report.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_ref",
    "context_id",
    "cryptographic_proof_verified",
    "disclosed_fields",
    "evidence_class",
    "id",
    "projection_manifest_ref",
    "rejected_checks",
    "schema",
    "verdict",
    "verified_claims"
  ],
  "properties": {
    "artifact_ref": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "cryptographic_proof_verified": {
      "type": "boolean"
    },
    "disclosed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_class": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "projection_manifest_ref": {
      "type": "string"
    },
    "rejected_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schema": {
      "const": "chio.disclosure.crypto-context-report.v1"
    },
    "verdict": {
      "type": "string"
    },
    "verified_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
