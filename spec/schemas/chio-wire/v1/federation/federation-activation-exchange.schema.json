{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/federation/federation-activation-exchange.schema.json",
  "title": "Chio federation activation exchange signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activationRef",
    "delegationControl",
    "exchangeId",
    "expiresAt",
    "governingCharterRef",
    "importControl",
