      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "operatorId",
        "schema",
        "sha256",
        "uri"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "operatorId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "delegationControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
