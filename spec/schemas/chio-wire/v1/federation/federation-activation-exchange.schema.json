        "maxHops",
        "visibilityOnlyUntilLocalActivation"
      ],
      "properties": {
        "attenuationRequired": {
          "type": "boolean"
        },
        "delegateOperatorId": {
          "type": "string"
        },
        "delegatorOperatorId": {
          "type": "string"
        },
        "maxHops": {
          "type": "integer"
        },
        "visibilityOnlyUntilLocalActivation": {
          "type": "boolean"
        }
      }
    },
    "exchangeId": {
      "type": "string"
    },
    "expiresAt": {
      "type": "integer"
    },
    "governingCharterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "kind",
        "operatorId",
        "schema",
        "sha256",
        "uri"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "operatorId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "importControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowVisibilityWithoutRuntimeTrust",
