{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/receipt/decision-model-witness.schema.json",
  "title": "Chio Decision Model Witness Receipt Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_card_digest",
    "artifact_digest",
    "outcome",
    "evaluation",
    "work_ops"
  ],
  "properties": {
    "schema": { "const": "chio.decision-model-witness.v1" },
    "model_card_digest": { "$ref": "#/$defs/digest" },
    "artifact_digest": { "$ref": "#/$defs/digest" },
    "outcome": {
      "enum": [
        "allow",
        "hold",
        "deny"
      ]
    },
    "evaluation": {
      "enum": [
        "evaluated",
        "fallback"
      ]
    },
    "fallback_reason": {
      "enum": [
        "empty_proposal",
        "proposal_infeasible",
        "scorer_error",
        "work_exhausted",
        "policy_unavailable"
      ]
    },
    "work_ops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evaluation": { "const": "evaluated" } },
        "required": ["evaluation"]
      },
      "then": {
        "not": { "required": ["fallback_reason"] }
      }
    },
    {
      "if": {
        "properties": { "evaluation": { "const": "fallback" } },
        "required": ["evaluation"]
      },
      "then": {
        "required": ["fallback_reason"],
        "properties": {
          "outcome": { "const": "deny" },
          "work_ops": { "const": 0 }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
