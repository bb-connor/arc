      "type": "string"
    },
    "deployment": {
      "type": "string"
    },
    "issuedAt": {
      "type": "integer"
    },
    "method": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "query": {
      "type": "string"
