{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/trust-control/partition-escrow-allocation-set.schema.json",
  "title": "Chio signed partition-escrow allocation set",
  "description": "An allocator-signed, complete partition allocation plan derived from one source-signed quota commitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "allocatorKey", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "#/$defs/body" },
    "allocatorKey": {
      "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowPublicKey"
    },
    "algorithm": {
      "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowSignatureAlgorithm"
    },
    "signature": {
      "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowSignature"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "algorithm": { "const": "ed25519" } } },
      "then": {
        "properties": {
          "allocatorKey": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowEd25519PublicKey"
          },
          "signature": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowEd25519Signature"
          }
        }
      }
    },
    {
      "if": { "properties": { "algorithm": { "const": "p256" } } },
      "then": {
        "properties": {
          "allocatorKey": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowP256PublicKey"
          },
          "signature": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowP256Signature"
          }
        }
      }
    },
    {
      "if": { "properties": { "algorithm": { "const": "p384" } } },
      "then": {
        "properties": {
          "allocatorKey": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowP384PublicKey"
          },
          "signature": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowP384Signature"
          }
        }
      }
    },
    {
      "if": { "properties": { "algorithm": { "const": "hybrid" } } },
      "then": {
        "properties": {
          "allocatorKey": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowHybridPublicKey"
          },
          "signature": {
            "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowHybridSignature"
          }
        }
      }
    }
  ],
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorityDomain",
        "allocationRootId",
        "allocationEpoch",
        "quota",
        "quotaCommitmentDigest",
        "quotaCommitmentExpiresAt",
        "allocationPlanDigest",
        "notBefore",
        "expiresAt",
        "allocations"
      ],
      "properties": {
        "schema": { "const": "chio.partition-escrow-allocation-set.v1" },
        "authorityDomain": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowIdentifier"
        },
        "allocationRootId": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowIdentifier"
        },
        "allocationEpoch": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowPositiveSafeInteger"
        },
        "quota": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowQuota"
        },
        "quotaCommitmentDigest": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowDigest"
        },
        "quotaCommitmentExpiresAt": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowPositiveSafeInteger"
        },
        "allocationPlanDigest": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowDigest"
        },
        "notBefore": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowSafeInteger"
        },
        "expiresAt": {
          "allOf": [
            {
              "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowPositiveSafeInteger"
            }
          ],
          "description": "Exclusive allocation expiry. Runtime validation also requires notBefore < expiresAt <= quotaCommitmentExpiresAt."
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/allocation" },
          "description": "The complete allocation set. Runtime validation additionally requires bytewise ordering, unique partition and authority identifiers, and a sum no greater than quota.maxInvocations."
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitionId", "authorityId", "allocatedInvocations"],
      "properties": {
        "partitionId": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowIdentifier"
        },
        "authorityId": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowIdentifier"
        },
        "allocatedInvocations": {
          "$ref": "partition-escrow-quota-commitment.schema.json#/$defs/partitionEscrowUint32"
        }
      }
    }
  }
}
