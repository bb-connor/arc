{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/outcome/outcome-sla-body.schema.json",
  "title": "chio.outcome.sla.v1 signed body",
  "type": "object",
