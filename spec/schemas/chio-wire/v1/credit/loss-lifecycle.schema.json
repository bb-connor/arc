            "bondLifecycleProjectionAuthoritative": {
              "type": "boolean"
            },
            "externalClaimAdjudicationSupported": {
              "type": "boolean"
            },
            "immutableLifecycleAuthoritative": {
              "type": "boolean"
            },
            "reserveControlExecutionSupported": {
              "type": "boolean"
