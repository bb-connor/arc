                "currency": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                }
              }
            },
            "currentRecoveredAmount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currency",
                "units"
              ],
              "properties": {
                "currency": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                }
              }
            },
            "currentReleasedReserveAmount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currency",
                "units"
