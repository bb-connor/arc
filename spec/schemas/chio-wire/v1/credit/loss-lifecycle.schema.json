{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/credit/loss-lifecycle.schema.json",
  "title": "Chio credit loss lifecycle signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bondId",
    "eventId",
    "eventKind",
    "issuedAt",
    "projectedBondLifecycleState",
    "report",
    "schema"
