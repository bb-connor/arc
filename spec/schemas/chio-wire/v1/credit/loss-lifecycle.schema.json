              "properties": {
                "currency": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                }
              }
            },
            "eventAmount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currency",
                "units"
              ],
              "properties": {
                "currency": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                }
              }
            },
            "facilityId": {
              "type": "string"
            },
            "outstandingDelinquentAmount": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currency",
                "units"
              ],
              "properties": {
                "currency": {
                  "type": "string"
                },
                "units": {
                  "type": "integer"
                }
              }
            },
            "projectedBondLifecycleState": {
              "type": "string"
