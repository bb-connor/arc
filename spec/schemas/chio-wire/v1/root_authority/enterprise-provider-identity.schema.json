{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/root_authority/enterprise-provider-identity.schema.json",
  "title": "Chio Enterprise Provider Identity",
  "description": "`chio.enterprise-provider-identity.v1`: the unsigned, content-addressed identity projection of one enterprise provider record. A root policy rule pins `SHA-256(\"chio.enterprise-provider-identity.v1\\0\" || canonical_json(projection))` as `provider_identity_digest`. The projection excludes `enabled`, other provenance labels and validation errors. Decoding is strict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "kind",
    "issuer",
    "audiences",
    "subject_mapping",
    "trust_material_ref"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chio.enterprise-provider-identity.v1"
    },
    "provider_id": {
      "$ref": "root-anchor.schema.json#/$defs/Identifier"
    },
    "kind": {
      "type": "string",
      "enum": [
        "oidc_jwks",
        "oauth_introspection"
      ],
      "description": "Record kinds a root policy rule may reference. `scim` and `saml` records are never referenced."
    },
    "issuer": {
      "$ref": "root-anchor.schema.json#/$defs/Uri"
    },
    "jwks_url": {
      "$ref": "root-anchor.schema.json#/$defs/HttpsUrl"
    },
    "jwks": {
      "$ref": "#/$defs/InlineJwks"
    },
    "introspection_url": {
      "$ref": "root-anchor.schema.json#/$defs/HttpsUrl"
    },
    "audiences": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/Uri"
      },
      "description": "The record's `trust_boundary.allowed_audiences`."
    },
    "subject_mapping": {
      "$ref": "#/$defs/SubjectMapping"
    },
    "trust_material_ref": {
      "$ref": "root-anchor.schema.json#/$defs/Identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "oidc_jwks"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "jwks_url"
            ]
          },
          {
            "required": [
              "jwks"
            ]
          }
        ],
        "not": {
          "required": [
            "introspection_url"
          ]
        }
      },
      "else": {
        "required": [
          "introspection_url"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "jwks_url"
              ]
            },
            {
              "required": [
                "jwks"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "InlineJwks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "root-anchor.schema.json#/$defs/Jwk"
          }
        }
      }
    },
    "SubjectMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_source",
        "tenant_id_field"
      ],
      "properties": {
        "principal_source": {
          "$ref": "root-anchor.schema.json#/$defs/Identifier",
          "description": "The one claim that is the principal (`oid` for Entra records)."
        },
        "tenant_id_field": {
          "$ref": "root-anchor.schema.json#/$defs/Identifier",
          "description": "The tenant claim (`iss` for per-organization issuers, `tid` for Entra); it feeds the tenant tag."
        }
      }
    }
  }
}
