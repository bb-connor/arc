{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/root_authority/root-policy.schema.json",
  "title": "Chio Root Policy",
  "description": "`chio.root-policy.v1` (PROTOCOL 5.6.4), signed by the provider's policy key over the signing wrapper. It names the exchange keys, the anchor rules that admit roots and the disclosure policy for committed receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "policy_key",
    "exchange_keys",
    "rules",
    "disclosure",
    "valid_from",
    "valid_until",
    "signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chio.root-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_key": {
      "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex",
      "description": "Must equal the policy key pinned in the edge configuration."
    },
    "exchange_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RootPolicyRule"
      }
    },
    "disclosure": {
      "$ref": "#/$defs/RootPolicyDisclosure"
    },
    "valid_from": {
      "type": "integer",
      "minimum": 0
    },
    "valid_until": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "$ref": "root-anchor.schema.json#/$defs/SignatureHex"
    }
  },
  "$defs": {
    "RootPolicyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "match",
        "ceiling_scope",
        "ceiling_scope_hash",
        "recorded_claims",
        "holder_classes"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "$ref": "#/$defs/RootPolicyMatch"
        },
        "tenant_claim": {
          "type": "string",
          "minLength": 1,
          "description": "Claim that identifies the caller's tenant (`iss` for per-organization issuers, `tid` for Entra)."
        },
        "idp_scope_projection": {
          "type": "object",
          "description": "Identity-provider scope value to the `server/tool` names it projects to. A scope value absent here denies the exchange.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ceiling_scope": {
          "$ref": "../capability/token.schema.json#/$defs/chioScope"
        },
        "ceiling_scope_hash": {
          "$ref": "root-anchor.schema.json#/$defs/Digest"
        },
        "recorded_claims": {
          "type": "object",
          "description": "Claims copied into the delegation context, each plain or committed.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "plain",
              "committed"
            ]
          }
        },
        "holder_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "root-anchor.schema.json#/$defs/HolderClass"
          }
        },
        "capability_ttl_secs": {
          "type": "integer",
          "minimum": 1,
          "description": "Defaults to 300."
        },
        "max_assertion_lifetime_secs": {
          "type": "integer",
          "minimum": 1,
          "description": "Defaults to 300. Absent on `entra_jwt` and `entra_agent_id` rules."
        },
        "max_clock_skew_secs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "retain_idp_artifact": {
          "type": "boolean",
          "description": "Allowed only on `oauth_id_jag` rules."
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "description": "Operator-configured principal. Required on `operator_static_bearer` rules and rejected on every other kind."
        },
        "tenant_value": {
          "type": "string",
          "minLength": 1,
          "description": "Operator-configured tenant. Required on `operator_static_bearer` rules and rejected on every other kind."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "anchor_kind": {
                    "const": "operator_static_bearer"
                  }
                },
                "required": [
                  "anchor_kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "required": [
              "principal",
              "tenant_value"
            ],
            "properties": {
              "match": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "jwks_uri"
                      ]
                    },
                    {
                      "required": [
                        "allowed_algs"
                      ]
                    }
                  ]
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "idp_scope_projection"
                  ]
                },
                {
                  "required": [
                    "tenant_claim"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "principal"
                  ]
                },
                {
                  "required": [
                    "tenant_value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "anchor_kind": {
                    "enum": [
                      "oauth_id_jag",
                      "entra_jwt",
                      "entra_agent_id"
                    ]
                  }
                },
                "required": [
                  "anchor_kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "match": {
                "required": [
                  "jwks_uri",
                  "allowed_algs"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "anchor_kind": {
                    "enum": [
                      "entra_jwt",
                      "entra_agent_id"
                    ]
                  }
                },
                "required": [
                  "anchor_kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "not": {
              "required": [
                "max_assertion_lifetime_secs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "anchor_kind": {
                    "const": "oauth_id_jag"
                  }
                },
                "required": [
                  "anchor_kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "else": {
            "not": {
              "required": [
                "retain_idp_artifact"
              ]
            }
          }
        }
      ]
    },
    "RootPolicyMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_kind",
        "issuer"
      ],
      "properties": {
        "anchor_kind": {
          "$ref": "root-anchor.schema.json#/$defs/AnchorKind"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "jwks_uri": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "description": "Required for every JWKS-verified kind. Keys are fetched only from it."
        },
        "allowed_algs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "root-anchor.schema.json#/$defs/JwsAlgorithm"
          }
        },
        "claims": {
          "type": "object",
          "description": "Claim name to the values it must take for the rule to match.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "RootPolicyDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "const": "committed",
          "description": "The only allowed value."
        },
        "tools": {
          "type": "object",
          "description": "`server/tool` to the RFC 6901 pointers that may appear in plaintext in that tool's receipts. A tool not listed is fully committed.",
          "additionalProperties": {
            "$ref": "#/$defs/ToolDisclosure"
          }
        }
      }
    },
    "ToolDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters",
        "result"
      ],
      "properties": {
        "parameters": {
          "$ref": "#/$defs/InlineFields"
        },
        "result": {
          "$ref": "#/$defs/InlineFields"
        }
      }
    },
    "InlineFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inline_fields"
      ],
      "properties": {
        "inline_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(/([^~/]|~[01])*)+$"
          }
        }
      }
    }
  }
}
