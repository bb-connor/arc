{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/root_authority/verifier-trust.schema.json",
  "title": "Chio Verifier Trust",
  "description": "`chio.verifier-trust.v1` (PROTOCOL 5.6.8): a local, unsigned file the verifying party writes and controls. It pins the keys a verifier accepts and the report columns that must be `verified`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kernel_keys",
    "exchange_keys",
    "root_policy_keys"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chio.verifier-trust.v1"
    },
    "kernel_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "exchange_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "root_policy_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "idp_keys": {
      "type": "object",
      "description": "Issuer to the identity-provider keys the verifier pins itself.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "root-anchor.schema.json#/$defs/Jwk"
        }
      }
    },
    "pep_keys": {
      "type": "object",
      "description": "Policy enforcement point id to its pinned key.",
      "additionalProperties": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "checkpoint_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      }
    },
    "required_columns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "identity_root",
          "delegation_chain",
          "decision",
          "content",
          "settlement"
        ]
      }
    }
  }
}
