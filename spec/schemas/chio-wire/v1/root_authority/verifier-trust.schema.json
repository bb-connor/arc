{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/root_authority/verifier-trust.schema.json",
  "title": "Chio Verifier Trust",
  "description": "`chio.verifier-trust.v1`: a local, unsigned file the verifying party writes and controls. It pins the keys a verifier accepts and the report columns that must be `verified`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kernel_keys",
    "exchange_keys",
    "root_policy_keys"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chio.verifier-trust.v1"
    },
    "kernel_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "exchange_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Keys that may sign anchored roots."
    },
    "root_policy_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Keys that may sign root policies."
    },
    "idp_keys": {
      "type": "object",
      "description": "Issuer to the identity-provider keys the verifier pins itself.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "root-anchor.schema.json#/$defs/Jwk"
        },
        "maxItems": 64
      },
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 2048,
        "pattern": "^[^\\u0000\\s]+$"
      }
    },
    "pep_keys": {
      "type": "object",
      "description": "Policy enforcement point id to its pinned key.",
      "additionalProperties": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      },
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "checkpoint_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "root-anchor.schema.json#/$defs/PublicKeyHex"
      },
      "maxItems": 64
    },
    "checkpoint_trust_anchor": {
      "$ref": "#/$defs/CheckpointTrustAnchorBinding",
      "description": "The checkpoint publication binding the verifier accepts as a trust anchor. Absent: publication claims stay transparency previews."
    },
    "required_columns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "identity_root",
          "delegation_chain",
          "decision",
          "content",
          "settlement"
        ]
      },
      "maxItems": 5
    }
  },
  "$defs": {
    "CheckpointTrustAnchorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationIdentity",
        "trustAnchorIdentity",
        "trustAnchorRef",
        "signerCertRef",
        "publicationProfileVersion"
      ],
      "properties": {
        "publicationIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "local_log",
                "transparency_service",
                "immutable_record",
                "chain_anchor"
              ]
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "trustAnchorIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "operator_root",
                "did",
                "x509_root",
                "transparency_root",
                "chain_root"
              ]
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "trustAnchorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "signerCertRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "publicationProfileVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}
