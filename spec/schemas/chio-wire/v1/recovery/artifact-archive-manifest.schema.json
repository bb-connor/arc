{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/artifact-archive-manifest.schema.json",
  "title": "Artifact Archive Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "root",
    "versions",
    "total_bytes"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "root": {
      "$ref": "#/$defs/artifactReference"
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "artifact-version.schema.json"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact",
        "version",
        "provenance"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifact": {
          "$ref": "#/$defs/opaqueId"
        },
        "version": {
          "$ref": "#/$defs/opaqueId"
        },
        "provenance": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
