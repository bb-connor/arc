{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/recovery-setup-report.schema.json",
  "title": "Recovery Setup Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "probe",
    "benign_operation",
    "benign_receipt",
    "denied_command_digest",
    "previous_serving_fence",
    "current_serving_fence",
    "qualified_at_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "probe": {
      "$ref": "recovery-setup-probe.schema.json"
    },
    "benign_operation": {
      "$ref": "#/$defs/opaqueId"
    },
    "benign_receipt": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "denied_command_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "previous_serving_fence": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "current_serving_fence": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "qualified_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
