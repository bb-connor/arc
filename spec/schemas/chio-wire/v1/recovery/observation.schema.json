{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/recovery/observation.schema.json",
  "title": "Recovery observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "scope",
    "workflow_id",
    "step_id",
    "continuation_id",
    "revision",
    "effect",
    "release",
    "control",
    "knowledge_digest"
  ],
  "properties": {
    "schema": {
      "const": "chio.recovery.observation.v1"
    },
    "version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "workflow_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "step_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "continuation_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "revision": {
      "$ref": "#/$defs/safeInteger"
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/recoveryEffectNeverAdmittedV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAdmissionUnresolvedV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectClosedBeforeEffectV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAwaitingApprovalV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectInFlightV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAwaitingCallerReportV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectUnknownV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectCompleteV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectPartialV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectFailedAfterEffectV1"
        }
      ]
    },
    "release": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "not_available"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "release_id"
          ],
          "properties": {
            "kind": {
              "const": "pending"
            },
            "release_id": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "withheld"
            },
            "evidence": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "release_id"
          ],
          "properties": {
            "kind": {
              "const": "released"
            },
            "release_id": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "denied"
            },
            "reason": {
              "$ref": "#/$defs/refusalCode"
            }
          }
        }
      ]
    },
    "control": {
      "type": "string",
      "enum": [
        "active",
        "cancel_requested",
        "cancelled",
        "quarantined"
      ]
    },
    "knowledge_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "properties": {
              "kind": {
                "enum": [
                  "never_admitted",
                  "closed_before_effect",
                  "awaiting_approval",
                  "in_flight",
                  "awaiting_caller_report",
                  "unknown",
                  "admission_unresolved"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "not_available"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "native_admission_digest",
        "operation_version"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "native_admission_digest": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "operation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "refusalCode": {
      "type": "string",
      "enum": [
        "invalid_evidence",
        "unsupported_profile",
        "stale_basis",
        "revoked",
        "expired",
        "budget_unavailable",
        "unknown_effect",
        "audience_denied",
        "resource_exhausted"
      ]
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "recoveryEffectNeverAdmittedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "never_admitted"
        }
      },
      "title": "Recovery effect never admitted V1"
    },
    "recoveryEffectAdmissionUnresolvedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "admission_intent"
      ],
      "properties": {
        "kind": {
          "const": "admission_unresolved"
        },
        "admission_intent": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect admission unresolved V1"
    },
    "recoveryEffectClosedBeforeEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "closure"
      ],
      "properties": {
        "kind": {
          "const": "closed_before_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "closure": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect closed before effect V1"
    },
    "recoveryEffectAwaitingApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_approval"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting approval V1"
    },
    "recoveryEffectInFlightV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "in_flight"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect in flight V1"
    },
    "recoveryEffectAwaitingCallerReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_caller_report"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting caller report V1"
    },
    "recoveryEffectUnknownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect unknown V1"
    },
    "recoveryEffectCompleteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "effect_count"
      ],
      "properties": {
        "kind": {
          "const": "complete"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "effect_count": {
          "$ref": "#/$defs/safeInteger"
        }
      },
      "title": "Recovery effect complete V1"
    },
    "recoveryEffectPartialV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "partial"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect partial V1"
    },
    "recoveryEffectFailedAfterEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "failed_after_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect failed after effect V1"
    }
  }
}
