{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/labeled-checkpoint.schema.json",
  "title": "Labeled Checkpoint V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "checkpoint",
    "revision",
    "scope",
    "runtime",
    "artifacts",
    "model_contexts",
    "label",
    "influence",
    "lineage",
    "isolation_epoch",
    "native_evidence_sequence",
    "policy"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "checkpoint": {
      "$ref": "#/$defs/opaqueId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "model_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelContext"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "label": {
      "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
    },
    "influence": {
      "$ref": "#/$defs/artifactInfluence"
    },
    "lineage": {
      "$ref": "#/$defs/opaqueId"
    },
    "isolation_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "native_evidence_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "policy": {
      "$ref": "#/$defs/recoveryDigest32"
    }
  },
  "$defs": {
    "artifactInfluence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment",
        "externally_influenced",
        "unknown"
      ],
      "properties": {
        "commitment": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "externally_influenced": {
          "type": "boolean"
        },
        "unknown": {
          "type": "boolean"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact",
        "version",
        "provenance"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifact": {
          "$ref": "#/$defs/opaqueId"
        },
        "version": {
          "$ref": "#/$defs/opaqueId"
        },
        "provenance": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    },
    "modelContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "provider",
        "account",
        "conversation",
        "cache",
        "side_files",
        "contract"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "$ref": "#/$defs/opaqueId"
        },
        "account": {
          "$ref": "#/$defs/opaqueId"
        },
        "conversation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "cache": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "side_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactReference"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "contract": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
