{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/policy-maintenance-view.schema.json",
  "title": "Policy Maintenance View V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "digest",
    "proposal",
    "label",
    "influence"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "proposal": {
      "$ref": "policy-maintenance-proposal.schema.json"
    },
    "label": {
      "$ref": "../security/information-label.schema.json"
    },
    "influence": {
      "$ref": "artifact-influence.schema.json"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
