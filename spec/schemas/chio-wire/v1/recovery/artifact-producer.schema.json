{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/artifact-producer.schema.json",
  "title": "Artifact Producer V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "native_operation"
        },
        "operation": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkpoint"
      ],
      "properties": {
        "kind": {
          "const": "checkpoint"
        },
        "checkpoint": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "derivation"
        },
        "operation": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "adoption"
        },
        "evidence": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifest",
        "origin"
      ],
      "properties": {
        "kind": {
          "const": "import"
        },
        "manifest": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "origin": {
          "$ref": "#/$defs/artifactReference"
        }
      }
    }
  ],
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact",
        "version",
        "provenance"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifact": {
          "$ref": "#/$defs/opaqueId"
        },
        "version": {
          "$ref": "#/$defs/opaqueId"
        },
        "provenance": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
