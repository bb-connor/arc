{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/explanation-request.schema.json",
  "title": "Recovery Explanation Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "workflow_id"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "workflow_id": {
      "$ref": "#/$defs/opaqueId"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "destinationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$",
      "x-maxUtf8Bytes": 256
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "native_admission_digest",
        "operation_version"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "native_admission_digest": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "operation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "refusalCode": {
      "type": "string",
      "enum": [
        "invalid_evidence",
        "unsupported_profile",
        "stale_basis",
        "revoked",
        "expired",
        "budget_unavailable",
        "unknown_effect",
        "audience_denied",
        "resource_exhausted"
      ]
    },
    "recoveryEffectNeverAdmittedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "never_admitted"
        }
      },
      "title": "Recovery effect never admitted V1"
    },
    "recoveryEffectAdmissionUnresolvedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "admission_intent"
      ],
      "properties": {
        "kind": {
          "const": "admission_unresolved"
        },
        "admission_intent": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect admission unresolved V1"
    },
    "recoveryEffectClosedBeforeEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "closure"
      ],
      "properties": {
        "kind": {
          "const": "closed_before_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "closure": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect closed before effect V1"
    },
    "recoveryEffectAwaitingApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_approval"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting approval V1"
    },
    "recoveryEffectInFlightV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "in_flight"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect in flight V1"
    },
    "recoveryEffectAwaitingCallerReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_caller_report"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting caller report V1"
    },
    "recoveryEffectUnknownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect unknown V1"
    },
    "recoveryEffectCompleteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "effect_count"
      ],
      "properties": {
        "kind": {
          "const": "complete"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "effect_count": {
          "$ref": "#/$defs/safeInteger"
        }
      },
      "title": "Recovery effect complete V1"
    },
    "recoveryEffectPartialV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "partial"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect partial V1"
    },
    "recoveryEffectFailedAfterEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "failed_after_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect failed after effect V1"
    }
  }
}
