{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/policy-deployment-change.schema.json",
  "title": "Policy Deployment Change V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "proposal_id",
    "proposal_digest",
    "base_deployment",
    "base_policy",
    "target_deployment",
    "target_policy",
    "base_generation",
    "target_generation",
    "writer_fence"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "proposal_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "proposal_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "base_deployment": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "base_policy": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "target_deployment": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "target_policy": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "base_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "writer_fence": {
      "$ref": "#/$defs/recoveryDigest32"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
