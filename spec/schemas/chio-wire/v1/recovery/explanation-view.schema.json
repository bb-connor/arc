{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/explanation-view.schema.json",
  "title": "Recovery Explanation View V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "planner_version",
    "trust_domain",
    "issuer",
    "recipient",
    "report_ref",
    "issued_at_unix_ms",
    "expires_at_unix_ms",
    "projection"
  ],
  "properties": {
    "schema": {
      "const": "chio.recovery.explanation-view.v1"
    },
    "version": {
      "const": 1
    },
    "planner_version": {
      "const": "chio.recovery.planner.v1"
    },
    "trust_domain": {
      "$ref": "#/$defs/opaqueId"
    },
    "issuer": {
      "$ref": "#/$defs/opaqueId"
    },
    "recipient": {
      "$ref": "#/$defs/opaqueId"
    },
    "report_ref": {
      "$ref": "#/$defs/opaqueId"
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "expires_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "candidates"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "enum": [
            "authorized_inspection_required",
            "no_disclosable_advice",
            "alternatives_under_snapshot",
            "search_bound_reached"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template_id",
              "assessment"
            ],
            "properties": {
              "template_id": {
                "$ref": "#/$defs/opaqueId"
              },
              "assessment": {
                "type": "string",
                "enum": [
                  "feasible_under_snapshot",
                  "requires_exact_approval",
                  "requires_transformation",
                  "requires_prerequisite",
                  "needs_fresh_evidence",
                  "blocked_by_capability",
                  "unknown_outcome",
                  "no_registered_remedy",
                  "search_bound_reached"
                ]
              }
            }
          },
          "maxItems": 16
        }
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "destinationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$",
      "x-maxUtf8Bytes": 256
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "native_admission_digest",
        "operation_version"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "native_admission_digest": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "operation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "refusalCode": {
      "type": "string",
      "enum": [
        "invalid_evidence",
        "unsupported_profile",
        "stale_basis",
        "revoked",
        "expired",
        "budget_unavailable",
        "unknown_effect",
        "audience_denied",
        "resource_exhausted"
      ]
    },
    "recoveryEffectNeverAdmittedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "never_admitted"
        }
      },
      "title": "Recovery effect never admitted V1"
    },
    "recoveryEffectAdmissionUnresolvedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "admission_intent"
      ],
      "properties": {
        "kind": {
          "const": "admission_unresolved"
        },
        "admission_intent": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect admission unresolved V1"
    },
    "recoveryEffectClosedBeforeEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "closure"
      ],
      "properties": {
        "kind": {
          "const": "closed_before_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "closure": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect closed before effect V1"
    },
    "recoveryEffectAwaitingApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_approval"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting approval V1"
    },
    "recoveryEffectInFlightV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "in_flight"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect in flight V1"
    },
    "recoveryEffectAwaitingCallerReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_caller_report"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting caller report V1"
    },
    "recoveryEffectUnknownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect unknown V1"
    },
    "recoveryEffectCompleteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "effect_count"
      ],
      "properties": {
        "kind": {
          "const": "complete"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "effect_count": {
          "$ref": "#/$defs/safeInteger"
        }
      },
      "title": "Recovery effect complete V1"
    },
    "recoveryEffectPartialV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "partial"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect partial V1"
    },
    "recoveryEffectFailedAfterEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "failed_after_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect failed after effect V1"
    }
  }
}
