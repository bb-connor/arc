{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-provider-request.schema.json",
  "title": "Semantic Provider Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "kind",
    "provider",
    "account",
    "resource",
    "provider_version",
    "operation",
    "attempt",
    "payload"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "support_read",
        "issue_write",
        "field_projection"
      ]
    },
    "provider": {
      "$ref": "#/$defs/opaqueId"
    },
    "account": {
      "$ref": "#/$defs/opaqueId"
    },
    "resource": {
      "$ref": "#/$defs/opaqueId"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "operation": {
      "$ref": "#/$defs/opaqueId"
    },
    "attempt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "payload": {
      "$ref": "semantic-payload.schema.json"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    }
  }
}
