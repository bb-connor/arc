{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/scoped-endorsement.schema.json",
  "title": "Scoped Endorsement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "evidence",
    "scope",
    "target",
    "influence",
    "assertions",
    "destination",
    "purpose",
    "issued_at_unix_ms",
    "valid_until_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "evidence": {
      "$ref": "#/$defs/opaqueId"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "action"
          ],
          "properties": {
            "kind": {
              "const": "exact_action"
            },
            "action": {
              "$ref": "#/$defs/recoveryDigest32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact"
          ],
          "properties": {
            "kind": {
              "const": "persistent_artifact"
            },
            "artifact": {
              "$ref": "#/$defs/recoveryDigest32"
            }
          }
        }
      ]
    },
    "influence": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opaqueId"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "destination": {
      "$ref": "#/$defs/opaqueId"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-maxUtf8Bytes": 256
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "valid_until_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
