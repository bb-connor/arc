{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-wire/v1/recovery/provider-finality.schema.json",
  "title": "Recovery provider positive finality V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "workflow_id",
    "continuation_id",
    "operation_id",
    "attempt_id",
    "scope",
    "native_admission_digest",
    "provider",
    "account",
    "resource_digest",
    "contract_digest",
    "observed_at_unix_ms",
    "expires_at_unix_ms",
    "disposition",
    "applied_effects"
  ],
  "properties": {
    "schema": {
      "const": "chio.recovery.provider-finality.v1"
    },
    "version": {
      "const": 1
    },
    "workflow_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "continuation_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "operation_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "attempt_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "native_admission_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$",
      "x-maxUtf8Bytes": 256
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$",
      "x-maxUtf8Bytes": 256
    },
    "resource_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "contract_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "observed_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "expires_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "succeeded",
        "partially_applied",
        "failed_after_effect"
      ]
    },
    "applied_effects": {
      "const": 1
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
