{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-audience.schema.json",
  "title": "Semantic Audience V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "provider",
    "account",
    "resource",
    "audience",
    "subject_mapping",
    "query",
    "provider_version",
    "completeness",
    "pagination",
    "observed_at_unix_ms",
    "valid_until_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "provider": {
      "$ref": "#/$defs/opaqueId"
    },
    "account": {
      "$ref": "#/$defs/opaqueId"
    },
    "resource": {
      "$ref": "#/$defs/opaqueId"
    },
    "audience": {
      "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
    },
    "subject_mapping": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "query": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "ambiguous",
        "outage",
        "rate_limited"
      ]
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages_observed",
        "pages_expected",
        "cursor"
      ],
      "properties": {
        "pages_observed": {
          "$ref": "#/$defs/safeInteger"
        },
        "pages_expected": {
          "$ref": "#/$defs/safeInteger"
        },
        "cursor": {
          "type": "string",
          "enum": [
            "complete",
            "pending"
          ]
        }
      }
    },
    "observed_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "valid_until_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
