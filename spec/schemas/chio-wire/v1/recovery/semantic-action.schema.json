{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-action.schema.json",
  "title": "Semantic Action V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "registry",
    "generation",
    "operation",
    "destination",
    "request_id",
    "request_namespace",
    "capability",
    "request_semantics",
    "payload",
    "inputs",
    "source_label",
    "native_source",
    "influence",
    "externally_influenced",
    "plan",
    "step",
    "output",
    "issued_at_unix_ms",
    "valid_until_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "registry": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "generation": {
      "$ref": "#/$defs/safeInteger"
    },
    "operation": {
      "$ref": "#/$defs/opaqueId"
    },
    "destination": {
      "$ref": "#/$defs/opaqueId"
    },
    "request_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "request_namespace": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "capability": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "request_semantics": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "payload": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticInputVersion"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "source_label": {
      "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
    },
    "native_source": {
      "$ref": "#/$defs/semanticNativeSource"
    },
    "influence": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "externally_influenced": {
      "type": "boolean"
    },
    "plan": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "step": {
      "$ref": "#/$defs/opaqueId"
    },
    "output": {
      "type": "string",
      "enum": [
        "return_value",
        "withhold"
      ]
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "valid_until_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "semanticInputVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "version",
        "content"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/opaqueId"
        },
        "version": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "content": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    },
    "semanticNativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "generation",
        "principal_label",
        "lineage_label",
        "session_label"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "generation": {
          "$ref": "#/$defs/safeInteger"
        },
        "principal_label": {
          "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
        },
        "lineage_label": {
          "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
        },
        "session_label": {
          "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
        }
      }
    }
  }
}
