{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/recovery-setup-probe.schema.json",
  "title": "Recovery Setup Probe V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "probe_id",
    "native_authority",
    "deployment",
    "source_profile",
    "required_coverage",
    "benign_workflow",
    "denied_command",
    "issued_at_unix_ms",
    "expires_at_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "probe_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "native_authority": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "deployment": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "source_profile": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "required_coverage": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "benign_workflow": {
      "$ref": "#/$defs/opaqueId"
    },
    "denied_command": {
      "$ref": "#/$defs/opaqueId"
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "expires_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
