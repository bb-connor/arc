{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-annotation.schema.json",
  "title": "Semantic Annotation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "input",
    "restrictions",
    "externally_influenced",
    "facts",
    "confidence_basis_points",
    "issued_at_unix_ms",
    "valid_until_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "input": {
      "$ref": "#/$defs/semanticInputVersion"
    },
    "restrictions": {
      "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
    },
    "externally_influenced": {
      "type": "boolean"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opaqueId"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "confidence_basis_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "valid_until_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "semanticInputVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "version",
        "content"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/opaqueId"
        },
        "version": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "content": {
          "$ref": "#/$defs/recoveryDigest32"
        }
      }
    }
  }
}
