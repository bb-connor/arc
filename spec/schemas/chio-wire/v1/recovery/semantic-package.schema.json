{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-package.schema.json",
  "title": "Semantic Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "package",
    "dependencies",
    "operations"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "package": {
      "$ref": "#/$defs/opaqueId"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recoveryDigest32"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticOperation"
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "enabled"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "input",
            "success",
            "error",
            "no_value",
            "nested",
            "batch",
            "pagination",
            "redirect",
            "stream",
            "file",
            "log",
            "shell",
            "model"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "semanticOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "kind",
        "input_schema",
        "output_schema",
        "implementation",
        "channels",
        "input_fields",
        "selectors",
        "required_assertions",
        "prerequisites",
        "projection_fields",
        "source_label",
        "external_influence"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/opaqueId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "support_read",
            "issue_write",
            "field_projection"
          ]
        },
        "input_schema": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "output_schema": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "implementation": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticChannel"
          },
          "minItems": 1,
          "maxItems": 13
        },
        "input_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaqueId"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticSelector"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "required_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaqueId"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticPrerequisiteRequirement"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "projection_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaqueId"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "source_label": {
          "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
        },
        "external_influence": {
          "type": "boolean"
        },
        "withheld_status": {
          "$ref": "#/$defs/semanticWithheldStatus"
        }
      }
    },
    "semanticWithheldStatus": {
      "title": "Semantic Withheld Status V1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience"
      ],
      "properties": {
        "audience": {
          "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
        }
      }
    },
    "semanticPrerequisiteRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "kind",
        "resource"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/opaqueId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "historical_fact",
            "current_predicate",
            "held_reservation"
          ]
        },
        "resource": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "semanticSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "present"
            },
            "field": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "equals"
            },
            "field": {
              "$ref": "#/$defs/opaqueId"
            },
            "value": {
              "$ref": "#/$defs/semanticValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "field",
            "bytes"
          ],
          "properties": {
            "kind": {
              "const": "text_bytes_at_most"
            },
            "field": {
              "$ref": "#/$defs/opaqueId"
            },
            "bytes": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        }
      ]
    },
    "semanticValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "x-maxUtf8Bytes": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
