{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-prerequisite.schema.json",
  "title": "Semantic Prerequisite V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "evidence",
    "scope",
    "action",
    "fact",
    "kind",
    "resource",
    "version",
    "material",
    "producer",
    "lease",
    "purpose",
    "issued_at_unix_ms",
    "valid_until_unix_ms"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "evidence": {
      "$ref": "#/$defs/opaqueId"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "action": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "fact": {
      "$ref": "#/$defs/opaqueId"
    },
    "kind": {
      "type": "string",
      "enum": [
        "historical_fact",
        "current_predicate",
        "held_reservation"
      ]
    },
    "resource": {
      "$ref": "#/$defs/opaqueId"
    },
    "version": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "material": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "producer": {
      "$ref": "#/$defs/opaqueId"
    },
    "lease": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueId"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "x-maxUtf8Bytes": 256
    },
    "issued_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "valid_until_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    }
  }
}
