{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/semantic-plan.schema.json",
  "title": "Semantic Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_version",
    "scope",
    "registry",
    "steps"
  ],
  "properties": {
    "domain_version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "registry": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticPlanStep"
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": { "pattern": "[\\r\\n]" }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "semanticPlanInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "resource",
            "version",
            "material"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "resource": {
              "$ref": "#/$defs/opaqueId"
            },
            "version": {
              "$ref": "#/$defs/recoveryDigest32"
            },
            "material": {
              "$ref": "#/$defs/recoveryDigest32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "step"
          ],
          "properties": {
            "kind": {
              "const": "future_output"
            },
            "step": {
              "$ref": "#/$defs/opaqueId"
            }
          }
        }
      ]
    },
    "semanticPlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "operation",
        "destination",
        "dependencies",
        "inputs",
        "output"
      ],
      "properties": {
        "step": {
          "$ref": "#/$defs/opaqueId"
        },
        "operation": {
          "$ref": "#/$defs/opaqueId"
        },
        "destination": {
          "$ref": "#/$defs/opaqueId"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaqueId"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticPlanInput"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "output": {
          "type": "string",
          "enum": [
            "return_value",
            "withhold"
          ]
        }
      }
    }
  }
}
