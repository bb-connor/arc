{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.computer/schemas/chio-wire/v1/recovery/explanation-snapshot.schema.json",
  "title": "Recovery Explanation Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "scope",
    "deployment_digest",
    "policy_digest",
    "contract_digest",
    "intent_digest",
    "context_label",
    "influence",
    "observed_at_unix_ms",
    "expires_at_unix_ms",
    "effect",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "chio.recovery.explanation-snapshot.v1"
    },
    "version": {
      "const": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "deployment_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "policy_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "contract_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "intent_digest": {
      "$ref": "#/$defs/recoveryDigest32"
    },
    "context_label": {
      "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
    },
    "influence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "basis",
            "integrity"
          ],
          "properties": {
            "kind": {
              "const": "observed"
            },
            "basis": {
              "$ref": "#/$defs/recoveryDigest32"
            },
            "integrity": {
              "type": "string",
              "enum": [
                "native_owned",
                "operator_verified",
                "provider_verified",
                "unverified"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "observed_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "expires_at_unix_ms": {
      "$ref": "#/$defs/safeInteger"
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/recoveryEffectNeverAdmittedV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAdmissionUnresolvedV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectClosedBeforeEffectV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAwaitingApprovalV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectInFlightV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectAwaitingCallerReportV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectUnknownV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectCompleteV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectPartialV1"
        },
        {
          "$ref": "#/$defs/recoveryEffectFailedAfterEffectV1"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "object",
          "source",
          "fact",
          "target",
          "integrity",
          "label",
          "observed_at_unix_ms",
          "expires_at_unix_ms",
          "state"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/opaqueId"
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "object": {
            "$ref": "#/$defs/opaqueId"
          },
          "source": {
            "type": "string",
            "enum": [
              "native_authority",
              "process_journal",
              "operator_registry",
              "provider_acl"
            ]
          },
          "fact": {
            "type": "string",
            "enum": [
              "capability",
              "policy",
              "destination_acl",
              "authority_coverage",
              "transformation",
              "prerequisite"
            ]
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "intent"
                ],
                "properties": {
                  "kind": {
                    "const": "intent"
                  },
                  "intent": {
                    "$ref": "#/$defs/recoveryDigest32"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "destination"
                ],
                "properties": {
                  "kind": {
                    "const": "destination"
                  },
                  "destination": {
                    "$ref": "#/$defs/destinationId"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "scope"
                ],
                "properties": {
                  "kind": {
                    "const": "authority"
                  },
                  "scope": {
                    "$ref": "#/$defs/recoveryDigest32"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "template"
                ],
                "properties": {
                  "kind": {
                    "const": "template"
                  },
                  "template": {
                    "$ref": "#/$defs/opaqueId"
                  }
                }
              }
            ]
          },
          "integrity": {
            "type": "string",
            "enum": [
              "native_owned",
              "operator_verified",
              "provider_verified",
              "unverified"
            ]
          },
          "label": {
            "$ref": "https://chio.world/schemas/chio-wire/v1/security/information-label.schema.json"
          },
          "observed_at_unix_ms": {
            "$ref": "#/$defs/safeInteger"
          },
          "expires_at_unix_ms": {
            "$ref": "#/$defs/safeInteger"
          },
          "state": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "version",
                  "evidence",
                  "satisfied"
                ],
                "properties": {
                  "kind": {
                    "const": "known"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "evidence": {
                    "$ref": "#/$defs/opaqueId"
                  },
                  "satisfied": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "gap"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "unavailable",
                      "not_consulted",
                      "unsupported"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "evidence",
                  "satisfied"
                ],
                "properties": {
                  "kind": {
                    "const": "freshness_qualified"
                  },
                  "evidence": {
                    "$ref": "#/$defs/opaqueId"
                  },
                  "satisfied": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      },
      "maxItems": 32
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "recoveryDigest32": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "title": "Recovery digest octet"
      },
      "title": "Recovery digest32"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_domain",
        "tenant_id",
        "process_id"
      ],
      "properties": {
        "authority_domain": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "process_id": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "destinationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$",
      "x-maxUtf8Bytes": 256
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "native_admission_digest",
        "operation_version"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "native_admission_digest": {
          "$ref": "#/$defs/recoveryDigest32"
        },
        "operation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "refusalCode": {
      "type": "string",
      "enum": [
        "invalid_evidence",
        "unsupported_profile",
        "stale_basis",
        "revoked",
        "expired",
        "budget_unavailable",
        "unknown_effect",
        "audience_denied",
        "resource_exhausted"
      ]
    },
    "recoveryEffectNeverAdmittedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "never_admitted"
        }
      },
      "title": "Recovery effect never admitted V1"
    },
    "recoveryEffectAdmissionUnresolvedV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "admission_intent"
      ],
      "properties": {
        "kind": {
          "const": "admission_unresolved"
        },
        "admission_intent": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect admission unresolved V1"
    },
    "recoveryEffectClosedBeforeEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "closure"
      ],
      "properties": {
        "kind": {
          "const": "closed_before_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "closure": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "title": "Recovery effect closed before effect V1"
    },
    "recoveryEffectAwaitingApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_approval"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting approval V1"
    },
    "recoveryEffectInFlightV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "in_flight"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect in flight V1"
    },
    "recoveryEffectAwaitingCallerReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "awaiting_caller_report"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect awaiting caller report V1"
    },
    "recoveryEffectUnknownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        }
      },
      "title": "Recovery effect unknown V1"
    },
    "recoveryEffectCompleteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "effect_count"
      ],
      "properties": {
        "kind": {
          "const": "complete"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "effect_count": {
          "$ref": "#/$defs/safeInteger"
        }
      },
      "title": "Recovery effect complete V1"
    },
    "recoveryEffectPartialV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "partial"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect partial V1"
    },
    "recoveryEffectFailedAfterEffectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "applied_effects"
      ],
      "properties": {
        "kind": {
          "const": "failed_after_effect"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "applied_effects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "title": "Recovery effect failed after effect V1"
    }
  }
}
