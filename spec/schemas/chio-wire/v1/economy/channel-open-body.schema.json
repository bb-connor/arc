      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelId",
        "fundingAcknowledgementDigest",
        "initialStateDigest",
        "openIntentDigest",
        "openedAtUnixMs",
        "schema"
      ],
      "properties": {
        "channelId": {
          "type": "string"
        },
        "fundingAcknowledgementDigest": {
          "type": "string"
        },
        "initialStateDigest": {
          "type": "string"
        },
        "openIntentDigest": {
          "type": "string"
        },
        "openedAtUnixMs": {
          "type": "integer"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "keyEpoch": {
      "type": "integer"
    },
    "signerId": {
      "type": "string"
    },
    "signerKey": {
      "type": "string"
    }
  }
}
