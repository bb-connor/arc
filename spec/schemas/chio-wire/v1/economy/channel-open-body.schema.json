{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/economy/channel-open-body.schema.json",
  "title": "chio.channel.open.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "keyEpoch",
    "signerId",
    "signerKey"
  ],
  "properties": {
