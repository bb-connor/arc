{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/economy/channel-state-body.schema.json",
  "title": "chio.channel.state.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "keyEpoch",
    "signerId",
    "signerKey"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actualCharge",
        "assetBindingDigest",
        "channelId",
        "cumulativeOwed",
        "cumulativeTokenBaseUnits",
        "prevStateDigest",
        "receiptAuthorityDigest",
        "receiptCount",
        "receiptDigest",
        "receiptId",
        "receiptIdRoot",
        "reservationDigest",
        "schema",
        "seq"
      ],
      "properties": {
        "actualCharge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "units"
          ],
          "properties": {
            "currency": {
              "type": "string"
            },
            "units": {
              "type": "integer"
            }
          }
        },
        "assetBindingDigest": {
          "type": "string"
        },
        "channelId": {
          "type": "string"
        },
        "cumulativeOwed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "units"
          ],
          "properties": {
            "currency": {
              "type": "string"
            },
            "units": {
              "type": "integer"
            }
          }
        },
        "cumulativeTokenBaseUnits": {
          "type": "string"
        },
        "obligationAtomDigest": {
          "type": "string"
        },
        "prevStateDigest": {
          "type": "string"
        },
        "receiptAuthorityDigest": {
          "type": "string"
        },
        "receiptCount": {
          "type": "integer"
        },
        "receiptDigest": {
          "type": "string"
        },
        "receiptId": {
          "type": "string"
        },
        "receiptIdRoot": {
          "type": "string"
        },
        "reservationDigest": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        }
      }
    },
    "keyEpoch": {
      "type": "integer"
    },
    "signerId": {
      "type": "string"
    },
    "signerKey": {
      "type": "string"
    }
  }
}
