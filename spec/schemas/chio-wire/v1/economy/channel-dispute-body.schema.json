        "competingStateDigest": {
          "type": "string"
        },
        "competingStateSequence": {
          "type": "integer"
        },
        "disputeId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
