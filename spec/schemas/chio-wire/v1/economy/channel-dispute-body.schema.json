{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/economy/channel-dispute-body.schema.json",
  "title": "chio.channel.dispute.v1 signed body",
  "type": "object",
