    "creditorParticipantId": {
      "type": "string"
    },
    "debtorIdentity": {
      "type": "string"
    },
    "debtorParticipantId": {
      "type": "string"
    },
    "obligationId": {
      "type": "string"
    },
    "roundCoreDigest": {
      "type": "string"
    },
