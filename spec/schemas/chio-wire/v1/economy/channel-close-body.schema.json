{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/economy/channel-close-body.schema.json",
  "title": "chio.channel.close.v1 signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "keyEpoch",
    "signerId",
    "signerKey"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelId",
        "channelStateVersion",
        "closeKind",
        "closeSubmissionCutoffUnixSecs",
        "disputeDeadlineUnixMs",
        "disputeWindowSecs",
        "escrowReservationVersion",
        "expectedRefundAfterReleaseTokenBaseUnits",
        "expectedReleaseTokenBaseUnits",
        "finalCumulativeOwed",
        "finalStateDigest",
        "finalStateSequence",
        "lifecycleFence",
        "openDigest",
        "proposedAtUnixMs",
        "schema"
      ],
      "properties": {
        "channelId": {
          "type": "string"
        },
        "channelStateVersion": {
          "type": "integer"
        },
        "closeKind": {
          "type": "string"
        },
        "closeSubmissionCutoffUnixSecs": {
          "type": "integer"
        },
        "disputeDeadlineUnixMs": {
          "type": "integer"
        },
        "disputeWindowSecs": {
          "type": "integer"
        },
        "escrowReservationVersion": {
          "type": "integer"
        },
        "expectedRefundAfterReleaseTokenBaseUnits": {
          "type": "string"
        },
        "expectedReleaseTokenBaseUnits": {
          "type": "string"
        },
        "finalCumulativeOwed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "units"
          ],
          "properties": {
            "currency": {
              "type": "string"
            },
            "units": {
              "type": "integer"
            }
          }
        },
        "finalStateDigest": {
          "type": "string"
        },
        "finalStateSequence": {
          "type": "integer"
        },
        "lifecycleFence": {
          "type": "integer"
        },
        "openDigest": {
          "type": "string"
        },
        "proposedAtUnixMs": {
          "type": "integer"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "keyEpoch": {
      "type": "integer"
    },
    "signerId": {
      "type": "string"
    },
    "signerKey": {
      "type": "string"
    }
  }
}
