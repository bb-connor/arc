{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/economy/autonomous-pricing-authority-envelope.schema.json",
  "title": "Chio autonomous pricing authority envelope signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_chain_refs",
    "automation_mode",
    "currency",
    "delegated_authority_reference",
    "envelope_id",
    "issued_at",
    "kind",
    "max_coverage_amount",
    "max_daily_decisions",
    "max_premium_amount",
    "max_rate_change_bps",
    "not_after",
    "not_before",
    "note",
    "permitted_actions",
    "provider_id",
    "requires_human_review_above_premium",
    "requires_human_review_for_bind",
    "schema",
    "subject_key",
    "support_boundary"
  ],
  "properties": {
    "authority_chain_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "automation_mode": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "delegated_authority_reference": {
      "type": "string"
    },
    "envelope_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "max_coverage_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "units"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "units": {
          "type": "integer"
        }
      }
    },
    "max_daily_decisions": {
      "type": "integer"
    },
    "max_premium_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "units"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "units": {
          "type": "integer"
        }
      }
    },
    "max_rate_change_bps": {
      "type": "integer"
    },
    "not_after": {
      "type": "integer"
    },
    "not_before": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "permitted_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_id": {
      "type": "string"
    },
    "requires_human_review_above_premium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "units"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "units": {
          "type": "integer"
        }
      }
    },
    "requires_human_review_for_bind": {
      "type": "boolean"
    },
    "schema": {
      "const": "chio.autonomous-pricing-authority-envelope.v1"
    },
    "subject_key": {
      "type": "string"
    },
    "support_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegated_authority_required",
        "live_bind_supported",
        "operator_override_supported",
        "reserve_optimization_required"
      ],
      "properties": {
        "delegated_authority_required": {
          "type": "boolean"
        },
        "live_bind_supported": {
          "type": "boolean"
        },
        "operator_override_supported": {
          "type": "boolean"
        },
        "reserve_optimization_required": {
          "type": "boolean"
        }
      }
    }
  }
}
