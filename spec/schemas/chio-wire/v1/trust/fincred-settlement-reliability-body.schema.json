                            "leafIndex": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "auditPath": {
                              "type": "array",
                              "maxItems": 64,
                              "items": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "rangeRoot": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "indexRoot": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "lowerBoundary": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "source_edge"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "leafProof"
                        ],
                        "properties": {
                          "kind": {
                            "const": "adjacent"
                          },
                          "leafProof": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "leaf",
                              "indexProof"
                            ],
                            "properties": {
                              "leaf": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "index",
                                  "queryKey",
                                  "sourceArtifactDigest"
                                ],
                                "properties": {
                                  "index": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "queryKey": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "sourceFamily",
                                      "subject",
                                      "occurredAt",
                                      "artifactId"
                                    ],
                                    "properties": {
                                      "sourceFamily": {
                                        "enum": [
                                          "credit_scorecard",
                                          "exposure_history",
                                          "settlement_reliability",
                                          "premium_history",
                                          "loss_history"
                                        ]
                                      },
                                      "subject": {
                                        "type": "string",
                                        "pattern": "^did:chio:[0-9a-f]{64}$"
                                      },
                                      "occurredAt": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      "artifactId": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 512
                                      }
                                    }
                                  },
                                  "sourceArtifactDigest": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$"
                                  }
                                }
                              },
                              "indexProof": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "treeSize",
                                  "leafIndex",
                                  "auditPath"
                                ],
                                "properties": {
                                  "treeSize": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  },
                                  "leafIndex": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "auditPath": {
                                    "type": "array",
                                    "maxItems": 64,
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{64}$"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "upperBoundary": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "source_edge"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "leafProof"
                        ],
                        "properties": {
                          "kind": {
                            "const": "adjacent"
                          },
                          "leafProof": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "leaf",
                              "indexProof"
                            ],
                            "properties": {
                              "leaf": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "index",
                                  "queryKey",
                                  "sourceArtifactDigest"
                                ],
                                "properties": {
                                  "index": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "queryKey": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "sourceFamily",
                                      "subject",
                                      "occurredAt",
                                      "artifactId"
                                    ],
                                    "properties": {
                                      "sourceFamily": {
                                        "enum": [
                                          "credit_scorecard",
                                          "exposure_history",
                                          "settlement_reliability",
                                          "premium_history",
                                          "loss_history"
                                        ]
                                      },
                                      "subject": {
                                        "type": "string",
                                        "pattern": "^did:chio:[0-9a-f]{64}$"
                                      },
                                      "occurredAt": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      "artifactId": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 512
                                      }
                                    }
                                  },
                                  "sourceArtifactDigest": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{64}$"
                                  }
                                }
                              },
                              "indexProof": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "treeSize",
                                  "leafIndex",
                                  "auditPath"
                                ],
                                "properties": {
                                  "treeSize": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  },
                                  "leafIndex": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "auditPath": {
                                    "type": "array",
                                    "maxItems": 64,
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[0-9a-f]{64}$"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "sourceArtifactDigests": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "disclosureDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "attestationReference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "issuedAt": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "expiresAt": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sourceEvidenceClass": {
                    "enum": [
                      "asserted",
                      "observed",
                      "verified"
                    ]
                  }
                }
              },
              "signerKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          }
        },
        "sourceDisclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifacts",
            "kind"
          ],
          "properties": {
            "artifacts": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "artifactSchema",
                  "artifactDigest",
                  "canonicalArtifact"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "claim",
                      "member"
                    ]
                  },
                  "artifactSchema": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "artifactDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "canonicalArtifact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 524288
                  }
                }
              }
            },
            "kind": {
              "type": "string"
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endsAt",
            "startsAt"
          ],
          "properties": {
            "endsAt": {
              "type": "integer"
            },
            "startsAt": {
              "type": "integer"
            }
          }
        }
      }
    },
    "expirationDate": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "issuanceDate": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "issuerKeyEpoch": {
      "type": "integer"
    },
    "presentationEvidenceClass": {
      "type": "string"
    },
    "schema": {
      "const": "chio.fincred.settlement-reliability.v1"
    },
    "sourceEvidenceClass": {
      "type": "string"
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
