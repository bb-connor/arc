{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/runtime/wasm-module.schema.json",
  "title": "Chio wasm module signed body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_hash",
    "module_name",
    "signer_public_key",
    "version"
  ],
  "properties": {
    "module_hash": {
      "type": "string"
    },
    "module_name": {
      "type": "string"
    },
    "signer_public_key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}
