{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/commerce/commerce-provider-passport-body.schema.json",
  "title": "chio.commerce.provider-passport.v1 signed body",
