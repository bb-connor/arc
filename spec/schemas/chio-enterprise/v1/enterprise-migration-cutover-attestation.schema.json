{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-enterprise/v1/enterprise-migration-cutover-attestation.schema.json",
  "title": "Chio signed enterprise migration operator cutover attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "operator_key_id", "operator_algorithm", "operator_signature"],
  "properties": {
    "body": { "$ref": "enterprise-migration-cutover-attestation-body.schema.json" },
    "operator_key_id": { "$ref": "#/$defs/hash" },
    "operator_algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "operator_signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
