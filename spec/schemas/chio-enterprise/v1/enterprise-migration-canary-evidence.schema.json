{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-enterprise/v1/enterprise-migration-canary-evidence.schema.json",
  "title": "Chio signed enterprise migration designated-runner canary evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signer_key_id", "signer", "algorithm", "signature"],
  "properties": {
    "body": { "$ref": "enterprise-migration-canary-evidence-body.schema.json" },
    "signer_key_id": { "$ref": "#/$defs/hash" },
    "signer": { "$ref": "#/$defs/publicKey" },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$" },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$" }
  }
}
