{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-computer/v1/compiled-description.schema.json",
  "title": "CompiledDescription",
  "description": "Untrusted program description. Independent bounded recompilation and exact equality are required; validation grants no execution authority.",
  "x-chio-max-bytes": 8388608,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "computerId",
    "ownerDomain",
    "revisionId",
    "lifecycleGeneration",
    "programDigest",
    "expression",
    "occurrences",
    "outputSchema",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "chio.computer.compiled-description.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "computerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "ownerDomain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "lifecycleGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "programDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "expression": {
      "$ref": "description.schema.json#/$defs/ProgramExpr"
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrenceId",
          "path",
          "parents",
          "leaf"
        ],
        "properties": {
          "occurrenceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2046
            },
            "minItems": 0,
            "maxItems": 32
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "leaf": {
            "$ref": "description.schema.json#/$defs/LeafDescriptor"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "outputSchema": {
      "$ref": "description.schema.json#/$defs/SchemaShape"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
