# Chio trust-control service: the shared receipt store, capability authority
# and joint admission authority the remote MCP edge depends on.
#
# Callers authenticate against the access configuration, which holds only
# SHA-256 digests of their secrets. It arrives as a credential file the
# manager reads as root and exposes to this service alone; nothing is
# configured through the environment.
# Readiness is the /health route answering, so dependants wait for a service
# that serves.

[Unit]
Description=Chio trust-control service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=chio-trust
Group=chio-trust
StateDirectory=chio-trust-control
StateDirectoryMode=0700
RuntimeDirectory=chio-trust-control
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/chio-trust-control
LoadCredential=trust-access-config:/etc/chio/credentials/trust-access.toml
# Refuse to start on a damaged store rather than rebuild silently.
ExecStartPre=/usr/local/bin/chio \
  --receipt-db /var/lib/chio-trust-control/receipts.sqlite3 \
  --authority-db /var/lib/chio-trust-control/authority.sqlite3 \
  --session-db /var/lib/chio-trust-control/sessions.sqlite3 \
  security preflight
ExecStart=/usr/local/bin/chio security supervise \
  --ready-http http://127.0.0.1:8940/health \
  --ready-timeout 60 \
  --stop-grace 30 \
  -- /usr/local/bin/chio \
  --receipt-db /var/lib/chio-trust-control/receipts.sqlite3 \
  --authority-db /var/lib/chio-trust-control/authority.sqlite3 \
  --session-db /var/lib/chio-trust-control/sessions.sqlite3 \
  trust serve \
  --listen 127.0.0.1:8940 \
  --access-config %d/trust-access-config
Restart=on-failure
RestartSec=5s
# SIGTERM starts the bounded drain (25s); the supervisor forwards it and
# grants --stop-grace before SIGKILL, and the manager escalates only after
# TimeoutStopSec. Keep the platform grace period at least this high.
KillSignal=SIGTERM
TimeoutStopSec=35s
TimeoutStartSec=90s
MemoryHigh=512M
MemoryMax=768M
LimitNOFILE=65536
LimitCORE=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/chio
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
# This filter blocks openat2, including read-only resolution. Retain the
# unprivileged UID, empty capabilities and NoNewPrivileges instead.
RestrictSUIDSGID=false
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
