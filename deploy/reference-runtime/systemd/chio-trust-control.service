# Chio trust-control service: the shared receipt store, capability authority
# and joint admission authority the remote MCP edge depends on.
#
# Secrets arrive as credential files the manager reads as root and exposes to
# this service alone; nothing else is configured through the environment.
# Readiness is the /health route answering, so dependants wait for a service
# that serves.

[Unit]
Description=Chio trust-control service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=chio-trust
Group=chio-trust
StateDirectory=chio-trust-control
StateDirectoryMode=0700
RuntimeDirectory=chio-trust-control
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/chio-trust-control
# The administrative service bearer and the workload bearer stay distinct:
# the workload credential can read authority status and request issuance
# but cannot use the administrative trust-control routes.
LoadCredential=trust-service-token:/etc/chio/credentials/trust-service-token
LoadCredential=trust-authority-workload-token:/etc/chio/credentials/trust-authority-workload-token
# Refuse to start on a damaged store rather than rebuild silently.
ExecStartPre=/usr/local/bin/chio \
  --receipt-db /var/lib/chio-trust-control/receipts.sqlite3 \
  --authority-db /var/lib/chio-trust-control/authority.sqlite3 \
  --session-db /var/lib/chio-trust-control/sessions.sqlite3 \
  security preflight
ExecStart=/usr/local/bin/chio security supervise \
  --credential-env CHIO_TRUST_SERVICE_TOKEN=trust-service-token \
  --credential-env CHIO_TRUST_AUTHORITY_WORKLOAD_TOKEN=trust-authority-workload-token \
  --ready-http http://127.0.0.1:8940/health \
  --ready-timeout 60 \
  --stop-grace 30 \
  -- /usr/local/bin/chio \
  --receipt-db /var/lib/chio-trust-control/receipts.sqlite3 \
  --authority-db /var/lib/chio-trust-control/authority.sqlite3 \
  --session-db /var/lib/chio-trust-control/sessions.sqlite3 \
  trust serve \
  --listen 127.0.0.1:8940
Restart=on-failure
RestartSec=5s
# SIGTERM starts the bounded drain (25s); the supervisor forwards it and
# grants --stop-grace before SIGKILL, and the manager escalates only after
# TimeoutStopSec. Keep the platform grace period at least this high.
KillSignal=SIGTERM
TimeoutStopSec=35s
TimeoutStartSec=90s
MemoryHigh=512M
MemoryMax=768M
LimitNOFILE=65536
LimitCORE=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/chio
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
