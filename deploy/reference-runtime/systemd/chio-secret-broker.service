# Broker state and signing roles are provisioned separately. Starting this
# unit does not issue capabilities or promote an enterprise migration stage.
[Unit]
Description=Chio secret broker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=chio-broker
Group=chio-broker
StateDirectory=chio-secret-broker
StateDirectoryMode=0700
RuntimeDirectory=chio-secret-broker
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/chio-secret-broker
LoadCredential=master-key:/etc/chio/credentials/broker-master-key
LoadCredential=signing-key:/etc/chio/credentials/broker-signing-key
ExecStart=/usr/local/bin/chio security supervise \
  --credential-fd master-key-fd=master-key \
  --credential-fd signing-key-fd=signing-key \
  --ready-unix-socket /run/chio-secret-broker/broker.sock \
  --ready-timeout 60 \
  --stop-grace 60 \
  -- /usr/local/bin/chio-secret-brokerd \
  --config /etc/chio/secret-broker/broker.json
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=65s
TimeoutStartSec=90s
MemoryHigh=512M
MemoryMax=768M
LimitNOFILE=4096
LimitCORE=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/chio
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
# Keep descriptor-bound openat2 resolution available. The service remains
# unprivileged with NoNewPrivileges and an empty capability set.
RestrictSUIDSGID=false
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
