# Public pins and paths for chio-mcp-edge.service. No secret belongs here:
# the four bearer roles and the resume keyring arrive through LoadCredential=
# from /etc/chio/credentials. Install as /etc/chio/mcp-edge/chio-mcp-edge.env
# (mode 0640, root:chio-edge).

# Independently registered publisher key that signed the manifest
# (/etc/chio/mcp-edge/launch/manifest-public-key after provisioning).
CHIO_MANIFEST_PUBLIC_KEY=replace-with-the-manifest-public-key

# Pinned signer of the native-launch policy
# (/etc/chio/mcp-edge/launch/cage-policy-signer after provisioning).
CHIO_CAGE_POLICY_SIGNER=replace-with-the-cage-policy-signer

# Current capability-authority key of the trust-control service, pinned out
# of band: GET http://127.0.0.1:8940/v1/authority with the trust service
# bearer answers with publicKey.
CHIO_CONTROL_AUTHORITY_PUBLIC_KEY=replace-with-the-control-authority-public-key

# Server identity the signed manifest and the launch policy belong to; the
# provisioner was run with the same three values.
CHIO_MCP_SERVER_ID=chio-mcp-edge
CHIO_MCP_SERVER_NAME=Chio MCP edge
CHIO_MCP_SERVER_VERSION=1

# The wrapped MCP server exactly as provisioned (compare
# /etc/chio/mcp-edge/launch/target-command). The manager word-splits this
# value into the command after `--`; the policy binds the executable digest,
# every argument and the working directory, so any drift fails the preflight.
CHIO_MCP_UPSTREAM_COMMAND=/usr/local/libexec/chio/mcp-upstream
