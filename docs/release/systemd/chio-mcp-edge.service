[Unit]
Description=Chio remote MCP edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chio-edge
Group=chio-edge
RuntimeDirectory=chio-mcp-edge
StateDirectory=chio-mcp-edge
ConfigurationDirectory=chio
UMask=0077
# Provide CHIO_AUTH_TOKEN, CHIO_ADMIN_TOKEN, CHIO_CONTROL_TOKEN,
# CHIO_CONTROL_AUTHORITY_PUBLIC_KEY, optional historical
# CHIO_CONTROL_AUTHORITY_TRUSTED_PUBLIC_KEYS, CHIO_MANIFEST_PUBLIC_KEY, and
# CHIO_CAGE_POLICY_SIGNER in this file, mode 0600. The local authority seed must
# select the same current signer as CHIO_CONTROL_AUTHORITY_PUBLIC_KEY. The CLI
# requires all three bearer tokens and rejects missing or reused credentials.
EnvironmentFile=/etc/chio/chio-mcp-edge.env
Environment=CHIO_CONTROL_TLS_ROOT_CA_FILE=/etc/chio/control-root-ca.pem
# All identity, version, manifest, policy, and command values must match the
# reviewed signed cage policy exactly.
ExecStart=/usr/local/bin/chio \
  --authority-seed-file /etc/chio/mcp-edge-authority.seed \
  --control-url https://trust-control.example.com \
  mcp serve-http \
  --policy /etc/chio/mcp-edge-policy.yaml \
  --server-id chio-mcp-edge \
  --server-name "Chio MCP Edge" \
  --server-version 1.0.0 \
  --signed-manifest /etc/chio/mcp-edge-signed-manifest.json \
  --manifest-public-key ${CHIO_MANIFEST_PUBLIC_KEY} \
  --cage-policy /etc/chio/mcp-edge-cage-policy.json \
  --cage-policy-signer ${CHIO_CAGE_POLICY_SIGNER} \
  --listen 127.0.0.1:8931 \
  --session-db /var/lib/chio-mcp-edge/edge-sessions.sqlite3 \
  -- \
  /usr/local/bin/chio-mcp-upstream
Restart=on-failure
RestartSec=5s
# Deliver SIGTERM first (systemd's default, made explicit) so the graceful drain
# runs, and hold the kill escalation until after the bounded drain plus the
# receipt-flush margin can finish. The drain deadline is 25s; the platform grace
# period must be at least TimeoutStopSec.
KillSignal=SIGTERM
# Signal only the edge (the unit's main process) on stop, not the whole control
# group. The upstream tool server after `--` lives in the same cgroup; with the
# default control-group kill mode systemd would SIGTERM it at the same instant the
# edge begins its drain, tearing down the upstream out from under in-flight MCP
# calls. `mixed` sends the stop signal to the main process first and only
# escalates to the rest of the group (SIGKILL) after TimeoutStopSec, so the edge
# can drain against a live upstream.
KillMode=mixed
TimeoutStopSec=35s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chio-mcp-edge
# Memory and OOM directives (MemoryMax, MemoryHigh, OOMScoreAdjust, LimitNOFILE,
# LimitAS) are the per-process RSS ceiling owned by the bounded-memory work; set
# them here from that single source of truth so this unit and the trust-control
# unit share one OOM posture.

[Install]
WantedBy=multi-user.target
