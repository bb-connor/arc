4ba0157d9c77ce1258f19e2a6bb0e69074828', 'tables': ['security_declassification_tombstones'], 'sql': 'SELECT COUNT(*) FROM security_declassification_tombstones'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': '26ad3854e58cd6bc1f4299d165ee8ab4fd703e3ab47e6a21307152c13d3928b2', 'tables': ['security_response_dispatch_recoveries'], 'sql': 'SELECT recovery_id, tenant_id, dispatch_id, action_id, request_hash, outcome, lease_owner_id, lease_expires_at, fencing_token FROM security_response_dispatch_recoveries LIMIT 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': '2b16d6997e7c54f183a958a413f1f6f955c139e46585659bb1b7bcfeae5ddfd2', 'tables': ['security_response_plans'], 'sql': 'UPDATE security_response_plans SET generation = generation WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': '48898599af35c1e51cf9ebc54dd5779dc29ad150e8c213ee7069e4c6cb7287a6', 'tables': ['security_response_dispatch_fences'], 'sql': 'UPDATE security_response_dispatch_fences SET fenced_at = fenced_at WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': '6aaebce69c275c5f7d0b9c2547c6d74adeb9a822fe85d4f218bf3d83ccdb9b1c', 'tables': ['security_scheduler_leases'], 'sql': 'UPDATE security_scheduler_leases SET fencing_token = fencing_token WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': '79144c57bcfa7f3bfc89976fa0ba4b6edc000d4baee6b3c982fd3f9f61939b58', 'tables': ['security_response_dispatch_recoveries'], 'sql': 'UPDATE security_response_dispatch_recoveries SET fencing_token = fencing_token WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': 'a6cdf46f88bd98c464adcd386985241d4515fa147c2ddb4c891895c43cbe9ce0', 'tables': ['security_response_dispatches'], 'sql': 'UPDATE security_response_dispatches SET initial_fencing_token = initial_fencing_token WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': 'a8c138e2e7e8bbecbfec1e9bf53d560cea9d49468f43214802bdc1bb66a1b3ac', 'tables': ['security_response_dispatch_fences'], 'sql': 'SELECT dispatch_id, tenant_id, action_id, prepared_binding_body, prepared_binding_hash, fenced_at FROM security_response_dispatch_fences LIMIT 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': 'd3f9cb1f61dbceb7cc453e8ac2fb190efc50de46db9e64e649c2456fc9ce094f', 'tables': ['security_response_receipt_cursors'], 'sql': 'SELECT tenant_id, action_id, plan_hash, generation, current_evidence_id FROM security_response_receipt_cursors LIMIT 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'ensure_dispatch_ready', 'sha256': 'd45879dbdc942e7044d718a63952c145c3f2c005cbdbb0821d844e03e41949e2', 'tables': ['security_response_receipt_cursors'], 'sql': 'UPDATE security_response_receipt_cursors SET generation = generation WHERE 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/dispatch.rs', 'owner': 'validate_all_automatic_response_dispatch_fences', 'sha256': '8eb1509b3bee471b9235ad79ac153823a9139e4b221a98814b0f1b8cc299b91b', 'tables': ['security_response_dispatch_fences'], 'sql': 'SELECT tenant_id, action_id, dispatch_id FROM security_response_dispatch_fences ORDER BY tenant_id ASC, action_id ASC, dispatch_id ASC'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/egress_restriction.rs', 'owner': 'ensure_egress_restrictions_ready', 'sha256': '5643b4354d37de329d32438b5d983dbf5eae24611b9f5cda946895377dac18b1', 'tables': ['security_egress_restriction_state'], 'sql': 'SELECT tenant_id, se