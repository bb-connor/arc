EEN 1 AND 512 THEN security_authority_id END, sequence FROM security_participant_nonce_preflight_events WHERE operation_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/nonce_preflight/write.rs', 'owner': 'footprint', 'sha256': 'f69acb167b32f91687c2b932e2892b7d0bba77c14b611b0e3e5466e51a0736b2', 'tables': ['security_participant_egress_events', 'security_participant_nonce_preflight_events', 'security_participant_output_events', 'security_participant_state_mutations'], 'sql': 'SELECT (SELECT COUNT(*) FROM security_participant_state_initializations), (SELECT COUNT(*) FROM security_participant_state_mutations), (SELECT COUNT(*) FROM security_participant_egress_events), (SELECT COUNT(*) FROM security_participant_output_events), (SELECT COUNT(*) FROM security_participant_nonce_preflight_events), (SELECT COUNT(*) FROM authority_global_commits)'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/integrity.rs', 'owner': 'verify_coverage', 'sha256': 'ba7d00f887f89a8ef6ba733752245f4eb31b5ad2260e41020c199573dde1f124', 'tables': ['security_participant_output_events'], 'sql': 'SELECT EXISTS(SELECT 1 FROM security_participant_output_events AS event WHERE NOT EXISTS(SELECT 1 FROM security_participant_state_initializations AS initialization WHERE initialization.security_authority_id = event.security_authority_id))'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/integrity.rs', 'owner': 'verify_coverage', 'sha256': 'f5952321b74628188d15e4fbf27c9ec632d15eda4e9f13423e113f634176683f', 'tables': ['security_participant_output_events'], 'sql': 'SELECT COUNT(*) FROM security_participant_output_events'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/record.rs', 'owner': 'head', 'sha256': 'abe9abc3d9eb907cf2a6e60f42970568c37c15174682dc841ad5d8c329a5275e', 'tables': ['security_participant_output_events'], 'sql': 'SELECT COUNT(*), COALESCE(MIN(sequence),0), COALESCE(MAX(sequence),0), COALESCE(SUM(length(canonical_record)),0) FROM security_participant_output_events WHERE security_authority_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/record.rs', 'owner': 'load_inner', 'sha256': 'e44bc844514cf9733112cae3816ab77c96087e8cc37c0bef246508571e84ee00', 'tables': ['security_participant_output_events'], 'sql': "SELECT CASE WHEN typeof(canonical_record) = 'blob' AND length(canonical_record) BETWEEN 1 AND 16777216 THEN canonical_record END FROM security_participant_output_events WHERE security_authority_id = ?1 AND sequence = ?2"}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/record.rs', 'owner': 'load_operation', 'sha256': '6276b9d3c6c455c88a4eb19a8e0cfc1eb7480eb2ae61fd2bb918014e70d4ad33', 'tables': ['security_participant_output_events'], 'sql': 'SELECT CASE WHEN length(CAST(security_authority_id AS BLOB)) BETWEEN 1 AND 512 THEN security_authority_id END, sequence FROM security_participant_output_events WHERE operation_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/admission_operation_store/security_participant_state/output/write.rs', 'owner': 'footprint', 'sha256': 'cca5c9a57429bff845c5c072251efa1c986befec694c91cd40edfeefb961a0a7', 'tables': ['security_participant_egress_events', 'security_participant_output_events', 'security_participant_state_mutations'], 'sql': 'SELECT (SELECT COUNT(*) FROM security_participant_state_initializations), (SELECT COUNT(*) FROM security_participant_state_mutations), (SELECT COUNT(*) FROM security_participant_egress_events), (SELECT COUNT(*) FROM security_participant_output_events), (SELECT COUNT(*) FROM authority_global_commits)'}, {'path': 'crates/platform/chio-store-sqlite/src/encrypted_blob.rs', 'owner': 'exact_reference_mutation', 'sha256': 'd0333d7e930cd7993c4f24a53fffdd721844c7acbcbccf6292fc4543250387dd', 'tables': ['chio_encrypted_blob_reference_mutations'], 'sql': 'SELECT mutation_digest, mutation_kind, namespace, tenant_id, reference_key, result_blob_id FROM chio_encrypted_blob_reference_mutations WHERE operation_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_operator_bundle_store.rs', 'owner': 'seller_finding_artifact_bytes', 'sha256': '64e55e154454505e99995c78dfdcdf2d39b235be8500e5c78c2f569a4348a0de', 'tables': ['chio_finding_payloads'], 'sql': 'SELECT length(ciphertext) FROM chio_finding_payloads WHERE finding_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'claim', 'sha256': '0d7c7913affb2b412e7b89483bdce5a1d6d962d27cb239b3e62b8086635ce533', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET claimed_at_unix_ms = ?2, durable_admission_operation_id = ?3 WHERE purchase_id = ?1 AND state = 'reserved' AND claimed_at_unix_ms IS NULL AND durable_admission_operation_id IS NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'claim', 'sha256': '602760df1cac324cf81bc30fecb2cad681a0203df3f41cfead81f25002ec7174', 'tables': ['finding_pool_debits'], 'sql': 'SELECT allocation_envelope_sha256, tenant_id, finding_id, listing_id, reservation_id, authoritative_payment_operation_id, accepted_bid_envelope_sha256, venue_admission_envelope_sha256, amount_units, currency, state, claim_deadline_unix_ms, claimed_at_unix_ms, durable_admission_operation_id FROM finding_pool_debits WHERE purchase_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'contains_purchase', 'sha256': 'a158a19bec9eb6ad0b67d801f1505401f059e538c7685da6e9d3f4cd27890a03', 'tables': ['finding_pool_debits'], 'sql': 'SELECT 1 FROM finding_pool_debits WHERE purchase_id = ?1 LIMIT 1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'debit', 'sha256': 'fdb08c0d741da8a42bfcbb6441b1beafecf92d2fdfa50c15d6ce722800696bb6', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.allocation_envelope_sha256, a.allocation_id, d.debit_request_binding_sha256, d.tenant_id, d.finding_id, d.listing_id, d.reservation_id, d.authoritative_payment_operation_id, d.accepted_bid_envelope_sha256, d.venue_admission_envelope_sha256, d.amount_units, d.currency, d.state, d.reserved_after_units, d.spent_after_units, a.signed_amount_units FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.purchase_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'finalize_claimed_after_unknown_dispatch_by_operation', 'sha256': '71d2516740343f488a86ea5c63c812ea07415ea4d4102df0fe7bf5c6a84b98f9', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET state = 'finalized', reserved_after_units = ?2, spent_after_units = ?3 WHERE purchase_id = ?1 AND state = 'reserved' AND durable_admission_operation_id = ?4"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'finalize_claimed_after_unknown_dispatch_by_operation', 'sha256': '85fc663e02eb0879b6611e2d18ca03a60e79fa101265ebcb7b32d291c5cd91ca', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.purchase_id, d.allocation_envelope_sha256, d.state, d.amount_units, d.reserved_after_units, d.spent_after_units, a.signed_amount_units, a.reserved_units, a.spent_units, d.claimed_at_unix_ms FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.durable_admission_operation_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'list_claimed_admission_operations', 'sha256': 'cca61243ea292d36ec3e5a58ad2cd3c69a7725aee7eab379404bc9d40d41c03d', 'tables': ['finding_pool_debits'], 'sql': "SELECT durable_admission_operation_id FROM finding_pool_debits WHERE state = 'reserved' AND claimed_at_unix_ms IS NOT NULL AND durable_admission_operation_id IS NOT NULL AND (?1 IS NULL OR durable_admission_operation_id > ?1) ORDER BY durable_admission_operation_id ASC LIMIT ?2"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'mutation_for_purchase', 'sha256': '3bda3bacc8aaa713356ed4f65ef78303ece90777ed3002dbccf218a5132bca5c', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.purchase_id, d.tenant_id, a.allocation_id, d.allocation_envelope_sha256, d.amount_units, d.currency, d.state, a.reserved_units, a.spent_units, a.signed_amount_units, d.durable_admission_operation_id FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.purchase_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'reclaim_expired_unclaimed', 'sha256': 'c77fa34fe96be2620d07941471332b026a510cf402fc48bd92d56045b55ae75b', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET state = 'released', reserved_after_units = ?2, spent_after_units = ?3 WHERE purchase_id = ?1 AND state = 'reserved' AND claimed_at_unix_ms IS NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'release_claimed_before_dispatch', 'sha256': '85fc663e02eb0879b6611e2d18ca03a60e79fa101265ebcb7b32d291c5cd91ca', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.purchase_id, d.allocation_envelope_sha256, d.state, d.amount_units, d.reserved_after_units, d.spent_after_units, a.signed_amount_units, a.reserved_units, a.spent_units, d.claimed_at_unix_ms FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.durable_admission_operation_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'release_claimed_before_dispatch', 'sha256': '9d795c2f0aa7868fd290f87d42ce2aaf67cf0a6519e3b88cfa2730f6afc1c4d7', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET state = 'released', reserved_after_units = ?2, spent_after_units = ?3 WHERE purchase_id = ?1 AND state = 'reserved' AND durable_admission_operation_id = ?4"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'replay_debit', 'sha256': '7b15632ecd157ed2a6919b68e37f1334e59717679a7ed4d731256017bc39b7ca', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.allocation_envelope_sha256, a.allocation_id, d.debit_request_binding_sha256, d.tenant_id, d.amount_units, d.currency, d.state, d.reserved_after_units, d.spent_after_units, a.signed_amount_units FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.purchase_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'settle', 'sha256': '2c23525c5c11c4c9c08bd1e32704f663f347452a5a242603d0507d8f2c00991f', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET state = ?2, reserved_after_units = ?3, spent_after_units = ?4 WHERE purchase_id = ?1 AND state = 'reserved' AND claimed_at_unix_ms IS NOT NULL AND durable_admission_operation_id = ?5"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger.rs', 'owner': 'settle', 'sha256': '5bba548dc8cea86d4ad18d85f323d0f5242fbce472d28e004ac3fd95750e8ee8', 'tables': ['finding_pool_debits'], 'sql': 'SELECT d.allocation_envelope_sha256, a.allocation_id, d.finding_id, d.listing_id, d.reservation_id, d.authoritative_payment_operation_id, d.amount_units, d.currency, d.state, d.reserved_after_units, d.spent_after_units, a.signed_amount_units, a.reserved_units, a.spent_units, d.claimed_at_unix_ms, d.durable_admission_operation_id FROM finding_pool_debits d JOIN finding_pool_allocations a ON a.allocation_envelope_sha256 = d.allocation_envelope_sha256 WHERE d.purchase_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger/expiration.rs', 'owner': 'expired_unclaimed_reservations', 'sha256': '21fdc6d8f98bc14a885f16e3027f578122d6df08241c4e2cf2c0740a07ac7ff0', 'tables': ['finding_pool_debits'], 'sql': "SELECT purchase_id, amount_units, claim_deadline_unix_ms FROM finding_pool_debits WHERE allocation_envelope_sha256 = ?1 AND state = 'reserved' AND claimed_at_unix_ms IS NULL AND claim_deadline_unix_ms <> '' AND claim_deadline_unix_ms NOT GLOB '*[^0-9]*' AND (length(claim_deadline_unix_ms) < length(?2) OR (length(claim_deadline_unix_ms) = length(?2) AND claim_deadline_unix_ms <= ?2)) AND (?3 = '' OR purchase_id <> ?3) ORDER BY length(claim_deadline_unix_ms), claim_deadline_unix_ms, purchase_id LIMIT ?4"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger/expiration.rs', 'owner': 'expired_unclaimed_reservations', 'sha256': '292881516dfa3d97318024cc1b57c6dbf05ea0cbb5d38c29dba6cf16608eedb9', 'tables': ['finding_pool_debits'], 'sql': "SELECT purchase_id, amount_units, claim_deadline_unix_ms FROM finding_pool_debits WHERE purchase_id = ?1 AND allocation_envelope_sha256 = ?2 AND state = 'reserved' AND claimed_at_unix_ms IS NULL AND claim_deadline_unix_ms <> '' AND claim_deadline_unix_ms NOT GLOB '*[^0-9]*' AND (length(claim_deadline_unix_ms) < length(?3) OR (length(claim_deadline_unix_ms) = length(?3) AND claim_deadline_unix_ms <= ?3))"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger/qualification.rs', 'owner': 'bind_rollback_anchor', 'sha256': '7c8b3c89a5f6add9ae28220ea020b27360328804bcd9b5e6fa751a0f599a0ef8', 'tables': ['finding_pool_debits'], 'sql': 'SELECT EXISTS(SELECT 1 FROM finding_pool_allocations LIMIT 1) OR EXISTS(SELECT 1 FROM finding_pool_debits LIMIT 1) OR EXISTS(SELECT 1 FROM finding_pool_receipt_outbox LIMIT 1)'}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger/schema.rs', 'owner': 'ensure_lifecycle_columns', 'sha256': '0746bb760db082a9e540fed8394704caefdef992cf307274caff737e07ac6f5f', 'tables': ['finding_pool_debits'], 'sql': "UPDATE finding_pool_debits SET claimed_at_unix_ms = '0' WHERE state = 'reserved' AND claim_deadline_unix_ms = '0' AND claimed_at_unix_ms IS NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/finding_pool_ledger/schema.rs', 'owner': 'ensure_lifecycle_columns', 'sha256': 'acc0edc3f39597da5ddeb764217cf910684cfbc2f34a085b8b0a3fd3e7793a07', 'tables': ['finding_pool_debits'], 'sql': "SELECT COUNT(*) FROM finding_pool_debits WHERE state = 'reserved' AND claimed_at_unix_ms IS NOT NULL AND durable_admission_operation_id IS NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/iou_store.rs', 'owner': 'get_by_receipt_id', 'sha256': '2e0520d3efc0901826b84b4788a2fa49a29e76bd5f8dca4fe2fb53f256fc7579', 'tables': ['iou_envelope'], 'sql': 'SELECT canonical_json, tenant_id, iou_id, amount_units, currency, receipt_timestamp, issuer_key FROM iou_envelope WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/iou_store.rs', 'owner': 'insert_envelope_on_connection', 'sha256': '25a07d27d46cab3ef635bd1917d6409174adc64373871aacac3b20d20388cafd', 'tables': ['iou_envelope'], 'sql': 'SELECT canonical_json FROM iou_envelope WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store.rs', 'owner': 'claim_log_entry_seq_for_source_tx', 'sha256': '64f336f3fff876e0c416c6c2e9efde2f628432aca8bd667b5552b30ea6839b9a', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT l.entry_seq, l.receipt_id, l.raw_json, r.receipt_id, r.raw_json FROM claim_receipt_log_entries l JOIN chio_tool_receipts r ON r.seq = l.source_seq WHERE l.receipt_kind = ?1 AND l.source_seq = ?2'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store.rs', 'owner': 'consume_authorization_receipt_tx', 'sha256': '82ac136db9521066f2037f320414ba6c8a9a23b90fd3a36215e818263eb7e70f', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT tenant_id FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store.rs', 'owner': 'max_tool_receipt_seq', 'sha256': '7728e18b0d94639f58da1a4aab1e4420dd0c039fb8b1e55ab37f62612e942b60', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COALESCE(MAX(seq), 0) FROM chio_tool_receipts'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store.rs', 'owner': 'receipt_store_has_receipts', 'sha256': '788e9390229cdab460a749d18f7841f8e36602a8da8dd9eb29d2bc1010ad6cae', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT EXISTS( SELECT 1 FROM claim_receipt_log_entries UNION ALL SELECT 1 FROM chio_tool_receipts UNION ALL SELECT 1 FROM chio_child_receipts UNION ALL SELECT 1 FROM kernel_checkpoints UNION ALL SELECT 1 FROM receipt_retention_watermark WHERE archived_through_entry_seq > 0 UNION ALL SELECT 1 FROM receipt_retention_tombstones )'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/append.rs', 'owner': 'append_chio_receipt_tx_with_insert_status', 'sha256': 'fd1a52a142b39187d61b4e0ad28a5fb46b683d3148a4b7fd103a54166072152e', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json, cost_currency, cost_charged_be, attempted_cost_be FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/bootstrap/listing.rs', 'owner': 'list_tool_receipts', 'sha256': '52614f71879bdedf7c063a7a76bf80d9b161f384804f8d5768cbca6f4f5ecb16', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE (?1 IS NULL OR capability_id = ?1) AND (?2 IS NULL OR tool_server = ?2) AND (?3 IS NULL OR tool_name = ?3) AND (?4 IS NULL OR decision_kind = ?4) ORDER BY seq DESC LIMIT ?5'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/bootstrap/listing.rs', 'owner': 'list_tool_receipts_after_seq', 'sha256': 'dc60af54bb579030c9f7dc391f2d31327264e6889c06abaf13647b32e351dca9', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE seq > ?1 ORDER BY seq ASC LIMIT ?2'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/bootstrap/listing.rs', 'owner': 'list_tool_receipts_for_subject', 'sha256': 'f4594bc20ee15558179bb8b08d70652f8c99f60711efac160b7e637024a6505d', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT r.seq, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE COALESCE(r.subject_key, cl.subject_key) = ?1 ORDER BY r.timestamp ASC, r.seq ASC'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/bootstrap/listing.rs', 'owner': 'tool_receipt_count', 'sha256': '882361fe5bdef9da1a92e35ae82c30d49f0cbacf62e9114b924822abd6c3c7b9', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COUNT(*) FROM chio_tool_receipts'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'compute_archival_watermark', 'sha256': '204bc5c47488640c43b920857feea7b74688994b77538b7a63fdd238bf80bd84', 'tables': ['chio_authorization_receipt_consumptions'], 'sql': "SELECT COALESCE(MAX(kc.batch_end_seq), 0) FROM kernel_checkpoints kc WHERE NOT EXISTS ( SELECT 1 FROM claim_receipt_log_entries e WHERE e.entry_seq <= kc.batch_end_seq AND e.timestamp >= ?1 ) AND NOT EXISTS ( SELECT 1 FROM chio_authorization_receipt_consumptions ac JOIN claim_receipt_log_entries ae ON ae.receipt_id = ac.authorization_receipt_id JOIN claim_receipt_log_entries ce ON ce.receipt_id = ac.consumer_receipt_id WHERE ae.entry_seq <= kc.batch_end_seq AND ce.entry_seq > kc.batch_end_seq ) AND NOT EXISTS ( SELECT 1 FROM receipt_lineage_statements ls JOIN claim_receipt_log_entries pe ON pe.receipt_id = ls.parent_receipt_id JOIN claim_receipt_log_entries ce ON ce.receipt_id = ls.receipt_id WHERE pe.entry_seq <= kc.batch_end_seq AND ce.entry_seq > kc.batch_end_seq ) AND NOT EXISTS ( SELECT 1 FROM settlement_reconciliations sr JOIN claim_receipt_log_entries e ON e.receipt_id = sr.receipt_id WHERE e.entry_seq <= kc.batch_end_seq AND sr.reconciliation_state IN ('open', 'retry_scheduled') ) AND NOT EXISTS ( SELECT 1 FROM metered_billing_reconciliations mbr JOIN claim_receipt_log_entries e ON e.receipt_id = mbr.receipt_id WHERE e.entry_seq <= kc.batch_end_seq AND mbr.reconciliation_state IN ('open', 'retry_scheduled') ) {active_settlement_guard}"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'copy_archived_prefix', 'sha256': 'ace7d77a6c5315bfc328e6cf85ad8c8673356eb043849e0249664c1f2406a2d7', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COUNT(*) FROM archive.chio_tool_receipts'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'copy_archived_prefix', 'sha256': 'ace7d77a6c5315bfc328e6cf85ad8c8673356eb043849e0249664c1f2406a2d7', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COUNT(*) FROM archive.chio_tool_receipts'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'delete_archived_prefix_in_tx', 'sha256': 'b020a17baf9f7e4993f75b792fb5afb242e38785e2c0c2fb6ead847189a9b192', 'tables': ['chio_tool_receipts'], 'sql': "DELETE FROM chio_tool_receipts WHERE seq IN ( SELECT source_seq FROM claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt')"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'delete_archived_prefix_in_tx', 'sha256': 'cb30be9f95be8fc54d562bfc2bd7ce9e083c3b91619cb446778e50df6568cfb0', 'tables': ['chio_authorization_receipt_consumptions'], 'sql': "DELETE FROM chio_authorization_receipt_consumptions WHERE authorization_receipt_id IN ( SELECT receipt_id FROM claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt')"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'oldest_receipt_timestamp', 'sha256': '7036cdded9f5813e53c21ab7550e464366cb5fa928e2b7ddc7e525ea37c8cd49', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT MIN(timestamp) FROM chio_tool_receipts'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'retention_repair_on_writer', 'sha256': '5171b698f15925f9d64898776697c19396d7c94f7447fda5af585f2b1e425ee6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COUNT(*) FROM claim_receipt_log_entries e WHERE e.entry_seq <= ?1 AND (EXISTS (SELECT 1 FROM chio_tool_receipts t WHERE t.receipt_id = e.receipt_id) OR EXISTS (SELECT 1 FROM chio_child_receipts c WHERE c.receipt_id = e.receipt_id))'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'retention_repair_on_writer', 'sha256': 'f8dd345af975496b14cc1f16ce640fdab8eb0315b1774b5cf11078046a6b3a2e', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT e.entry_seq, e.receipt_id FROM claim_receipt_log_entries e WHERE NOT EXISTS (SELECT 1 FROM chio_tool_receipts t WHERE t.receipt_id = e.receipt_id) AND NOT EXISTS (SELECT 1 FROM chio_child_receipts c WHERE c.receipt_id = e.receipt_id) ORDER BY e.entry_seq'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': '081f47169a28888ab852e123decfb8dda782f1fb324cc9251f65dbf770c8fe89', 'tables': ['chio_authorization_receipt_consumptions'], 'sql': "SELECT COUNT(*) FROM main.chio_authorization_receipt_consumptions m WHERE m.authorization_receipt_id IN (SELECT receipt_id FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt') AND EXISTS (SELECT 1 FROM archive.chio_authorization_receipt_consumptions a WHERE a.authorization_receipt_id = m.authorization_receipt_id AND a.consumer_receipt_id IS m.consumer_receipt_id AND a.request_id IS m.request_id AND a.session_id IS m.session_id AND a.tool_call_id IS m.tool_call_id AND a.tenant_id IS m.tenant_id AND a.parameter_hash IS m.parameter_hash AND a.consumed_at_unix_ms IS m.consumed_at_unix_ms)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': '8abc8c456489f1fa887d733f9615848c49cb8356df32bcd61f715a1c458c6eb6', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM main.capability_lineage m WHERE m.capability_id IN (SELECT r.capability_id FROM main.chio_tool_receipts r WHERE r.seq IN (SELECT source_seq FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt')) AND EXISTS (SELECT 1 FROM archive.capability_lineage a WHERE a.capability_id = m.capability_id AND a.subject_key IS m.subject_key AND a.issuer_key IS m.issuer_key AND a.issued_at IS m.issued_at AND a.expires_at IS m.expires_at AND a.grants_json IS m.grants_json AND a.delegation_depth IS m.delegation_depth AND a.parent_capability_id IS m.parent_capability_id AND a.federated_parent_capability_id IS m.federated_parent_capability_id AND a.provenance IS m.provenance AND a.signed_capability_json IS m.signed_capability_json)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': '9503a24ba4571728582bd0d93f6f7f2f1d0d0faf4c9defc78d36d7b562bb7b68', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM main.chio_tool_receipts m WHERE m.seq IN (SELECT source_seq FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt') AND EXISTS (SELECT 1 FROM archive.chio_tool_receipts a WHERE a.seq = m.seq AND a.receipt_id IS m.receipt_id AND a.timestamp IS m.timestamp AND a.capability_id IS m.capability_id AND a.subject_key IS m.subject_key AND a.issuer_key IS m.issuer_key AND a.grant_index IS m.grant_index AND a.tool_server IS m.tool_server AND a.tool_name IS m.tool_name AND a.decision_kind IS m.decision_kind AND a.policy_hash IS m.policy_hash AND a.content_hash IS m.content_hash AND a.raw_json IS m.raw_json AND a.tenant_id IS m.tenant_id AND a.cost_currency IS m.cost_currency AND a.cost_charged_be IS m.cost_charged_be AND a.attempted_cost_be IS m.attempted_cost_be)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': 'a6a458fbbc36aee548f8421c936687a1bb7a73521288aaa7ee866f7981316af5', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM main.capability_lineage m WHERE m.capability_id IN (SELECT r.capability_id FROM main.chio_tool_receipts r WHERE r.seq IN (SELECT source_seq FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt'))"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': 'd890e5e7bce80de728b929e7dea3d4b55da88024aae4639bc345aec1b0e16dfd', 'tables': ['chio_authorization_receipt_consumptions'], 'sql': "SELECT COUNT(*) FROM main.chio_authorization_receipt_consumptions WHERE authorization_receipt_id IN (SELECT receipt_id FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt')"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/evidence_retention.rs', 'owner': 'verify_co_archival_complete', 'sha256': 'f747873b83b4f9909fa8eb9ef2864dc37f7902a8baceedba42e467c4baf8fc8c', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM main.chio_tool_receipts WHERE seq IN (SELECT source_seq FROM main.claim_receipt_log_entries WHERE entry_seq <= {w} AND receipt_kind = 'tool_receipt')"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/liability_claims.rs', 'owner': 'record_liability_claim_package', 'sha256': '8a46ddf99a9c1175dc4a933b77896d74ef06a2275d1c952bcd3f5f7e82b369f3', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT 1 FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/authorization.rs', 'owner': 'query_authorization_context_report', 'sha256': '2bf734ccc8196fb2d9677d99932269ede14e64a333ea02fbeca4de95fe252026', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.raw_json, r.subject_key, r.issuer_key, cl.subject_key, cl.issuer_key, r.grant_index, cl.grants_json, rls.statement_id, rls.session_anchor_id FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN receipt_lineage_statements rls ON r.receipt_id = rls.receipt_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.timestamp DESC, r.seq DESC"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/authorization.rs', 'owner': 'query_authorization_context_report', 'sha256': 'a97818d65fa748ac053e7680bf164e82c696b433b79acd8713852bc832e2152d', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.approval') = 'object' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.governed_transaction.approval.approved') = 1 THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.commerce') = 'object' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.metered_billing') = 'object' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.runtime_assurance') = 'object' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.call_chain') = 'object' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.max_amount') = 'object' THEN 1 ELSE 0 END ), 0) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/authorization.rs', 'owner': 'query_authorization_review_pack', 'sha256': '64a0804960ba1dd8c0b9b9b6b5e62d1dec304e37aaf6901f1460057195122cc6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/behavioral.rs', 'owner': 'query_behavioral_feed_receipts', 'sha256': '66c7c70fe158166663230861e23c78c3675257b8e5b9a69b352df92c28292234', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT r.seq, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.timestamp DESC, r.seq DESC LIMIT ?7'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/behavioral.rs', 'owner': 'query_behavioral_feed_receipts', 'sha256': '838cc90158b0f0d61653dc4d2c976c69cc6331fb4a16b0d3df32e6bfa0fcbe00', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT COUNT(*) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/behavioral.rs', 'owner': 'query_behavioral_feed_receipts', 'sha256': 'b17cc7b166ab59a776d6fb1df9928518b32537778f09176b563b87d613988a31', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COALESCE(SUM( CASE WHEN COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'pending' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'settled' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'failed' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'not_applicable' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') IN ('pending', 'failed') AND COALESCE(sr.reconciliation_state, 'open') NOT IN ('reconciled', 'ignored') THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(sr.reconciliation_state, 'open') = 'reconciled' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction') IS NOT NULL THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.approval') IS NOT NULL THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.governed_transaction.approval.approved') = 1 THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.commerce') IS NOT NULL THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN json_type(r.raw_json, '$.metadata.governed_transaction.max_amount') IS NOT NULL THEN 1 ELSE 0 END ), 0) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/behavioral.rs', 'owner': 'query_recent_credit_loss_receipts', 'sha256': '834b06d2c1ff408ef959cde0f8c2864fe9e7e61e2a6642f88f2adc60259ebe45', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) AND ( COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'failed' OR ( COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') IN ('pending', 'failed') AND COALESCE(sr.reconciliation_state, 'open') NOT IN ('reconciled', 'ignored') ) )"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/behavioral.rs', 'owner': 'query_recent_credit_loss_receipts', 'sha256': 'ea0934f5e1a00984e5e78a4198565b792a4c48d2b00e601390974a4228611cfa', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) AND ( COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') = 'failed' OR ( COALESCE(json_extract(r.raw_json, '$.metadata.financial.settlement_status'), 'not_applicable') IN ('pending', 'failed') AND COALESCE(sr.reconciliation_state, 'open') NOT IN ('reconciled', 'ignored') ) ) ORDER BY r.timestamp DESC, r.seq DESC LIMIT ?7"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/billing.rs', 'owner': 'query_metered_billing_summary', 'sha256': '9dd937a9400cd4801a035f5f1ceaceab221c1a57517bc26043b11fcf3bd08fb8', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) AS matching_receipts, COALESCE(SUM(CASE WHEN mbr.receipt_id IS NOT NULL THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN mbr.receipt_id IS NULL THEN 1 ELSE 0 END), 0), COALESCE(SUM( CASE WHEN mbr.receipt_id IS NOT NULL AND mbr.observed_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedUnits') AS INTEGER) THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN mbr.receipt_id IS NOT NULL AND json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.maxBilledUnits') IS NOT NULL AND mbr.observed_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.maxBilledUnits') AS INTEGER) THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN mbr.receipt_id IS NOT NULL AND ( mbr.billed_cost_currency != json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedCost.currency') OR mbr.billed_cost_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedCost.units') AS INTEGER) ) THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN mbr.receipt_id IS NOT NULL AND json_type(r.raw_json, '$.metadata.financial') = 'object' AND ( mbr.billed_cost_currency != json_extract(r.raw_json, '$.metadata.financial.currency') OR mbr.billed_cost_units != CAST(json_extract(r.raw_json, '$.metadata.financial.cost_charged') AS INTEGER) ) THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(mbr.reconciliation_state, 'open') = 'reconciled' THEN 1 ELSE 0 END ), 0), COALESCE(SUM( CASE WHEN COALESCE(mbr.reconciliation_state, 'open') NOT IN ('reconciled', 'ignored') AND ( mbr.receipt_id IS NULL OR mbr.observed_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedUnits') AS INTEGER) OR ( json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.maxBilledUnits') IS NOT NULL AND mbr.observed_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.maxBilledUnits') AS INTEGER) ) OR mbr.billed_cost_currency != json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedCost.currency') OR mbr.billed_cost_units > CAST(json_extract(r.raw_json, '$.metadata.governed_transaction.metered_billing.quote.quotedCost.units') AS INTEGER) OR ( json_type(r.raw_json, '$.metadata.financial') = 'object' AND ( mbr.billed_cost_currency != json_extract(r.raw_json, '$.metadata.financial.currency') OR mbr.billed_cost_units != CAST(json_extract(r.raw_json, '$.metadata.financial.cost_charged') AS INTEGER) ) ) ) THEN 1 ELSE 0 END ), 0) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN metered_billing_reconciliations mbr ON r.receipt_id = mbr.receipt_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction.metered_billing') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/compliance.rs', 'owner': 'query_compliance_report', 'sha256': '3e2aea65e6651b18940218e5e51b85f62726d96c8240dc5cb4d5e2a430ef5415', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) AS matching_receipts, COALESCE(SUM( CASE WHEN EXISTS( SELECT 1 FROM kernel_checkpoints kc WHERE r.seq BETWEEN kc.batch_start_seq AND kc.batch_end_seq ) THEN 1 ELSE 0 END ), 0) AS evidence_ready_receipts, COALESCE(SUM(CASE WHEN cl.capability_id IS NOT NULL THEN 1 ELSE 0 END), 0) AS lineage_covered_receipts, COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.financial.settlement_status') = 'pending' THEN 1 ELSE 0 END ), 0) AS pending_settlement_receipts, COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.financial.settlement_status') = 'failed' THEN 1 ELSE 0 END ), 0) AS failed_settlement_receipts FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/cost_attribution.rs', 'owner': 'query_cost_attribution_report', 'sha256': '23248f6f8ac5d1f69651355f58d0255586d7e87c7610a604c8fe3aa83fbf9e69', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) AND json_type(r.raw_json, '$.metadata.financial') = 'object'"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/cost_attribution.rs', 'owner': 'query_cost_attribution_report', 'sha256': 'a45631597479a19a776de4219bacaaf005207de8f4ab10ab7c66d58fe615d021', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) AND json_type(r.raw_json, '$.metadata.financial') = 'object' ORDER BY r.seq ASC"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/economic.rs', 'owner': 'query_economic_receipt_projection_report', 'sha256': '9a982dd453048e75fb684339497a0d98a5fdaf44fc1b24996bac073c09cc3dcc', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction.economic_authorization') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/economic.rs', 'owner': 'query_economic_receipt_projection_report', 'sha256': 'cd227809b531088308c2d6459c02cd6fd44fed5210b39df00540ada664e93a6a', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.receipt_id, r.timestamp, r.capability_id, COALESCE(r.subject_key, cl.subject_key), r.tool_server, r.tool_name, COALESCE(sr.reconciliation_state, 'open'), sr.note, sr.updated_at, COALESCE(mbr.reconciliation_state, 'open'), mbr.note, mbr.updated_at, mbr.adapter_kind, mbr.evidence_id, mbr.observed_units, mbr.billed_cost_units, mbr.billed_cost_currency, mbr.evidence_sha256, mbr.recorded_at, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id LEFT JOIN metered_billing_reconciliations mbr ON r.receipt_id = mbr.receipt_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction.economic_authorization') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.timestamp DESC, r.seq DESC LIMIT ?7"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/reconciliation.rs', 'owner': 'query_metered_billing_reconciliation_report', 'sha256': 'dfe17e802091282a481d3df852ac36f4a47d9a104f38d77a739c69f60041c81b', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.raw_json, COALESCE(r.subject_key, cl.subject_key), mbr.adapter_kind, mbr.evidence_id, mbr.observed_units, mbr.billed_cost_units, mbr.billed_cost_currency, mbr.evidence_sha256, mbr.recorded_at, COALESCE(mbr.reconciliation_state, 'open'), mbr.note, mbr.updated_at FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN metered_billing_reconciliations mbr ON r.receipt_id = mbr.receipt_id WHERE json_type(r.raw_json, '$.metadata.governed_transaction.metered_billing') = 'object' AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.timestamp DESC, r.seq DESC LIMIT ?7"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/reconciliation.rs', 'owner': 'upsert_metered_billing_reconciliation', 'sha256': '64a0804960ba1dd8c0b9b9b6b5e62d1dec304e37aaf6901f1460057195122cc6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/reconciliation.rs', 'owner': 'upsert_settlement_reconciliation', 'sha256': '8a46ddf99a9c1175dc4a933b77896d74ef06a2275d1c952bcd3f5f7e82b369f3', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT 1 FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/settlement.rs', 'owner': 'query_settlement_reconciliation_report', 'sha256': '2a3d5d9c72c46a7ad4ac83bced379b4c6585f779ddaaaa04ba04cecfcaf02319', 'tables': ['chio_tool_receipts'], 'sql': "SELECT COUNT(*) AS matching_receipts, COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.financial.settlement_status') = 'pending' THEN 1 ELSE 0 END ), 0) AS pending_receipts, COALESCE(SUM( CASE WHEN json_extract(r.raw_json, '$.metadata.financial.settlement_status') = 'failed' THEN 1 ELSE 0 END ), 0) AS failed_receipts, COALESCE(SUM( CASE WHEN COALESCE(sr.reconciliation_state, 'open') NOT IN ('reconciled', 'ignored') THEN 1 ELSE 0 END ), 0) AS actionable_receipts, COALESCE(SUM( CASE WHEN COALESCE(sr.reconciliation_state, 'open') = 'reconciled' THEN 1 ELSE 0 END ), 0) AS reconciled_receipts FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id WHERE json_extract(r.raw_json, '$.metadata.financial.settlement_status') IN ('pending', 'failed') AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6)"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/settlement.rs', 'owner': 'query_settlement_reconciliation_report', 'sha256': 'fd657922f0a39b01118cb43ddf2ab11255ab9406600dbfd1f90d7bf3073d0c5f', 'tables': ['chio_tool_receipts'], 'sql': "SELECT r.seq, r.receipt_id, r.timestamp, r.capability_id, COALESCE(r.subject_key, cl.subject_key), r.tool_server, r.tool_name, json_extract(r.raw_json, '$.metadata.financial.payment_reference'), json_extract(r.raw_json, '$.metadata.financial.settlement_status'), CAST(json_extract(r.raw_json, '$.metadata.financial.cost_charged') AS INTEGER), json_extract(r.raw_json, '$.metadata.financial.currency'), COALESCE(sr.reconciliation_state, 'open'), sr.note, sr.updated_at, r.raw_json FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id LEFT JOIN settlement_reconciliations sr ON r.receipt_id = sr.receipt_id WHERE json_extract(r.raw_json, '$.metadata.financial.settlement_status') IN ('pending', 'failed') AND (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.timestamp DESC, r.seq DESC LIMIT ?7"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/reports/shared_evidence.rs', 'owner': 'query_shared_evidence_report', 'sha256': 'a0a66c9b5c1d79b5ee7fc35eab29a4517c147e78ac6d454234c981636e5787e1', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT r.receipt_id, r.timestamp, r.capability_id, r.decision_kind FROM chio_tool_receipts r LEFT JOIN capability_lineage cl ON r.capability_id = cl.capability_id WHERE (?1 IS NULL OR r.capability_id = ?1) AND (?2 IS NULL OR r.tool_server = ?2) AND (?3 IS NULL OR r.tool_name = ?3) AND (?4 IS NULL OR r.timestamp >= ?4) AND (?5 IS NULL OR r.timestamp <= ?5) AND (?6 IS NULL OR COALESCE(r.subject_key, cl.subject_key) = ?6) ORDER BY r.seq ASC'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/checkpoint_projection.rs', 'owner': 'load_tool_claim_receipt_projection_row_by_id', 'sha256': '63b4eb3257cb5e0be1fce3b887aaf7dce5119af6b57987e98338e97b9e7ecbd0', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT receipt_id, seq, timestamp, capability_id, subject_key, issuer_key, tool_server, tool_name, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/checkpoint_projection.rs', 'owner': 'load_tool_claim_receipt_projection_rows', 'sha256': '4817d53fe5b8565e5b7ad7655559269de22ce71791de45448cea84bae312fa9d', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT receipt_id, seq, timestamp, capability_id, subject_key, issuer_key, tool_server, tool_name, raw_json FROM chio_tool_receipts ORDER BY timestamp ASC, seq ASC'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/claim_log/schema.rs', 'owner': 'backfill_tool_receipt_attribution_columns', 'sha256': '24caaab20e6cd3474344dcb931c4000a753db9eae7304d899482ce91f42100d0', 'tables': ['chio_tool_receipts'], 'sql': "UPDATE chio_tool_receipts SET grant_index = CAST(COALESCE( json_extract(raw_json, '$.metadata.attribution.grant_index'), json_extract(raw_json, '$.metadata.financial.grant_index') ) AS INTEGER) WHERE grant_index IS NULL AND COALESCE( json_extract(raw_json, '$.metadata.attribution.grant_index'), json_extract(raw_json, '$.metadata.financial.grant_index') ) IS NOT NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/claim_log/schema.rs', 'owner': 'backfill_tool_receipt_attribution_columns', 'sha256': '70c8cc09b03aa9ec62532f6e9cb4d6a4027894082e7a8943d6a81e7986604ea4', 'tables': ['chio_tool_receipts'], 'sql': "UPDATE chio_tool_receipts SET tenant_id = CAST(json_extract(raw_json, '$.tenant_id') AS TEXT) WHERE tenant_id IS NULL AND json_extract(raw_json, '$.tenant_id') IS NOT NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/claim_log/schema.rs', 'owner': 'backfill_tool_receipt_attribution_columns', 'sha256': '8c6b6788289e422aaf9f58d985cae1dcef182e19eb23de16edc7d4e651ef7075', 'tables': ['chio_tool_receipts'], 'sql': "UPDATE chio_tool_receipts SET subject_key = COALESCE( subject_key, CAST(json_extract(raw_json, '$.metadata.attribution.subject_key') AS TEXT), (SELECT cl.subject_key FROM capability_lineage cl WHERE cl.capability_id = chio_tool_receipts.capability_id) ) WHERE subject_key IS NULL AND COALESCE( CAST(json_extract(raw_json, '$.metadata.attribution.subject_key') AS TEXT), (SELECT cl.subject_key FROM capability_lineage cl WHERE cl.capability_id = chio_tool_receipts.capability_id) ) IS NOT NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/claim_log/schema.rs', 'owner': 'backfill_tool_receipt_attribution_columns', 'sha256': 'bab2f84a92a8be09bf214af58ab557d1ac7039620e7ca37dc968704dc10859cc', 'tables': ['chio_tool_receipts'], 'sql': "UPDATE chio_tool_receipts SET issuer_key = COALESCE( issuer_key, CAST(json_extract(raw_json, '$.metadata.attribution.issuer_key') AS TEXT), (SELECT cl.issuer_key FROM capability_lineage cl WHERE cl.capability_id = chio_tool_receipts.capability_id) ) WHERE issuer_key IS NULL AND COALESCE( CAST(json_extract(raw_json, '$.metadata.attribution.issuer_key') AS TEXT), (SELECT cl.issuer_key FROM capability_lineage cl WHERE cl.capability_id = chio_tool_receipts.capability_id) ) IS NOT NULL"}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/lineage.rs', 'owner': 'backfill_provenance_lineage_tables', 'sha256': '45af9378bee1a5ca07e74b7f1cf0899b47a630540a7c4c8790349038df2fb4d5', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT receipt_id FROM chio_tool_receipts ORDER BY timestamp ASC, seq ASC'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/lineage.rs', 'owner': 'ensure_receipt_lineage_statement_for_receipt_id_tx', 'sha256': '64a0804960ba1dd8c0b9b9b6b5e62d1dec304e37aaf6901f1460057195122cc6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/lineage.rs', 'owner': 'receipt_id_exists_tx', 'sha256': 'afbcccc10090f78d30bea88d5b4557ecae2b85a493caf4e3e5e7728acdd255e5', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT 1 FROM ( SELECT receipt_id FROM chio_tool_receipts UNION ALL SELECT receipt_id FROM chio_child_receipts ) WHERE receipt_id = ?1 LIMIT 1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/store_impl.rs', 'owner': 'append_indexed_security_evidence', 'sha256': '7f2b6f2552ed185b1638d0eea3fccb8712f431c72bab2d4aa0f5f3056e6d0780', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/store_impl.rs', 'owner': 'load_chio_receipt', 'sha256': '64a0804960ba1dd8c0b9b9b6b5e62d1dec304e37aaf6901f1460057195122cc6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/store_impl.rs', 'owner': 'load_chio_receipt_row', 'sha256': '64a0804960ba1dd8c0b9b9b6b5e62d1dec304e37aaf6901f1460057195122cc6', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1'}, {'path': 'crates/platform/chio-store-sqlite/src/receipt_store/support/store_impl.rs', 'owner': 'load_chio_receipt_with_context', 'sha256': '008c3389cbbb180e72699968e5259ad70f9bbc352cc16d54e42c1998d94eceec', 'tables': ['chio_tool_receipts'], 'sql': 'SELECT seq, raw_json FROM chio_tool_receipts WHERE receipt_id = ?1 AND (?2 IS NULL OR tenant_id = ?2)'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state.rs', 'owner': 'active_defense_overlay_inventory', 'sha256': 'b004a2156d3dcec3ffa3e2c2f04b2242e1fec84f9d5eab49e6df879aa72b1f94', 'tables': ['security_capability_set_suspension_effects', 'security_effect_contributions', 'security_egress_restriction_effects', 'security_issuance_freeze_effects', 'security_session_throttle_effects'], 'sql': 'SELECT (SELECT COUNT(*) FROM security_effect_contributions), (SELECT COUNT(*) FROM security_session_throttle_effects), (SELECT COUNT(*) FROM security_capability_set_suspension_effects), (SELECT COUNT(*) FROM security_issuance_freeze_effects), (SELECT COUNT(*) FROM security_egress_restriction_effects)'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/capability_set_suspension.rs', 'owner': 'ensure_capability_set_suspensions_ready', 'sha256': '3fce703a92ee0880603d30e50bdd1e88f573ff693894ddcaf62dd67bf4c88f1b', 'tables': ['security_capability_set_suspension_state'], 'sql': 'SELECT tenant_id, affected_set_hash FROM security_capability_set_suspension_state ORDER BY tenant_id, affected_set_hash'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/capability_set_suspension.rs', 'owner': 'ensure_capability_set_suspensions_ready', 'sha256': 'ba4eabd03e39b8b6c012f228cb5b64ce034dd1f9841606a61e51d113b9d31cde', 'tables': ['security_capability_set_suspension_commands'], 'sql': 'SELECT tenant_id, idempotency_key FROM security_capability_set_suspension_commands ORDER BY tenant_id, idempotency_key'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/containment.rs', 'owner': 'ensure_containment_overlays_ready', 'sha256': '26ebddf637ecfa4303da0c668e47b877680a504d1641b2953995ae449e2b55d9', 'tables': ['security_containment_overlay_commands'], 'sql': 'SELECT tenant_id, idempotency_key FROM security_containment_overlay_commands ORDER BY tenant_id, idempotency_key'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/containment.rs', 'owner': 'ensure_containment_overlays_ready', 'sha256': '38056d66958c3f1e96ad6a593efc1a7e94d86b598e04fcfb23a5289ae5954397', 'tables': ['security_overlay_state'], 'sql': 'SELECT tenant_id, target_id FROM security_overlay_state ORDER BY tenant_id, target_id'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/correlation.rs', 'owner': 'count_pending_correlation_events', 'sha256': '65b8836535c75187fa018b59949492cea37280c00f3c31f78f1681b38a95ee32', 'tables': ['security_correlation_ingress'], 'sql': 'SELECT COUNT(*) FROM security_correlation_ingress WHERE acknowledged = 0'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/correlation.rs', 'owner': 'ensure_correlation_ingress_ready', 'sha256': 'ebc4b4f5d1e84ca05d865ce167c2b7899a72e5a372e419e56