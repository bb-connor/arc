onse_outbox_health', 'sha256': 'dc23e9f74c4ae2ab9802e57e632c30b5fbaa089ed9eac4c52c4b87c54f999b1a', 'tables': ['security_attested_finding_response_outbox'], 'sql': "SELECT COALESCE(SUM(CASE WHEN planning_state = 'pending' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN planning_state = 'planned' AND admission_state = 'pending' AND completion_state = 'not_started' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN planning_state = 'planned' AND admission_state = 'pending' AND completion_state = 'not_started' AND admission_artifact_digest IS NULL THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_state = 'pending' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_state = 'outcome_unknown_after_dispatch' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN planning_state = 'failed' OR admission_state = 'rejected' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN admission_state = 'expired' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_outcome = 'activated' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_outcome = 'failed_before_effect' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_outcome = 'rolled_back_after_partial' THEN 1 ELSE 0 END), 0), COALESCE(SUM(CASE WHEN completion_state = 'simulated' THEN 1 ELSE 0 END), 0) FROM security_attested_finding_response_outbox"}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/response_outbox.rs', 'owner': 'ensure_attested_finding_response_outbox_ready', 'sha256': '25b3a980d91ead000757cd0f0534372a3f45f3f29eb060a424874ee64e243d7f', 'tables': ['security_attested_finding_response_outbox'], 'sql': 'SELECT tenant_id, action_id FROM security_attested_finding_response_outbox ORDER BY tenant_id, action_id'}, {'path': 'crates/platform/chio-store-sqlite/src/security_state/response_outbox.rs', 'owner': 'scan_attested_finding_response_outbox', 'sha256': '2c615cb2a32e2f38eb6d53a1e5adf3ba9b323d393a00d1be2ea1e8482382d0b3', 'tables': ['security_attested_finding_response_outbox'], 'sql': "SELECT {ATTE