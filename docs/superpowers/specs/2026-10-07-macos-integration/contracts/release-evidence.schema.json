{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-evidence.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "chio.macos.release-evidence.v1"
    },
    "profile": {
      "$ref": "common.schema.json#/$defs/profile"
    },
    "features": {
      "type": "array",
      "items": {
        "const": "publication-v1"
      },
      "minItems": 0,
      "maxItems": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "const": "candidate"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty_patch_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "installed_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "team_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "signature_evidence_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "version",
          "artifact_digest",
          "installed_digest",
          "team_id",
          "signature_evidence_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "host": {
      "type": "object",
      "properties": {
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "os_build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sdk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "guest_architecture": {
          "enum": [
            "arm64",
            "x86_64",
            "none"
          ]
        }
      },
      "required": [
        "architecture",
        "os_build",
        "os_version",
        "sdk",
        "toolchain",
        "guest_architecture"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "state": {
            "enum": [
              "granted",
              "denied",
              "pending",
              "unavailable"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "state",
          "observed_at",
          "evidence_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kernel_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "uint64-decimal"
    },
    "harness_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appliedProfileManifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^AT-MAC-[A-Z]+-[0-9]{3}$"
          },
          "classification": {
            "enum": [
              "source",
              "component",
              "installed_runtime"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unavailable",
              "skipped",
              "gap"
            ]
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "positive_control_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "negative_control_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observer_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "acceptance_id",
          "classification",
          "result",
          "artifact_digest",
          "positive_control_digest",
          "negative_control_digest",
          "expected_digest",
          "observed_digest",
          "observer_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "verifier": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trust_root_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "identity",
        "version",
        "trust_root_digest"
      ],
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "workload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "workload_digest",
        "baseline_digest",
        "observation_digest"
      ],
      "additionalProperties": false
    },
    "restore_freshness_ref": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/native_ref"
            },
            {
              "properties": {
                "kind": {
                  "const": "restore"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "profile",
    "features",
    "synthetic",
    "status",
    "source_revision",
    "dirty_patch_digest",
    "components",
    "host",
    "permissions",
    "policy_digest",
    "kernel_generation",
    "harness_digest",
    "appliedProfileManifestDigest",
    "cases",
    "verifier",
    "performance",
    "restore_freshness_ref"
  ],
  "additionalProperties": false
}
