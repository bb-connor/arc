{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compatibility.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": "chio.macos.compatibility.v1"
    },
    "operator_version": {
      "const": "chio.desktop.operator.v1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "installed_tuple_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "common.schema.json#/$defs/profile"
          },
          "status": {
            "enum": [
              "unavailable",
              "source_supported_unqualified",
              "qualified_for_tuple"
            ]
          },
          "missing": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "qualification_ref": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/native_ref"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "profile",
          "status",
          "missing",
          "qualification_ref"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "qualified_for_tuple"
                }
              }
            },
            "then": {
              "properties": {
                "missing": {
                  "maxItems": 0
                },
                "qualification_ref": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/native_ref"
                    },
                    {
                      "properties": {
                        "kind": {
                          "const": "evidence"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "qualification_ref": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "observe-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "brokered-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "vm-project-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "remote-project-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "native-descendant-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "profile": {
                "const": "managed-endpoint-v1"
              }
            },
            "required": [
              "profile"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "version",
    "operator_version",
    "source_revision",
    "installed_tuple_digest",
    "profiles"
  ],
  "additionalProperties": false
}
