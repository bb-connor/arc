{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed compatibility tuple, structural gate only",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "proposed",
        "qualified"
      ]
    },
    "profile_id": {
      "enum": [
        "observe-v1",
        "project-v1",
        "reviewed-publish-v1",
        "desktop-v1",
        "repair-v1",
        "delegated-v1"
      ]
    },
    "platform": {
      "type": "object",
      "properties": {
        "arch": {
          "const": "x86_64"
        },
        "kernel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "omarchy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "session": {
          "const": "wayland"
        }
      },
      "required": [
        "arch",
        "kernel",
        "omarchy",
        "session"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "status": {
            "enum": [
              "open",
              "passed",
              "failed"
            ]
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "evidence_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "status",
    "profile_id",
    "platform",
    "components",
    "prerequisites"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        }
      },
      "then": {
        "properties": {
          "prerequisites": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                }
              }
            }
          }
        }
      }
    }
  ]
}
