{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed operator shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profile": {
      "enum": [
        "observe-v1",
        "project-v1",
        "reviewed-publish-v1",
        "desktop-v1",
        "repair-v1",
        "delegated-v1"
      ]
    },
    "task_state": {
      "enum": [
        "preparing",
        "ready",
        "running",
        "waiting_approval",
        "recovering",
        "blocked_unknown",
        "cancelling",
        "cancelled",
        "succeeded",
        "failed"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "cursor": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "epoch",
        "seq"
      ],
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "native_id": {
          "$ref": "common.schema.json#/$defs/native_id"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "enum": [
            "unavailable",
            "verified",
            "invalid"
          ]
        },
        "owner_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "native_id",
        "sha256",
        "verification",
        "owner_id"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "preparing",
            "ready",
            "running",
            "waiting_approval",
            "recovering",
            "blocked_unknown",
            "cancelling",
            "cancelled",
            "succeeded",
            "failed"
          ]
        },
        "profile_id": {
          "enum": [
            "observe-v1",
            "project-v1",
            "reviewed-publish-v1",
            "desktop-v1",
            "repair-v1",
            "delegated-v1"
          ]
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "outcome": {
          "enum": [
            "not_started",
            "known",
            "unknown"
          ]
        },
        "guest_state": {
          "enum": [
            "not_started",
            "running",
            "exited",
            "unknown"
          ]
        },
        "latest_operation_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/native_operation_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_ref"
          },
          "maxItems": 32
        },
        "stop_status": {
          "$ref": "common.schema.json#/$defs/stop_status"
        }
      },
      "required": [
        "task_id",
        "revision",
        "state",
        "profile_id",
        "project_id",
        "label",
        "outcome",
        "guest_state",
        "latest_operation_ref",
        "evidence",
        "stop_status"
      ],
      "additionalProperties": false
    },
    "error_code": {
      "enum": [
        "invalid_request",
        "unsupported_version",
        "prerequisite_unavailable",
        "revision_conflict",
        "idempotency_conflict",
        "capacity",
        "authority_denied",
        "outcome_unknown",
        "cursor_expired",
        "storage_unavailable",
        "response_too_large"
      ]
    },
    "native_operation_ref": {
      "type": "object",
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "native_id": {
          "$ref": "common.schema.json#/$defs/native_id"
        }
      },
      "required": [
        "owner_id",
        "native_id"
      ],
      "additionalProperties": false
    },
    "stop_status": {
      "type": "object",
      "properties": {
        "admissions_stopped": {
          "enum": [
            "not_requested",
            "requested",
            "confirmed",
            "unknown"
          ]
        },
        "guest_exit_observed": {
          "enum": [
            "not_requested",
            "requested",
            "confirmed",
            "unknown"
          ]
        },
        "provider_abort_requested": {
          "enum": [
            "not_requested",
            "requested",
            "unknown",
            "not_applicable"
          ]
        },
        "outcome_reconciliation_required": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        }
      },
      "required": [
        "admissions_stopped",
        "guest_exit_observed",
        "provider_abort_requested",
        "outcome_reconciliation_required"
      ],
      "additionalProperties": false
    },
    "native_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}(?![\\s\\S])"
    },
    "protocol_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "enrolled_scope_binding": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "common.schema.json#/$defs/native_operation_ref"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/safe_integer"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "reference",
        "revision",
        "sha256",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
