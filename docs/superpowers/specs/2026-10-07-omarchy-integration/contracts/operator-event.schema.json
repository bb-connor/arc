{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed bounded projection events",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "chio.omarchy.operator.v1"
        },
        "type": {
          "const": "event"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/cursor"
        },
        "event_type": {
          "const": "heartbeat"
        }
      },
      "required": [
        "protocol",
        "type",
        "cursor",
        "event_type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "chio.omarchy.operator.v1"
        },
        "type": {
          "const": "event"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/cursor"
        },
        "event_type": {
          "const": "task_changed"
        },
        "task": {
          "$ref": "common.schema.json#/$defs/task"
        }
      },
      "required": [
        "protocol",
        "type",
        "cursor",
        "event_type",
        "task"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "chio.omarchy.operator.v1"
        },
        "type": {
          "const": "event"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/cursor"
        },
        "event_type": {
          "const": "approval_invalidated"
        },
        "task_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "proposal_id": {
          "$ref": "common.schema.json#/$defs/native_id"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/safe_integer"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      },
      "required": [
        "protocol",
        "type",
        "cursor",
        "event_type",
        "task_id",
        "proposal_id",
        "revision",
        "reason_code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "chio.omarchy.operator.v1"
        },
        "type": {
          "const": "event"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/cursor"
        },
        "event_type": {
          "const": "prerequisite_changed"
        },
        "prerequisite_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "type",
        "cursor",
        "event_type",
        "prerequisite_id",
        "available"
      ],
      "additionalProperties": false
    }
  ]
}
