                      "enum": [
                        "fresh",
                        "stale",
                        "unknown"
                      ]
                    },
                    "protocol": {
                      "enum": [
                        "compatible",
                        "incompatible",
                        "unknown"
                      ]
                    },
                    "packages": {
                      "enum": [
                        "compatible",
                        "incompatible",
                        "unknown"
                      ]
                    },
                    "enforcement": {
