    {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "chio.omarchy.operator.v1"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "method": {
          "const": "hello"
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hello"
            },
            "value": {
              "type": "object",
              "properties": {
                "journal_epoch": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "enrollment_epoch": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/profile"
                  },
                  "maxItems": 6
                },
                "features": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "status",
                      "project",
                      "approvals",
                      "publication",
                      "desktop",
                      "repair",
                      "delegation",
                      "export"
                    ]
                  },
                  "maxItems": 8
                },
                "max_frame_bytes": {
                  "const": 65536
                },
                "heartbeat_seconds": {
                  "const": 5
                },
                "builds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 96
                      },
                      "sha256": {
                        "$ref": "common.schema.json#/$defs/sha256"
                      }
                    },
                    "required": [
                      "component",
                      "version",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 32
                }
              },
              "required": [
                "journal_epoch",
                "enrollment_epoch",
                "profiles",
                "features",
                "max_frame_bytes",
                "heartbeat_seconds",
                "builds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "request_id",
        "method",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
