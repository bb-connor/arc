                      "anyOf": [
                        {
                          "$ref": "common.schema.json#/$defs/safe_integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "credentials": {
                      "enum": [
                        "healthy",
                        "expired",
                        "revoked",
                        "unavailable",
                        "unknown"
                      ]
                    },
                    "desktop_session": {
                      "enum": [
                        "unlocked",
                        "locked",
                        "unowned",
                        "unknown"
                      ]
                    },
                    "native_recovery": {
                      "enum": [
                        "healthy",
                        "blocked_unknown",
                        "unavailable",
                        "unknown"
                      ]
                    },
                    "state_store": {
                      "enum": [
                        "healthy",
                        "full",
                        "read_only",
                        "incompatible",
                        "unavailable",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "observed_at",
                    "boot_id",
                    "session_id",
                    "freshness",
                    "protocol",
                    "packages",
                    "enforcement",
                    "storage_headroom_bytes",
                    "credentials",
                    "desktop_session",
                    "native_recovery",
                    "state_store"
