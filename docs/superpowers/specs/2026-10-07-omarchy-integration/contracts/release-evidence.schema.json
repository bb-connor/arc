{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed release evidence index, not a receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "candidate",
        "qualified"
      ]
    },
    "profile_id": {
      "enum": [
        "observe-v1",
        "project-v1",
        "reviewed-publish-v1",
        "desktop-v1",
        "repair-v1",
        "delegated-v1"
      ]
    },
    "compatibility_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirements_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tester": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^AT-[A-Z]+-[0-9]{3}$"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "skipped",
              "unknown"
            ]
          },
          "evidence_class": {
            "enum": [
              "source",
              "document",
              "component",
              "independent_integration",
              "clean_install"
            ]
          },
          "artifact_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "acceptance_id",
          "outcome",
          "evidence_class",
          "artifact_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "status",
    "profile_id",
    "compatibility_sha256",
    "requirements_sha256",
    "tester",
    "started_at",
    "finished_at",
    "cases",
    "open_findings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        }
      },
      "then": {
        "properties": {
          "open_findings": {
            "maxItems": 0
          },
          "cases": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "pass"
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
