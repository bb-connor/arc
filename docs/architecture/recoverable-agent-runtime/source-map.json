  "findings": [
    {
      "id": "SRC-01",
      "observed": "Complete tool requests are frozen under logical operation identity.",
      "paths": [
        "crates/kernel/chio-process/src/lib.rs",
        "crates/kernel/chio-process/src/store.rs",
        "crates/kernel/chio-process/src/store.sql"
      ],
      "design_consequence": "Separate workflow/step/continuation identity; reserve before approval and finalize once."
    },
    {
      "id": "SRC-02",
      "observed": "Native flow uses borrowed preparation and an existing capture authority.",
      "paths": [
        "crates/platform/chio-control-plane/src/security/adapters/native_flow.rs",
        "crates/platform/chio-control-plane/src/security/adapters/native_flow/declassification.rs"
      ],
      "design_consequence": "Join the existing native capture protocol; historical custody is not a live owner."
    },
    {
      "id": "SRC-03",
      "observed": "Grant v1 lacks workflow/step/continuation binding.",
      "paths": [
        "crates/security/chio-security-types/src/declassification.rs",
        "crates/core/chio-core-types/src/declassification.rs",
        "crates/security/chio-flow/src/declassification.rs"
      ],
      "design_consequence": "Add explicitly versioned recovery binding and scoped owner coverage at native verification."
    },
    {
      "id": "SRC-04",
      "observed": "Source joins retain payload, input floor, principal, lineage and session restrictions.",
      "paths": [
        "crates/security/chio-flow/src/engine.rs",
        "crates/security/chio-flow/src/lattice.rs",
        "crates/security/chio-security-types/src/flow.rs",
        "crates/security/chio-security-kernel/src/pre_invocation.rs"
      ],
      "design_consequence": "Preserve the current label algebra and monotone observation path."
    },
    {
      "id": "SRC-05",
      "observed": "Terminal evaluation/denial does not establish a resource had no effect.",
      "paths": [
        "crates/kernel/chio-kernel/src/admission_operation.rs",
        "crates/kernel/chio-kernel/src/admission_operation/projection/outcome_unknown.rs",
        "docs/architecture/SWARM_EXECUTION_CONTRACT.md"
      ],
      "design_consequence": "Use owning effect projections; do not infer replacement authority from a receipt verdict."
    },
    {
      "id": "SRC-06",
      "observed": "Verified pre-dispatch no-effect evidence exists with participant and fence binding.",
      "paths": [
        "crates/kernel/chio-kernel/src/tool_outcome/release.rs"
      ],
      "design_consequence": "Build sealed recovery closure over native proof and irreversible attempt closure."
    },
    {
      "id": "SRC-07",
      "observed": "Process security context is host-selected; ordinary lineage derives from existing ancestry.",
      "paths": [
        "crates/kernel/chio-process/src/security.rs",
        "crates/kernel/chio-process/src/lib.rs"
      ],
      "design_consequence": "Confined observation domains require an explicit authorized lineage boundary."
    },
    {
      "id": "SRC-08",
      "observed": "Process blobs/checkpoints provide bounded integrity and persistence, with separate read APIs.",
      "paths": [
        "crates/kernel/chio-process/src/store/blobs.rs",
        "crates/kernel/chio-process/src/state_reader.rs",
        "crates/kernel/chio-process/src/types.rs"
      ],
      "design_consequence": "Add provenance, mediated read/restore and legacy-state quarantine; checksums alone do not grant audience."
    },
    {
      "id": "SRC-09",
      "observed": "Skill workflow execution tracks composition and receipts using in-memory execution state.",
      "paths": [
        "crates/platform/chio-workflow/src/lib.rs",
        "crates/platform/chio-workflow/src/authority.rs",
        "crates/platform/chio-workflow/src/manifest.rs"
      ],
      "design_consequence": "Do not give this layer ownership of durable native recovery."
    },
    {
      "id": "SRC-10",
      "observed": "Verified manifest policy and typed HTTP egress contracts already own important boundaries.",
      "paths": [
        "crates/platform/chio-manifest/src/admission.rs",
        "crates/platform/chio-manifest/src/lib_parts/part_01.inc",
        "crates/protocol/chio-egress-contract/src/lib.rs"
      ],
      "design_consequence": "Resolve semantic packs into existing policy/topology and actual route checks."
    },
    {
      "id": "SRC-11",
      "observed": "Current response simulation has explicit execution modes and signed reproducible reports.",
      "paths": [
        "crates/kernel/chio-kernel/src/kernel/active_response_simulation.rs",
        "crates/kernel/chio-kernel/src/response_simulation_report.rs",
        "docs/reviews/2026-09-27-production-response-simulation.md"
      ],
      "design_consequence": "Borrow its advisory/live separation, not its domain-specific effect model."
    },
    {
      "id": "SRC-12",
      "observed": "Serving authority supplies fenced native store adapters.",
      "paths": [
        "crates/platform/chio-store-sqlite/src/serving_owner.rs"
      ],
      "design_consequence": "Place recovery ownership and protected native linkage here; bridge the process journal explicitly."
    },
    {
      "id": "SRC-13",
      "observed": "Disclosure lineage verification and signed JSON parsing are existing primitives.",
      "paths": [
        "crates/trust/chio-disclosure-lineage/src/lib.rs",
        "crates/core/chio-core-types/src/canonical/signed_json.rs"
      ],
      "design_consequence": "Reuse verified primitives only through exact semantic conversions; retain strict numeric/duplicate handling."
    },
    {
      "id": "SRC-14",
      "observed": "Earlier research has 104 selected passing tests with explicitly bounded scope.",
      "paths": [
        "labs/openappa-recovery/evidence/test-results.json",
        "labs/openappa-recovery/evidence/source-manifest.json"
      ],
      "design_consequence": "Treat as foundation/prototype evidence, not validation of the newly specified architecture."
    },
    {
      "id": "SRC-15",
      "observed": "Portable substrate crates retain Rust 1.93 and alloc-only contracts; chio-flow has no default features.",
      "paths": [
        "crates/security/chio-flow/Cargo.toml",
        "crates/security/chio-security-types/Cargo.toml",
        "crates/core/chio-core-types/Cargo.toml",
        "crates/platform/chio-store-sqlite/Cargo.toml"
      ],
      "design_consequence": "Preserve MSRV/proof targets and qualify pure crates under isolated and unified Cargo features."
    },
    {
      "id": "SRC-16",
      "observed": "Process-call binding includes normalized request identity, known-outcome-only mode, host route and security profile; first admission charges the tree call quota.",
      "paths": [
        "crates/kernel/chio-process/src/lib.rs",
        "crates/kernel/chio-process/src/store.rs"
      ],
      "design_consequence": "Reuse the complete binding derivation and transfer the reserved logical-call charge exactly once."
    },
    {
      "id": "SRC-17",
      "observed": "Native input joins share the authority writer transaction and scoped flow joins invalidate the corresponding egress fence.",
      "paths": [
        "crates/platform/chio-store-sqlite/src/security_state/flow_state/input_join.rs",
        "crates/platform/chio-store-sqlite/src/security_state/flow_state/mutations.rs",
        "crates/platform/chio-store-sqlite/src/security_state/flow_state/egress.rs",
        "crates/platform/chio-store-sqlite/src/security_state/flow_state/tests/native_scope/fences.rs"
      ],
      "design_consequence": "Artifact and return mediation must join those same native flow rows before release and respect capture ordering."
    },
    {
      "id": "SRC-18",
      "observed": "Native capture borrows actual invocation reservations, attempts capture once and retains credentials before an ambiguous result.",
      "paths": [
        "crates/kernel/chio-kernel/src/kernel/admission_coordinator/native_egress/capture.rs"
      ],
      "design_consequence": "Keep borrowed preparation synchronous, preserve native ownership across the owned dispatch task, and never infer refunds from Drop."
    },
    {
      "id": "SRC-19",
      "observed": "Flow grant request_hash covers canonical arguments; process hashing covers the caller envelope; native retained material has a separate derivation and explicitly strips one-shot credentials.",
      "paths": [
        "crates/platform/chio-control-plane/src/security/adapters/flow_policy.rs",
        "crates/security/chio-flow/src/declassification.rs",
        "crates/kernel/chio-process/src/lib.rs",
        "crates/kernel/chio-kernel/src/runtime.rs",
        "crates/kernel/chio-kernel/src/admission_operation/retained_request.rs",
        "crates/kernel/chio-kernel/src/kernel/admission_coordinator.rs"
      ],
      "design_consequence": "Use distinct digest types, exhaustive semantic projection and protected exact process-envelope custody; preserve native credential-free history."
    },
    {
      "id": "SRC-20",
      "observed": "Strict nonce issuance precedes attachment to a derived execution request; the native operation retains the original issuance, and preflight has its own knowledge-join authority.",
      "paths": [
        "crates/kernel/chio-process/src/lib.rs",
        "crates/kernel/chio-process/src/store/nonces.rs",
        "crates/kernel/chio-kernel/src/kernel/admission_coordinator/execution_nonce.rs",
        "crates/kernel/chio-kernel/src/kernel/admission_coordinator/native_acquisition/nonce_preflight.rs",
        "crates/kernel/chio-process/tests/nonce_recovery.rs"
      ],
