{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "..",
    "types": ["node"],
    "typeRoots": ["../sdks/typescript/node_modules/@types"],
    "paths": {
      "@chio-protocol/node-http": ["sdks/typescript/packages/node-http/src/index.ts"]
    }
  },
  "include": [
    "../sdks/typescript/packages/conformance/src/**/*.ts",
    "../sdks/typescript/packages/conformance/test/recovery_schema.test.ts"
  ]
}
