+# Canonical workspace lint policy. A member crate takes it with
+# `[lints]\nworkspace = true`. Cargo refuses to combine that line with any
+# local lint entry, so the crates that register `unexpected_cfgs` check-cfg
+# names (kani / loom / dhat / creusot) cannot inherit; they carry local
+# `[lints.rust]` and `[lints.clippy]` tables that mirror every entry here.
+# `scripts/check-lint-parity.py` fails when a mirror falls behind, so when
+# tightening the policy (for example adding `panic = "deny"`), edit it here
+# and in each mirror the gate names.
 #
 # `unwrap_used` / `expect_used` are denied because this is a fail-closed
 # security kernel: an unhandled `Option`/`Result` panic in a guard or receipt
@@ -67,23 +71,35 @@
 # narrow, reviewed exception annotate the specific call site with
 # `#[allow(clippy::unwrap_used)]` instead of opting the whole crate out.
 #
-# No `[workspace.lints.rust]` floor is defined: the only per-crate rust-lint
-# usage today is bespoke `unexpected_cfgs` check-cfg registration (kani / loom /
-# dhat) that cannot be hoisted, so those stay as local `[lints.rust]` tables.
+# No `[workspace.lints.rust]` floor is defined yet. Adding one is a policy
+# change like any other: the mirrors must carry it, and the parity gate
+# compares the Rust table as well as the Clippy table.
 [workspace.lints.clippy]
 unwrap_used = "deny"
 expect_used = "deny"
 
+# `overflow-checks` stays on in every profile that ships, for the same reason
+# `unwrap_used` is denied above: in a fail-closed security kernel a panic is an
+# availability fault, while a silent wrap is an authority grant. A `u64`
+# underflow in an exposure, budget or quota calculation does not produce a small
+# error, it produces the largest representable value, which a remaining-budget
+# comparison reads as unlimited authority. Leaving it at Cargo's release default
+# of `false` would also make the test suite structurally unable to find a
+# wrapping bug, because the wrap would only happen in a profile no test runs
+# under. `scripts/check-release-overflow.sh` is the check that does run under
+# it.
 [profile.release]
 codegen-units = 1
 lto = "fat"
 strip = "symbols"
 panic = "unwind"
+overflow-checks = true
 
 [profile.docker-release]
 inherits = "release"
 codegen-units = 16
 lto = "thin"
+overflow-checks = true
 
 # Dev/test debuginfo is disabled to keep `target/` from exploding. With ~130+
 # workspace members, the default `debug = 2` made a full `cargo test --workspace`
