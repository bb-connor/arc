+TEST = "crates/platform/chio-control-plane/src/recovery/tests.rs"
+MODEL = "docs/architecture/recoverable-agent-runtime/model/"
+# Each group covers the named transitions, not every instruction in its owner.
+ROWS = [
+    ("ownership.select/approve", "state.rs", STORE+"commands.rs", "apply", TEST, "recovery_p1_two_coordinators_select_once_and_review_exact_payload"),
+    ("ownership.close/cancel", "state.rs", STORE+"native.rs", "begin_tx", TEST, "recovery_p1_cancel_negative_lookup_fences_late_original_admission"),
