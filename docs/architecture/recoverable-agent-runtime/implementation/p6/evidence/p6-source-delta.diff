+    ("admission.intent/submit/native-project", "review_states.rs", STORE+"native.rs", "begin_tx", TEST, "recovery_p1_fresh_process_cutpoints_preserve_original_ownership"),
+    ("admission.cancel/late-admission/capture", "review_states.rs", STORE+"native.rs", "verify_capture_tx", TEST, "recovery_p1_cancel_negative_lookup_fences_late_original_admission"),
+    ("knowledge.prepare/observation/release/delivery/fence", "review_states.rs", "crates/platform/chio-control-plane/src/knowledge.rs", "release_into", "crates/platform/chio-control-plane/src/recovery/tests/knowledge.rs", "p4_artifacts_native_publication_and_taint_commit_before_first_byte"),
+    ("replay.original-revision/fresh-authorization/cached-refusal", "review_states.rs", STORE+"commands.rs", "apply", TEST, "recovery_p1_command_replay_conflict_rotation_and_revocation"),
+    ("partial-effect.observation/consumption/no-new-effect", "review_states.rs", STORE+"native.rs", "attach_provider_finality", TEST, "recovery_p1_partial_finality_is_positive_scoped_and_spends_the_original"),
