+                || server.command.is_empty()
+                || server.command.len() > 128
+                || !Path::new(&server.command[0]).is_absolute()
+                || server
+                    .command
+                    .iter()
+                    .any(|arg| arg.contains('\0') || arg.len() > 16_384)
