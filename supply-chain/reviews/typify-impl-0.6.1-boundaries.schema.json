{
  "title": "Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "mode", "port", "version", "items"],
  "properties": {
    "name": {"type": "string", "minLength": 2, "maxLength": 4, "pattern": "^[a-z]+$"},
    "mode": {"type": "string", "enum": ["read", "write"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "version": {"type": "string", "const": "fixed"},
    "items": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true, "maxItems": 2}
  }
}
