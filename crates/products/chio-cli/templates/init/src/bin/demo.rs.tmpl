use std::env;
use std::fs;
use std::io::{BufRead, BufReader, Write};
use std::path::{Path, PathBuf};
use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};

use serde_json::{json, Value};

const PROTOCOL_VERSION: &str = "2025-11-25";

struct ChioEdge {
    child: Child,
    stdin: ChildStdin,
    stdout: BufReader<ChildStdout>,
}

impl Drop for ChioEdge {
    fn drop(&mut self) {
        let _ = self.child.kill();
        let _ = self.child.wait();
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let project_root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
    let demo_name = env::args().nth(1).unwrap_or_else(|| "Chio".to_string());
    let state_dir = project_root.join(".chio");
    let receipt_db = state_dir.join("receipts.db");
    let session_db = state_dir.join("session.db");
    let target_dir = env::var_os("CARGO_TARGET_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| project_root.join(".chio").join("target"));
    create_private_directory(&state_dir)?;
    fs::create_dir_all(&target_dir)?;

    let chio_bin = env::var("CHIO_BIN").unwrap_or_else(|_| "chio".to_string());
    let hello_server = build_hello_server(&project_root, &target_dir)?;
    let security_dir = state_dir.join("native-mcp-security");
    provision_native_mcp_demo(
        &chio_bin,
        &project_root,
        &hello_server,
        &security_dir,
    )?;
    let mut edge = spawn_chio_edge(
        &chio_bin,
        &project_root,
        &receipt_db,
        &session_db,
        &hello_server,
        &security_dir,
    )?;

    send_json(
        &mut edge.stdin,
        &json!({
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {},
                "clientInfo": {
                    "name": "{{PACKAGE_NAME}}-demo",
                    "version": "0.1.0"
                }
            }
        }),
    )?;
    let initialize = read_json(&mut edge.stdout)?;
    println!("initialize:");
    println!("{}", serde_json::to_string_pretty(&initialize)?);

    send_json(
        &mut edge.stdin,
        &json!({
            "jsonrpc": "2.0",
            "method": "notifications/initialized"
        }),
    )?;

    send_json(
        &mut edge.stdin,
        &json!({
            "jsonrpc": "2.0",
            "id": 2,
            "method": "tools/list",
            "params": {}
        }),
    )?;
    let tools = read_json(&mut edge.stdout)?;
    println!();
    println!("tools:");
    println!("{}", serde_json::to_string_pretty(&tools)?);

    send_json(
        &mut edge.stdin,
        &json!({
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/call",
            "params": {
                "name": "hello_world",
                "arguments": {
                    "name": demo_name
                }
            }
        }),
    )?;
    let tool_call = read_json(&mut edge.stdout)?;
    let greeting = tool_call
        .get("result")
        .and_then(|result| result.get("structuredContent"))
        .and_then(|structured| structured.get("greeting"))
        .and_then(Value::as_str)
        .ok_or("tool result did not include a greeting")?;
    println!();
    println!("tool_call:");
    println!("{}", serde_json::to_string_pretty(&tool_call)?);
    println!();
    println!("governed greeting: {greeting}");

    drop(edge);

    let receipts = Command::new(&chio_bin)
        .arg("--receipt-db")
        .arg(&receipt_db)
        .arg("receipt")
        .arg("list")
        .arg("--admin-all")
        .arg("--limit")
        .arg("1")
        .current_dir(&project_root)
        .output()?;
    if !receipts.status.success() {
        return Err(format!(
            "failed to read receipt store: {}",
            String::from_utf8_lossy(&receipts.stderr)
        )
        .into());
    }

    println!();
    println!("latest receipt:");
    println!("{}", String::from_utf8_lossy(&receipts.stdout).trim());

    Ok(())
}

fn create_private_directory(path: &Path) -> std::io::Result<()> {
    let mut builder = fs::DirBuilder::new();
    builder.recursive(true);
    #[cfg(unix)]
    {
        use std::os::unix::fs::DirBuilderExt;
        builder.mode(0o700);
    }
    builder.create(path)
}

fn build_hello_server(
    project_root: &Path,
    target_dir: &Path,
) -> Result<PathBuf, Box<dyn std::error::Error>> {
    let output = Command::new("cargo")
        .arg("build")
        .arg("--quiet")
        .arg("--manifest-path")
        .arg(project_root.join("Cargo.toml"))
        .arg("--bin")
        .arg("hello_server")
        .env("CARGO_TARGET_DIR", target_dir)
        .output()?;
    if !output.status.success() {
        return Err(format!(
            "failed to build the MCP server: {}",
            String::from_utf8_lossy(&output.stderr)
        )
        .into());
    }

    let executable = target_dir
        .join("debug")
        .join(format!("hello_server{}", env::consts::EXE_SUFFIX));
    Ok(executable.canonicalize()?)
}

fn provision_native_mcp_demo(
    chio_bin: &str,
    project_root: &Path,
    hello_server: &Path,
    security_dir: &Path,
) -> Result<(), Box<dyn std::error::Error>> {
    let (execution_uid, execution_gid) = project_owner_identity(project_root)?;
    let output = Command::new(chio_bin)
        .arg("security")
        .arg("provision-native-mcp-demo")
        .arg("--output-dir")
        .arg(security_dir)
        .arg("--tools-fixture")
        .arg(project_root.join("tools.json"))
        .arg("--target")
        .arg(hello_server)
        .arg("--working-directory")
        .arg(project_root)
        .arg("--execution-uid")
        .arg(execution_uid.to_string())
        .arg("--execution-gid")
        .arg(execution_gid.to_string())
        .arg("--server-id")
        .arg("hello")
        .arg("--server-name")
        .arg("{{PROJECT_NAME}} hello server")
        .arg("--server-version")
        .arg("0.1.0")
        .current_dir(project_root)
        .output()?;
    if !output.status.success() {
        return Err(format!(
            "failed to provision signed MCP launch artifacts: {}",
            String::from_utf8_lossy(&output.stderr)
        )
        .into());
    }
    Ok(())
}

#[cfg(unix)]
fn project_owner_identity(project_root: &Path) -> Result<(u32, u32), Box<dyn std::error::Error>> {
    use std::os::unix::fs::MetadataExt as _;

    let metadata = fs::metadata(project_root)?;
    let uid = metadata.uid();
    let gid = metadata.gid();
    if uid == 0 || gid == 0 {
        return Err("the native MCP demo requires a non-root project owner".into());
    }
    Ok((uid, gid))
}

#[cfg(not(unix))]
fn project_owner_identity(_project_root: &Path) -> Result<(u32, u32), Box<dyn std::error::Error>> {
    Err("the native MCP demo currently requires a Unix execution identity".into())
}

fn read_public_key(path: &Path) -> Result<String, Box<dyn std::error::Error>> {
    let public_key = fs::read_to_string(path)?;
    let public_key = public_key.trim();
    if public_key.is_empty() {
        return Err(format!("public key file is empty: {}", path.display()).into());
    }
    Ok(public_key.to_string())
}

fn spawn_chio_edge(
    chio_bin: &str,
    project_root: &Path,
    receipt_db: &Path,
    session_db: &Path,
    hello_server: &Path,
    security_dir: &Path,
) -> Result<ChioEdge, Box<dyn std::error::Error>> {
    let manifest_public_key = read_public_key(&security_dir.join("manifest-public-key"))?;
    let cage_policy_signer = read_public_key(&security_dir.join("cage-policy-signer"))?;
    let mut child = Command::new(chio_bin)
        .arg("--receipt-db")
        .arg(receipt_db)
        .arg("--session-db")
        .arg(session_db)
        .arg("mcp")
        .arg("serve")
        .arg("--policy")
        .arg("policy.yaml")
        .arg("--server-id")
        .arg("hello")
        .arg("--server-name")
        .arg("{{PROJECT_NAME}} hello server")
        .arg("--server-version")
        .arg("0.1.0")
        .arg("--signed-manifest")
        .arg(security_dir.join("signed-manifest.json"))
        .arg("--manifest-public-key")
        .arg(manifest_public_key)
        .arg("--cage-policy")
        .arg(security_dir.join("cage-launch-policy.json"))
        .arg("--cage-policy-signer")
        .arg(cage_policy_signer)
        .arg("--")
        .arg(hello_server)
        .current_dir(project_root)
        .stdin(Stdio::piped())
        .stdout(Stdio::piped())
        .stderr(Stdio::inherit())
        .spawn()?;

    let stdin = child.stdin.take().ok_or("failed to capture Chio stdin")?;
    let stdout = child.stdout.take().ok_or("failed to capture Chio stdout")?;

    Ok(ChioEdge {
        child,
        stdin,
        stdout: BufReader::new(stdout),
    })
}

fn send_json(stdin: &mut ChildStdin, value: &Value) -> Result<(), Box<dyn std::error::Error>> {
    writeln!(stdin, "{}", serde_json::to_string(value)?)?;
    stdin.flush()?;
    Ok(())
}

fn read_json(stdout: &mut BufReader<ChildStdout>) -> Result<Value, Box<dyn std::error::Error>> {
    let mut line = String::new();
    loop {
        line.clear();
        let bytes = stdout.read_line(&mut line)?;
        if bytes == 0 {
            return Err("Chio edge closed stdout before responding".into());
        }
        if line.trim().is_empty() {
            continue;
        }
        return Ok(serde_json::from_str(line.trim())?);
    }
}
