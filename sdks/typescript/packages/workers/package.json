{
  "name": "@chio-protocol/workers",
  "version": "0.1.0",
  "description": "Chio Protocol Cloudflare Workers SDK using wasm-pack bundler artifacts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundler/*": "./dist/bundler/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun run build:wasm && tsc -p tsconfig.json",
    "build:wasm": "../../scripts/build-wasm.sh --package workers --target bundler",
    "build:ts": "tsc -p tsconfig.json",
    "test:miniflare": "bun run build && bun test/miniflare.mjs",
    "test:miniflare:dist": "bun run build:ts && bun test/miniflare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "miniflare": "^4.20260616.0",
    "typescript": "~5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
