{
  "name": "@chio-protocol/ai-sdk-middleware",
  "version": "0.1.0",
  "type": "module",
  "description": "Chio verdict middleware for Vercel AI SDK language models. verdict evaluation at the tool-use boundary through a Chio sidecar.",
  "license": "Apache-2.0",
  "keywords": [
    "chio",
    "vercel-ai-sdk",
    "middleware",
    "verdict",
    "agent-protocol"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "ai": "^7.0.93",
    "typescript": "~5.7.0"
  },
  "peerDependencies": {
    "ai": ">=7 <8"
  },
  "publishConfig": {
    "access": "public"
  }
}
