+    /// Lower the non-unwinding case exactly as rustc's LLVM backend does.
+    ///
+    /// The callback has Rust ABI `unsafe fn(*mut Data) -> ()`. Call it with its
+    /// original typed data pointer, then store Rust's ABI boolean for no unwind.
+    /// Panics and assertions in the callback retain their ordinary failing checks.
+    /// This does not model exception recovery or execute the catch callback.
+    fn codegen_catch_unwind(&mut self, fargs: Vec<Expr>, place: &Place, span: Span) -> Stmt {
+        // compiler_interface::check_options owns the panic=abort requirement;
+        // the driver always appends -Cpanic=abort. This guard is defensive and
+        // is not expected to run under the supported compiler entry point.
+        let unsupported = if self.tcx.sess.panic_strategy() != PanicStrategy::Abort {
+            Some("catch_unwind requires panic=abort; panic recovery is unsupported")
+        } else if self.queries.args().prove_safety_only {
+            Some("catch_unwind requires panic assertions; --prove-safety-only is unsupported")
+        } else if self.queries.args().unstable_features.iter().any(|feature| feature == "c-ffi") {
+            Some("catch_unwind with experimental C-FFI is unsupported")
+        } else {
+            None
+        };
+        if let Some(message) = unsupported {
+            utils::span_err(self.tcx, span, message.to_owned());
+            self.tcx.dcx().abort_if_errors();
+            unreachable!("Rustc should have aborted after rejecting catch_unwind")
+        }
+
+        let Ok([try_fn, data, _catch_fn]) = <[Expr; 3]>::try_from(fargs) else {
+            unreachable!("catch_unwind must have exactly three arguments")
+        };
+        let loc = self.codegen_span_stable(span);
+        let call = Stmt::function_call(None, try_fn.dereference(), vec![data], loc);
+        let result = self.codegen_expr_to_place_stable(place, Expr::c_false(), loc);
+        Stmt::block(vec![call, result], loc)
     }
 
