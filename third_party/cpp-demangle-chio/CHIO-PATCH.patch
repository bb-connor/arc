@@ -962,6 +966,40 @@
 // A newtype around a slice of type handles that we format as function
 // arguments.
 reference_newtype!(FunctionArgSlice, [TypeHandle]);
+
+#[cfg(test)]
+mod reference_newtype_tests {
+    use super::*;
+
+    #[test]
+    fn vector_views_keep_the_original_storage_and_layout() {
+        let values = vec![TypeHandle::Builtin(BuiltinType::Standard(
+            StandardBuiltinType::Void,
+        ))];
+        let args = FunctionArgList::new(&values);
+        let return_and_args = FunctionArgListAndReturnType::new(&values);
+        assert!(core::ptr::eq(&args.0, &values));
+        assert!(core::ptr::eq(&return_and_args.0, &values));
+        assert_eq!(core::mem::size_of_val(args), core::mem::size_of_val(&values));
+        assert_eq!(core::mem::align_of_val(args), core::mem::align_of_val(&values));
+        assert_eq!(args.len(), values.len());
+    }
+
+    #[test]
+    fn slice_views_keep_pointer_length_and_borrowed_storage() {
+        let values = [TypeHandle::Builtin(BuiltinType::Standard(
+            StandardBuiltinType::Void,
+        ))];
+        for slice in [&values[..0], &values[..]] {
+            let args = FunctionArgSlice::new(slice);
+            assert!(core::ptr::eq(&args.0, slice));
+            assert_eq!(args.as_ptr(), slice.as_ptr());
+            assert_eq!(args.len(), slice.len());
+            assert_eq!(core::mem::size_of_val(args), core::mem::size_of_val(slice));
+            assert_eq!(core::mem::align_of_val(args), core::mem::align_of_val(slice));
+        }
+    }
+}
 
 // Demangle a slice of TypeHandle as a function argument list.
 impl<'subs, W> Demangle<'subs, W> for FunctionArgSlice
